{
  "name": "hospital-erp-backend",
  "version": "1.0.0",
  "description": "Hospital ERP SaaS - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "prisma db push --skip-generate --accept-data-loss && node dist/server.js",
    "start:no-provision": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:all": "tsx src/seeds/run-all.ts",
    "db:seed:physical-observations": "tsx src/seeds/physical-observations.ts",
    "db:seed:lab-units": "tsx src/seeds/lab-units.ts",
    "db:seed:lab-templates": "tsx src/seeds/lab-test-templates.ts",
    "db:seed:drug-master": "tsx src/seeds/drug-master.ts",
    "db:seed:pack-sizes": "tsx src/seeds/pack-sizes.ts",
    "db:seed:pack-prices": "tsx src/seeds/pack-prices.ts",
    "db:seed:form-templates": "tsx src/seeds/form-templates.ts",
    "db:seed:nurse-roles": "tsx prisma/scripts/backfill-nurse-roles.ts",
    "db:seed:pharmacy-roles": "tsx prisma/scripts/backfill-pharmacy-roles.ts",
    "db:seed:floor-permissions": "tsx prisma/scripts/backfill-floor-permissions.ts",
    "db:seed:resync-permissions": "tsx src/seeds/resync-role-permissions.ts",
    "db:seed:cleanup-radiologist-approve": "tsx prisma/scripts/cleanup-radiologist-approve-perm.ts",
    "db:seed:nurse-users": "tsx prisma/scripts/seed-nurse-users.ts",
    "db:seed:imaging-modalities": "tsx src/seeds/imaging-modalities.ts",
    "db:seed:hsn-gst": "tsx src/seeds/hsn-gst-rates.ts",
    "db:seed:icd": "tsx src/seeds/icd-codes.ts",
    "db:seed:prod": "node dist-seed/prisma/seed.js",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.4.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.6",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
