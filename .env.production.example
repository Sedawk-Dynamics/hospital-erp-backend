# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION environment for api.cenaps.in
# Copy these into your hosting platform's environment settings (or a .env
# the container loads). Never commit real secrets. Generate JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# Most platforms inject PORT; the app honours it. 4000 is the default/EXPOSE.
PORT=4000

# ── Database (required) ──────────────────────────────────────────────────
# The schema is provisioned automatically on start via `prisma db push`
# (npm start / Docker CMD), and all reference data is seeded automatically on
# boot — no manual migrate/seed step is needed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hospital_erp?sslmode=require

# ── Redis (required) ─────────────────────────────────────────────────────
# Used by rate limiting and the login brute-force lockout. The API expects a
# reachable Redis; provision a managed instance.
REDIS_URL=redis://:PASSWORD@HOST:6379

# ── JWT (required — use long random values, NOT these) ───────────────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_48_byte_random_string
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_48_byte_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ─────────────────────────────────────────────────────────────────
# The API reflects every browser Origin, including localhost and preview URLs.
# Postman and other non-browser HTTP clients do not enforce CORS.
FRONTEND_URL=https://dev.cenaps.in

# ── Auth hashing ─────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Auto-seed ────────────────────────────────────────────────────────────
# Defaults ON in production. Set to false only if you provision data another
# way. It is idempotent and advisory-locked (safe with multiple replicas).
AUTO_SEED=true

# ── Razorpay (use LIVE keys in production) ───────────────────────────────
# Optional at startup: without keys, health/auth remain available and only
# payment operations stay disabled.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# ── Email (optional) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cenaps.in

# ── AI / LLM (optional — powers CDSS chatbots + smart suggestions) ───────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── PACS / DICOM (optional) ──────────────────────────────────────────────
# Leave PACS_PROVIDER=none to use the in-house viewer (no extra infra).
# If you run Orthanc behind the auth-gateway proxy, the viewer iframe is on
# api.cenaps.in while the app is on dev.cenaps.in (cross-domain) — the session
# cookie therefore MUST be SameSite=None; Secure:
#   PACS_PROVIDER=orthanc
#   PACS_PROXY_ENABLED=true
#   PACS_PROXY_PUBLIC_URL=https://api.cenaps.in
#   PACS_COOKIE_SAMESITE=none
#   PACS_COOKIE_SECURE=true
PACS_PROVIDER=none
PACS_PROXY_ENABLED=false
PACS_PROXY_PUBLIC_URL=https://api.cenaps.in
PACS_COOKIE_SAMESITE=none
PACS_COOKIE_SECURE=true
PACS_SESSION_TTL_MIN=30
