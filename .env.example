# AI / LLM — powers the TRMS CDSS use cases (patient chatbot, platform support
# chatbot, discharge generation) and progress-note smart suggestions.
# AI_PROVIDER picks the default backend ("gemini" | "openai" | "disabled"); the
# active provider/model is also editable from the super-admin AI Settings panel.
# When the selected provider has no key, AI degrades gracefully (endpoints
# return 400 and the UI hides AI affordances).
AI_PROVIDER=gemini
# Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Use a model your key actually has quota for. As of 2026 Google has zeroed the
# free-tier quota on gemini-2.0-flash (returns HTTP 429 "limit: 0"); 2.5-flash
# works on the free tier. Verify availability for your key in AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# OpenAI — optional upgrade path; only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# PACS / DICOM — DICOM server + web viewer integration.
# PACS_PROVIDER selects how uploaded DICOM is archived + viewed:
#   none      → keep files in /uploads, render with the in-house viewer (default)
#   orthanc   → push to a self-hosted Orthanc server; view via its bundled OHIF
#   postdicom → cloud PostDICOM PACS (embed/link mode)
PACS_PROVIDER=none

# Orthanc — backend talks to ORTHANC_URL (server-to-server), browsers open the
# OHIF viewer at ORTHANC_PUBLIC_URL. Leave user/pass empty for the dev compose
# (auth disabled); set them when AUTHENTICATION is enabled (prod compose).
ORTHANC_URL=http://localhost:8042
ORTHANC_PUBLIC_URL=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_OHIF_PATH=/ohif/viewer

# PostDICOM (cloud) — embed/link mode. Viewer URL template: include the literal
# token {studyInstanceUid}, or it is appended as ?studyUid=. API keys (Premium
# plan) are reserved for a future server-side upload path.
POSTDICOM_VIEWER_URL=
POSTDICOM_ACCOUNT_KEY=
POSTDICOM_API_KEY=

# ── PACS auth gateway (production-recommended) ──────────────────────────────
# When enabled, browsers never touch Orthanc directly: OHIF + DICOMweb are
# served through /api/v1/pacs/o/* on this backend, gated by a short-lived
# cookie minted from the user's JWT and scoped to the user's tenant. Keep
# Orthanc OFF the public network and point only this proxy at it. You must also
# set Orthanc's OHIF RouterBasename to /api/v1/pacs/o/ohif/ (see docker-compose).
PACS_PROXY_ENABLED=false
# Browser-facing base URL of THIS backend, e.g. https://api.example.com
PACS_PROXY_PUBLIC_URL=http://localhost:4000
# Cookie attributes. Local (http, same-site): lax + insecure. Production with
# the viewer iframe on a different domain than the app: 'none' + secure=true.
PACS_COOKIE_SAMESITE=lax
PACS_COOKIE_SECURE=false
PACS_SESSION_TTL_MIN=30

# Single source of truth: delete the local /uploads copy of a DICOM once it is
# archived in Orthanc (S3). Download + the in-house fallback then stream the
# bytes back through the authenticated retrieve endpoint. Leave false until the
# PACS storage is confirmed durable.
PACS_DROP_LOCAL=false

# ── GSTIN verification (gap #311) ───────────────────────────────────────────
# Settings → GST Registration → "Verify" checks the hospital's saved GSTIN with
# its GST service provider (GSP/ASP "search taxpayer" API) and stores the legal
# name, registration status and check date against that exact GSTIN. Until a
# provider confirms it, reports and bills print the GSTIN as "not verified".
# Only the GSTIN is sent to the provider; the API key is never logged.
#
#   unset / none → not configured (the default): Verify answers 503 and the
#                  GSTIN stays unverified.
#   http         → the configurable adapter below.
#   sandbox      → fixed QA fixtures, NO external call, every result labelled
#                  "SANDBOX — not a real government check". Refused when
#                  NODE_ENV=production. Never set this on a live hospital.
#                  Fixtures: 33AAACS2601K1ZR → active, 33AAACS2602K1ZQ →
#                  cancelled, 33AAACS2603K1ZP → simulated outage, anything else
#                  → not found. (Hospital PAN must be blank or AAACS260xK.)
GSTIN_VERIFY_PROVIDER=
# Display name for the provider (shown as "http:<name>").
# GSTIN_VERIFY_PROVIDER_NAME=my-gsp
# Endpoint; {gstin} is replaced with the GSTIN. Must be https:// (http only to
# localhost). Do not put credentials in the URL if the GSP accepts a header.
# GSTIN_VERIFY_URL=https://api.example-gsp.in/taxpayer/search?gstin={gstin}
# GET (default) or POST. For POST the body is {"<GSTIN_VERIFY_BODY_FIELD>": "<gstin>"}.
# GSTIN_VERIFY_METHOD=GET
# GSTIN_VERIFY_BODY_FIELD=gstin
# GSTIN_VERIFY_API_KEY=
# Header that carries the key (default x-api-key), and an optional prefix such
# as "Bearer " when the header is Authorization.
# GSTIN_VERIFY_API_KEY_HEADER=x-api-key
# GSTIN_VERIFY_API_KEY_PREFIX=
# Extra static headers some GSPs require (client id, username, ...), as a JSON
# object. Treated as secrets.
# GSTIN_VERIFY_EXTRA_HEADERS={"client_id":"..."}
# Milliseconds before the lookup is abandoned as failed (default 8000, max 30000).
# GSTIN_VERIFY_TIMEOUT_MS=8000
# Dot-paths into the JSON reply, comma-separated alternatives. Defaults look for
# the GST system's own names (lgnm / tradeNam / sts / gstin) at the top level or
# under data. / result. / taxpayerInfo. / data.data. / response.
# GSTIN_VERIFY_PATH_LEGAL_NAME=data.lgnm
# GSTIN_VERIFY_PATH_TRADE_NAME=data.tradeNam
# GSTIN_VERIFY_PATH_STATUS=data.sts
# GSTIN_VERIFY_PATH_GSTIN=data.gstin
# Registration-status values that count as active (comma-separated, default Active).
# GSTIN_VERIFY_ACTIVE_VALUES=Active

# ── E-invoice (IRN) and e-way bill portal — GST bug G-5 / gap #266 ──
# Generates IRNs (with ack no, ack date and signed QR) for finalised B2B
# invoices, retries failures, cancels within the portal window, and generates
# e-way bills for vendor returns — through the hospital's GSP.
#
# Until a provider is configured AND the hospital has saved its portal login in
# Settings → GST, the "E-invoicing applies" / "E-way bills apply" switches read
# "Not available" and the server refuses to turn them on (HTTP 409).
#
#   unset / none → not configured (the default).
#   http         → the configurable GSP adapter below.
#   sandbox      → deterministic fake IRNs / e-way bill numbers, NO external
#                  call, every result labelled "SANDBOX — not registered with
#                  the government portal" (also printed on the invoice).
#                  Refused when NODE_ENV=production. Never set on a live hospital.
#                  Fixtures: buyer GSTIN 33AAACS2603K1ZP → portal rejection
#                  (for the failure + retry flow); password
#                  "sandbox-wrong-password" → Test connection fails.
EINVOICE_PROVIDER=
# Display name for the provider (shown as "http:<name>").
# EINVOICE_PROVIDER_NAME=my-gsp
# GSP API base URL. Must be https:// (http only to localhost). No credentials here.
# EINVOICE_BASE_URL=https://api.example-gsp.in
# Paths under the base URL (defaults shown).
# EINVOICE_PATH_AUTH=/einvoice/authenticate
# EINVOICE_PATH_GENERATE=/einvoice/irn
# EINVOICE_PATH_CANCEL=/einvoice/irn/cancel
# EWAY_PATH_AUTH=/ewaybill/authenticate
# EWAY_PATH_GENERATE=/ewaybill/generate
# EWAY_PATH_CANCEL=/ewaybill/cancel
# Static headers the GSP itself requires (its own API key / ASP id), as a JSON
# object. Treated as secrets and never logged.
# EINVOICE_EXTRA_HEADERS={"x-gsp-key":"..."}
# Milliseconds before a portal call is abandoned (default 20000, max 60000).
# EINVOICE_TIMEOUT_MS=20000
# Hours after the acknowledgement within which an IRN may be cancelled
# (the portal's rule is 24; default 24).
# EINVOICE_CANCEL_WINDOW_HOURS=24
# Hours after generation within which an e-way bill may be cancelled
# (the portal's rule is 24; default 24).
# EWAY_CANCEL_WINDOW_HOURS=24
#
# Encryption key for the hospital portal logins entered in Settings → GST
# (stored AES-256-GCM encrypted in gst_portal_credentials, never returned to the
# browser). 32 random bytes as base64 or 64 hex characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production. Outside production a development key derived from
# JWT_ACCESS_SECRET is used when this is blank. Changing it makes stored
# logins unreadable — they must be entered again.
GST_PORTAL_CREDENTIALS_KEY=

# ── One-time codes by SMS / WhatsApp (patient sign-in, phone change) ──────────
# Patients sign in with their phone number and a one-time code. There is no
# fixed or shared code in any environment.
#
#   unset / none → no SMS or WhatsApp. The code is emailed to the address the
#                  patient registered with; a patient without one (everyone the
#                  front desk registered by phone) gets 503 OTP_NOT_CONFIGURED
#                  and cannot sign in or sign up.
#   http         → the configurable adapter below.
#   sandbox      → sends nothing and writes the code to the server console at
#                  debug level. Works only when NODE_ENV is development or test;
#                  refused everywhere else. Never set it on a live hospital.
#
# India: an SMS to an Indian number, one-time codes included, is dropped by the
# carriers unless the sender id (header) and the exact message wording are
# registered on a DLT portal. You need the principal entity id, an approved
# header and an approved content template, and OTP_SMS_TEXT must match that
# template word for word.
# WhatsApp: needs a WhatsApp Business account and an APPROVED template in the
# "authentication" category.
OTP_PROVIDER=
# Display name in logs ("http:<name>").
OTP_PROVIDER_NAME=
# Channels in order; the next one is tried when the previous one fails.
# "sms", "whatsapp", "whatsapp,sms" or "sms,whatsapp" (default sms).
OTP_CHANNELS=
# Country codes codes may be sent to, comma separated (default 91).
OTP_ALLOWED_COUNTRY_CODES=
# Milliseconds before a send is abandoned (default 8000, max 30000).
OTP_TIMEOUT_MS=
#
# SMS. URL must be https:// (http only to localhost). METHOD is POST (default)
# or GET. AUTH_HEADER defaults to Authorization; AUTH_VALUE is the whole header
# value and is never logged. EXTRA_HEADERS is a JSON object. BODY_TYPE is json
# (default) or form. BODY is a JSON object whose string values may contain
# {to} {to_digits} {to_national} {code} {message} {minutes} {sender_id}
# {dlt_entity_id} {dlt_template_id}; the URL may contain them too. TEXT is the
# DLT-approved wording with {code} (and {minutes}) in it. SUCCESS_TEXT, when
# set, must appear in the reply for the message to count as sent (some gateways
# answer HTTP 200 to a rejected message).
OTP_SMS_URL=
OTP_SMS_METHOD=
OTP_SMS_AUTH_HEADER=
OTP_SMS_AUTH_VALUE=
OTP_SMS_EXTRA_HEADERS=
OTP_SMS_BODY_TYPE=
OTP_SMS_BODY=
OTP_SMS_SENDER_ID=
OTP_SMS_DLT_ENTITY_ID=
OTP_SMS_DLT_TEMPLATE_ID=
OTP_SMS_TEXT=
OTP_SMS_SUCCESS_TEXT=
#
# WhatsApp. Same meanings; the default BODY is the WhatsApp Cloud API
# authentication template. Placeholders also include {template_name} and
# {template_lang} (default en).
OTP_WHATSAPP_URL=
OTP_WHATSAPP_METHOD=
OTP_WHATSAPP_AUTH_HEADER=
OTP_WHATSAPP_AUTH_VALUE=
OTP_WHATSAPP_EXTRA_HEADERS=
OTP_WHATSAPP_BODY_TYPE=
OTP_WHATSAPP_BODY=
OTP_WHATSAPP_SENDER_ID=
OTP_WHATSAPP_TEMPLATE_NAME=
OTP_WHATSAPP_TEMPLATE_LANG=
OTP_WHATSAPP_SUCCESS_TEXT=
