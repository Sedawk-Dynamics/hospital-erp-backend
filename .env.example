# Database
DATABASE_URL=postgresql://hospital_admin:hospital_pass@localhost:5432/hospital_erp

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=4000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:3000

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP (Email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@hospital-erp.com

# AI / LLM — powers the TRMS CDSS use cases (patient chatbot, platform support
# chatbot, discharge generation) and progress-note smart suggestions.
# AI_PROVIDER picks the default backend ("gemini" | "openai" | "disabled"); the
# active provider/model is also editable from the super-admin AI Settings panel.
# When the selected provider has no key, AI degrades gracefully (endpoints
# return 400 and the UI hides AI affordances).
AI_PROVIDER=gemini
# Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI — optional upgrade path; only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# PACS / DICOM — DICOM server + web viewer integration.
# PACS_PROVIDER selects how uploaded DICOM is archived + viewed:
#   none      → keep files in /uploads, render with the in-house viewer (default)
#   orthanc   → push to a self-hosted Orthanc server; view via its bundled OHIF
#   postdicom → cloud PostDICOM PACS (embed/link mode)
PACS_PROVIDER=none

# Orthanc — backend talks to ORTHANC_URL (server-to-server), browsers open the
# OHIF viewer at ORTHANC_PUBLIC_URL. Leave user/pass empty for the dev compose
# (auth disabled); set them when AUTHENTICATION is enabled (prod compose).
ORTHANC_URL=http://localhost:8042
ORTHANC_PUBLIC_URL=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_OHIF_PATH=/ohif/viewer

# PostDICOM (cloud) — embed/link mode. Viewer URL template: include the literal
# token {studyInstanceUid}, or it is appended as ?studyUid=. API keys (Premium
# plan) are reserved for a future server-side upload path.
POSTDICOM_VIEWER_URL=
POSTDICOM_ACCOUNT_KEY=
POSTDICOM_API_KEY=

# ── PACS auth gateway (production-recommended) ──────────────────────────────
# When enabled, browsers never touch Orthanc directly: OHIF + DICOMweb are
# served through /api/v1/pacs/o/* on this backend, gated by a short-lived
# cookie minted from the user's JWT and scoped to the user's tenant. Keep
# Orthanc OFF the public network and point only this proxy at it. You must also
# set Orthanc's OHIF RouterBasename to /api/v1/pacs/o/ohif/ (see docker-compose).
PACS_PROXY_ENABLED=false
# Browser-facing base URL of THIS backend, e.g. https://api.example.com
PACS_PROXY_PUBLIC_URL=http://localhost:4000
# Cookie attributes. Local (http, same-site): lax + insecure. Production with
# the viewer iframe on a different domain than the app: 'none' + secure=true.
PACS_COOKIE_SAMESITE=lax
PACS_COOKIE_SECURE=false
PACS_SESSION_TTL_MIN=30

# Single source of truth: delete the local /uploads copy of a DICOM once it is
# archived in Orthanc (S3). Download + the in-house fallback then stream the
# bytes back through the authenticated retrieve endpoint. Leave false until the
# PACS storage is confirmed durable.
PACS_DROP_LOCAL=false
