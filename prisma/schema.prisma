// ============================================================
// 21. DYNAMIC FORM BUILDER
// ============================================================
// Three-tier system replacing the 6 hardcoded nursing patient forms:
//   FormTemplate           — built by super_admin, visible to every hospital
//   HospitalForm           — built by hospital admin or cloned from a template,
//                            tenant-scoped; soft-deleted via archivedAt
//   HospitalFormSubmission — filled by a nurse against a patient/visit; data
//                            persists even after the parent HospitalForm is
//                            archived (required by spec)
//
// `schema` (Json) shape: { fields: FormField[], version: 1 }
// `data`   (Json) shape: { [fieldKey: string]: string | number | boolean | string[] | null }
// `formSnapshot` on a submission is a deep copy of the form's schema at the
// moment the nurse submitted, so an old submission renders correctly even
// after the form is later edited or archived.

model FormTemplate {
  id          String       @id @default(uuid())
  name        String       @db.VarChar(150)
  description String?
  category    FormCategory @default(other)
  schema      Json
  isPublished Boolean      @default(false) @map("is_published")
  version     Int          @default(1)
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  createdBy     User           @relation("FormTemplateCreator", fields: [createdById], references: [id])
  hospitalForms HospitalForm[]

  @@index([category, isPublished])
  @@map("form_templates")
}

model HospitalForm {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  name          String       @db.VarChar(150)
  description   String?
  category      FormCategory @default(other)
  schema        Json
  isPublished   Boolean      @default(true) @map("is_published")
  version       Int          @default(1)
  templateId    String?      @map("template_id")
  createdById   String       @map("created_by_id")
  archivedAt    DateTime?    @map("archived_at")
  archiveReason String?      @map("archive_reason") @db.VarChar(255)
  archivedById  String?      @map("archived_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  template    FormTemplate?            @relation(fields: [templateId], references: [id])
  createdBy   User                     @relation("HospitalFormCreator", fields: [createdById], references: [id])
  archivedBy  User?                    @relation("HospitalFormArchiver", fields: [archivedById], references: [id])
  submissions HospitalFormSubmission[]

  @@index([tenantId, archivedAt])
  @@index([tenantId, category])
  @@map("hospital_forms")
}

model HospitalFormSubmission {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  formId        String   @map("form_id")
  formVersion   Int      @map("form_version")
  formSnapshot  Json     @map("form_snapshot")
  patientId     String   @map("patient_id")
  visitId       String?  @map("visit_id")
  admissionId   String?  @map("admission_id")
  appointmentId String?  @map("appointment_id")
  submittedById String   @map("submitted_by_id")
  data          Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  form        HospitalForm @relation(fields: [formId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  visit       Visit?       @relation(fields: [visitId], references: [id])
  admission   Admission?   @relation(fields: [admissionId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  submittedBy User         @relation("FormSubmitter", fields: [submittedById], references: [id])

  @@index([patientId, createdAt])
  @@index([formId, createdAt])
  @@index([tenantId, patientId])
  @@map("hospital_form_submissions")
}
