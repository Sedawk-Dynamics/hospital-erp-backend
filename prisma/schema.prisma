  autoRenew                 Boolean                   @default(false) @map("auto_renew")
  cancelledAt               DateTime?                 @map("cancelled_at")
  lastReminderDays          Int?                      @map("last_reminder_days")
  createdAt                 DateTime                  @default(now()) @map("created_at")

  user                 User                  @relation("SubscriptionOwner", fields: [userId], references: [id])
  plan                 SubscriptionPlan      @relation(fields: [planId], references: [id])
  subscriptionPayments SubscriptionPayment[]

  @@map("user_subscriptions")
}

model SubscriptionPayment {
  id                 String   @id @default(uuid())
  userSubscriptionId String?  @map("user_subscription_id")
  userId             String   @map("user_id")
  razorpayOrderId    String   @unique @map("razorpay_order_id")
