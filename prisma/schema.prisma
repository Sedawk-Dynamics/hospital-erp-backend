model SavedReport {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  reportName  String      @map("report_name") @db.VarChar(255)
  reportType  ReportType  @map("report_type")
  parameters  Json?
  generatedBy String      @map("generated_by")
  fileUrl     String?     @map("file_url")
  fileFormat  FileFormat? @map("file_format")
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  generator User   @relation(fields: [generatedBy], references: [id])

  @@map("saved_reports")
}

model ScheduledReport {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  reportName      String         @map("report_name") @db.VarChar(255)
  reportType      String         @map("report_type") @db.VarChar(50)
  parameters      Json?
  schedule        ReportSchedule
  deliveryEmail   String?        @map("delivery_email") @db.VarChar(255)
  isActive        Boolean        @default(true) @map("is_active")
  lastGeneratedAt DateTime?      @map("last_generated_at")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  creator User   @relation(fields: [createdBy], references: [id])

  @@map("scheduled_reports")
}

model SupportTicket {
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  raisedBy        String              @map("raised_by")
  subject         String              @db.VarChar(255)
  description     String?
  priority        Priority            @default(medium)
  status          SupportTicketStatus @default(open)
  resolutionNotes String?             @map("resolution_notes")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  raiser User   @relation(fields: [raisedBy], references: [id])

  @@map("support_tickets")
}

// ============================================================
// PATIENT-HOSPITAL CONNECTIONS
// ============================================================

model PatientHospitalConnection {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  tenantId        String           @map("tenant_id")
  status          ConnectionStatus @default(pending)
  patientId       String?          @unique @map("patient_id")
  requestMessage  String?          @map("request_message") @db.VarChar(500)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  user     User     @relation("ConnectionUser", fields: [userId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])
  reviewer User?    @relation("ConnectionReviewer", fields: [reviewedBy], references: [id])

  @@unique([userId, tenantId])
  @@map("patient_hospital_connections")
}

// ─── Medical Records Department (MRD) ─────────────────────

enum MrdRequestStatus {
  initiated
  in_progress
  completed
  rejected
}

enum MrdDirection {
  inbound
  outbound
}

model MrdRequest {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  patientId     String           @map("patient_id")
  requestedTo   String           @map("requested_to") @db.VarChar(255)
  requestedBy   String?          @map("requested_by")
  locationFrom  String?          @map("location_from") @db.VarChar(255)
  wardRoom      String?          @map("ward_room") @db.VarChar(100)
  status        MrdRequestStatus @default(initiated)
  direction     MrdDirection     @default(outbound)
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  user    User?   @relation("MrdRequestedBy", fields: [requestedBy], references: [id])

  @@map("mrd_requests")
}

// ─── Razorpay Route: Split Payments ─────────────────────────────

model PaymentTransfer {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  paymentId           String         @map("payment_id")
  razorpayOrderId     String         @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId   String?        @map("razorpay_payment_id") @db.VarChar(100)
  razorpayTransferId  String?        @map("razorpay_transfer_id") @db.VarChar(100)
  totalAmount         Decimal        @map("total_amount") @db.Decimal(12, 2)
  commissionAmount    Decimal        @map("commission_amount") @db.Decimal(12, 2)
  hospitalAmount      Decimal        @map("hospital_amount") @db.Decimal(12, 2)
  commissionPercent   Decimal        @map("commission_percent") @db.Decimal(5, 2)
  transferStatus      PaymentTransferStatus @default(pending) @map("transfer_status")
  webhookPayload      Json?          @map("webhook_payload")
  failureReason       String?        @map("failure_reason")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_transfers")
}

model CommissionSetting {
  id             String   @id @default(uuid())
  defaultPercent Decimal  @map("default_percent") @db.Decimal(5, 2)
  minPercent     Decimal  @default(0) @map("min_percent") @db.Decimal(5, 2)
  maxPercent     Decimal  @default(50) @map("max_percent") @db.Decimal(5, 2)
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  updater User? @relation("CommissionSettingUpdater", fields: [updatedBy], references: [id])

  @@map("commission_settings")
}

model HospitalCommission {
  id                String   @id @default(uuid())
  tenantId          String   @unique @map("tenant_id")
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(5, 2)
  notes             String?
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  updater User?  @relation("HospitalCommissionUpdater", fields: [updatedBy], references: [id])

  @@map("hospital_commissions")
}

