  claimAmount       Decimal     @map("claim_amount") @db.Decimal(12, 2)
  approvedAmount    Decimal?    @map("approved_amount") @db.Decimal(12, 2)
  patientShare      Decimal?    @map("patient_share") @db.Decimal(12, 2)
  copayAmount       Decimal?    @map("copay_amount") @db.Decimal(12, 2)
  deductibleAmount  Decimal?    @map("deductible_amount") @db.Decimal(12, 2)
  coveredAmount     Decimal?    @map("covered_amount") @db.Decimal(12, 2)
  paidAmount        Decimal     @default(0) @map("paid_amount") @db.Decimal(12, 2)
