  bloodGroup       String    @map("blood_group") @db.VarChar(5)
  phone            String?   @db.VarChar(20)
  email            String?   @db.VarChar(255)
  address          String?
  healthStatus     String?   @map("health_status")
  isEligible       Boolean   @default(true) @map("is_eligible")
  lastDonationDate DateTime? @map("last_donation_date") @db.Date
