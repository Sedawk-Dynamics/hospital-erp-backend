// ============================================================
// 5. APPOINTMENTS & SCHEDULING
// ============================================================

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  tenantId        String   @map("tenant_id")
  departmentId    String   @map("department_id")
  specialization  String?  @db.VarChar(255)
  qualifications  String?
  licenseNumber   String?  @map("license_number") @db.VarChar(100)
  experienceYears Int?     @map("experience_years")
  consultationFee Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  bio             String?
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  department         Department         @relation(fields: [departmentId], references: [id])
  schedules          DoctorSchedule[]
  leaves             DoctorLeave[]
  appointments       Appointment[]
  queueTokens        QueueToken[]
  visits             Visit[]
  admissions         Admission[]
  patientTransfersFrom PatientTransfer[] @relation("TransferFromDoctor")
  patientTransfersTo   PatientTransfer[] @relation("TransferToDoctor")
  progressNotes      ProgressNote[]
  dischargeSummaries DischargeSummary[]
  prescriptions      Prescription[]
  otRequests         OtRequest[]
  feedback           Feedback[]
  reservations       Reservation[]
  estimations        Estimation[]

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  doctorId            String   @map("doctor_id")
  dayOfWeek           Int      @map("day_of_week") @db.SmallInt
  startTime           DateTime @map("start_time") @db.Time()
  endTime             DateTime @map("end_time") @db.Time()
  slotDurationMinutes Int      @default(15) @map("slot_duration_minutes")
  maxPatients         Int?     @map("max_patients")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@map("doctor_schedules")
}

model DoctorLeave {
  id        String    @id @default(uuid())
  doctorId  String    @map("doctor_id")
  leaveDate DateTime  @map("leave_date") @db.Date
  startTime DateTime? @map("start_time") @db.Time()
  endTime   DateTime? @map("end_time") @db.Time()
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@map("doctor_leaves")
}

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  patientId          String            @map("patient_id")
  doctorId           String            @map("doctor_id")
  appointmentDate    DateTime          @map("appointment_date") @db.Date
  startTime          DateTime          @map("start_time") @db.Time()
  endTime            DateTime?         @map("end_time") @db.Time()
  appointmentType    AppointmentType   @default(scheduled) @map("appointment_type")
  consultationType   String?           @map("consultation_type") @db.VarChar(30)
  priority           String?           @db.VarChar(20)
  visitType          VisitTypeAppt     @default(new) @map("visit_type")
  status             AppointmentStatus @default(booked)
  reason             String?
  notes              String?
  bookedBy           String?           @map("booked_by")
  cancelledBy        String?           @map("cancelled_by")
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  booker    User?         @relation("AppointmentBooker", fields: [bookedBy], references: [id])
  canceller User?         @relation("AppointmentCanceller", fields: [cancelledBy], references: [id])
  queueTokens QueueToken[]
  visits      Visit[]

  @@map("appointments")
}

model QueueToken {
  id                    String      @id @default(uuid())
  tenantId              String      @map("tenant_id")
  patientId             String      @map("patient_id")
  doctorId              String      @map("doctor_id")
  appointmentId         String?     @map("appointment_id")
  tokenNumber           String      @map("token_number") @db.VarChar(20)
  queueDate             DateTime    @map("queue_date") @db.Date
  status                QueueStatus @default(waiting)
  checkInTime           DateTime?   @map("check_in_time")
  consultationStartTime DateTime?   @map("consultation_start_time")
  consultationEndTime   DateTime?   @map("consultation_end_time")
  createdAt             DateTime    @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])

  @@map("queue_tokens")
}

// ============================================================
// 6. CLINICAL / VISITS & ADMISSIONS
// ============================================================

model Visit {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  patientId       String      @map("patient_id")
  doctorId        String      @map("doctor_id")
  appointmentId   String?     @map("appointment_id")
  visitType       VisitType   @map("visit_type")
  visitDate       DateTime    @map("visit_date")
  chiefComplaint  String?     @map("chief_complaint")
  status          VisitStatus @default(active)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  patient            Patient             @relation(fields: [patientId], references: [id])
  doctor             DoctorProfile       @relation(fields: [doctorId], references: [id])
  appointment        Appointment?        @relation(fields: [appointmentId], references: [id])
  admission          Admission?
  patientTransfers   PatientTransfer[]
  vitals             Vital[]
  diagnoses          Diagnosis[]
  progressNotes      ProgressNote[]
  nursingNotes       NursingNote[]
  ivLineRecords      IVLineRecord[]
  intakeOutputRecords IntakeOutputRecord[]
  woundCareRecords   WoundCareRecord[]
  dischargeSummaries DischargeSummary[]
  prescriptions      Prescription[]
  labOrders          LabOrder[]
  imagingRequests    ImagingRequest[]
  bills              Bill[]
  transfusions       Transfusion[]
  otRequests         OtRequest[]

  @@map("visits")
}

model Admission {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  visitId               String          @unique @map("visit_id")
  patientId             String          @map("patient_id")
  doctorId              String          @map("doctor_id")
  bedId                 String          @map("bed_id")
  wardId                String          @map("ward_id")
  admissionDate         DateTime        @map("admission_date")
  dischargeDate         DateTime?       @map("discharge_date")
  expectedDischargeDate DateTime?       @map("expected_discharge_date") @db.Date
  admissionReason       String?         @map("admission_reason")
  depositAmount         Decimal         @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  status                AdmissionStatus @default(admitted)
  admittedBy            String?         @map("admitted_by")
  dischargedBy          String?         @map("discharged_by")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  visit              Visit             @relation(fields: [visitId], references: [id])
  patient            Patient           @relation(fields: [patientId], references: [id])
  doctor             DoctorProfile     @relation(fields: [doctorId], references: [id])
  bed                Bed               @relation(fields: [bedId], references: [id])
  ward               Ward              @relation(fields: [wardId], references: [id])
  admitter           User?             @relation("Admitter", fields: [admittedBy], references: [id])
  discharger         User?             @relation("Discharger", fields: [dischargedBy], references: [id])
  dischargeSummary   DischargeSummary?
  ivLineRecords      IVLineRecord[]
  nursingNotes       NursingNote[]
  bills              Bill[]

  @@map("admissions")
}

model PatientTransfer {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  patientId    String         @map("patient_id")
  visitId      String         @map("visit_id")
  transferType TransferType   @map("transfer_type")
  fromDoctorId String?        @map("from_doctor_id")
  toDoctorId   String?        @map("to_doctor_id")
  fromBedId    String?        @map("from_bed_id")
  toBedId      String?        @map("to_bed_id")
  fromWardId   String?        @map("from_ward_id")
  toWardId     String?        @map("to_ward_id")
  reason       String?
  requestedBy  String?        @map("requested_by")
  approvedBy   String?        @map("approved_by")
  status       TransferStatus @default(requested)
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  patient    Patient        @relation(fields: [patientId], references: [id])
  visit      Visit          @relation(fields: [visitId], references: [id])
  fromDoctor DoctorProfile? @relation("TransferFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor   DoctorProfile? @relation("TransferToDoctor", fields: [toDoctorId], references: [id])
  fromBed    Bed?           @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBed      Bed?           @relation("TransferToBed", fields: [toBedId], references: [id])
  fromWard   Ward?          @relation("TransferFromWard", fields: [fromWardId], references: [id])
  toWard     Ward?          @relation("TransferToWard", fields: [toWardId], references: [id])
  requester  User?          @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver   User?          @relation("TransferApprover", fields: [approvedBy], references: [id])

  @@map("patient_transfers")
}

