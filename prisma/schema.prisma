model Tenant {
  id                String    @id @default(uuid())
  name              String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(100)
  logoUrl           String?   @map("logo_url")
  themeConfig       Json?     @map("theme_config")
  address           String?
  city              String?   @db.VarChar(100)
  state             String?   @db.VarChar(100)
  country           String?   @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  email             String?   @db.VarChar(255)
  website           String?   @db.VarChar(255)
  licenseNumber     String?   @map("license_number") @db.VarChar(100)
  accreditationInfo String?   @map("accreditation_info")
  hospitalCode      String?   @unique @map("hospital_code") @db.VarChar(6)
  allowDirectPatientConnection Boolean @default(false) @map("allow_direct_patient_connection")
  linkedAccountId   String?   @map("linked_account_id") @db.VarChar(255)
  bankVerified      Boolean   @default(false) @map("bank_verified")
  isActive          Boolean   @default(true) @map("is_active")
  onboardedAt       DateTime? @map("onboarded_at")
  offboardedAt      DateTime? @map("offboarded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  featureToggles         FeatureToggle[]
  users                  User[]
  roles                  Role[]
  loginAuditLogs         LoginAuditLog[]
  departments            Department[]
  wards                  Ward[]
  rooms                  Room[]
  beds                   Bed[]
  operatingTheaters      OperatingTheater[]
  hospitalResources      HospitalResource[]
  patients               Patient[]
  abhaSyncLogs           AbhaSyncLog[]
  doctorProfiles         DoctorProfile[]
  appointments           Appointment[]
  queueTokens            QueueToken[]
  visits                 Visit[]
  admissions             Admission[]
  patientTransfers       PatientTransfer[]
  prescriptions          Prescription[]
  labDepartments         LabDepartment[]
  labTestCatalog         LabTestCatalog[]
  labOrders              LabOrder[]
  imagingRequests        ImagingRequest[]
  drugCategories         DrugCategory[]
  drugFormulary          DrugFormulary[]
  drugBatches            DrugBatch[]
  dispensingRecords      DispensingRecord[]
  drugReturns            DrugReturn[]
  suppliers              Supplier[]
  inventoryItems         InventoryItem[]
  stockTransactions      StockTransaction[]
  purchaseOrders         PurchaseOrder[]
  supplyRequests         SupplyRequest[]
  serviceTariffs         ServiceTariff[]
  bills                  Bill[]
  payments               Payment[]
  receipts               Receipt[]
  refunds                Refund[]
  discounts              Discount[]
  insurers               Insurer[]
  tpaProviders           TpaProvider[]
  insurancePolicies      InsurancePolicy[]
  insuranceClaims        InsuranceClaim[]
  preAuthRequests        PreAuthorizationRequest[]
  tpaCommunicationLogs   TpaCommunicationLog[]
  bloodDonors            BloodDonor[]
  bloodDonations         BloodDonation[]
  bloodInventory         BloodInventory[]
  crossMatchTests        CrossMatchTest[]
  transfusions           Transfusion[]
  staffProfiles          StaffProfile[]
  dutyRosters            DutyRoster[]
  attendance             Attendance[]
  leaveRequests          LeaveRequest[]
  payroll                Payroll[]
  notifications          Notification[]
  messages               Message[]
  shiftHandoverNotes     ShiftHandoverNote[]
  tickets                Ticket[]
  feedback               Feedback[]
  auditLogs              AuditLog[]
  complianceDocuments    ComplianceDocument[]
  otRequests             OtRequest[]
  incidentReports        IncidentReport[]
  savedReports           SavedReport[]
  scheduledReports       ScheduledReport[]
  supportTickets         SupportTicket[]
  tenantOwners           TenantOwner[]
  patientConnections     PatientHospitalConnection[]
  mrdRequests            MrdRequest[]
  paymentTransfers       PaymentTransfer[]
  hospitalCommission     HospitalCommission?
  demoRequests           DemoRequest[]
  reservations           Reservation[]
  estimations            Estimation[]

  @@map("tenants")
}

model SubscriptionPlan {
  id                     String   @id @default(uuid())
  name                   String   @db.VarChar(100)
  description            String?
  priceMonthly           Decimal? @map("price_monthly") @db.Decimal(12, 2)
  priceYearly            Decimal? @map("price_yearly") @db.Decimal(12, 2)
  maxUsers               Int?     @map("max_users")
  maxHospitals           Int?     @map("max_hospitals")
  features               Json?
  isActive               Boolean  @default(false) @map("is_active")
  razorpayMonthlyPlanId  String?  @unique @map("razorpay_monthly_plan_id")
  razorpayYearlyPlanId   String?  @unique @map("razorpay_yearly_plan_id")
  allowAutopay           Boolean  @default(true) @map("allow_autopay")
  allowManual            Boolean  @default(true) @map("allow_manual")
  trialDays              Int?     @map("trial_days")
  createdAt              DateTime @default(now()) @map("created_at")

  userSubscriptions    UserSubscription[]
  subscriptionPayments SubscriptionPayment[]
  demoRequests         DemoRequest[]

  @@unique([name])
  @@map("subscription_plans")
}

model UserSubscription {
  id                          String                      @id @default(uuid())
  userId                      String                      @map("user_id")
  planId                      String                      @map("plan_id")
  startDate                   DateTime                    @map("start_date") @db.Date
  endDate                     DateTime?                   @map("end_date") @db.Date
  status                      SubscriptionStatus          @default(active)
  billingCycle                BillingCycle?               @map("billing_cycle")
  razorpaySubscriptionId      String?                     @unique @map("razorpay_subscription_id")
  subscriptionPaymentMethod   SubscriptionPaymentMethod   @default(manual) @map("subscription_payment_method")
  autoRenew                   Boolean                     @default(false) @map("auto_renew")
  cancelledAt                 DateTime?                   @map("cancelled_at")
  lastReminderDays            Int?                        @map("last_reminder_days")
  createdAt                   DateTime                    @default(now()) @map("created_at")

  user                  User                 @relation("SubscriptionOwner", fields: [userId], references: [id])
  plan                  SubscriptionPlan     @relation(fields: [planId], references: [id])
  subscriptionPayments  SubscriptionPayment[]

  @@map("user_subscriptions")
}

model SubscriptionPayment {
  id                    String   @id @default(uuid())
  userSubscriptionId    String?  @map("user_subscription_id")
  userId                String   @map("user_id")
  razorpayOrderId       String   @unique @map("razorpay_order_id")
  razorpayPaymentId     String?  @map("razorpay_payment_id")
  razorpaySignature     String?  @map("razorpay_signature")
  amount                Decimal  @db.Decimal(12, 2)
  currency              String   @default("INR") @db.VarChar(3)
  status                String   @default("created") @db.VarChar(20)
  planId                String   @map("plan_id")
  billingCycle          String   @map("billing_cycle") @db.VarChar(20)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  userSubscription   UserSubscription?   @relation(fields: [userSubscriptionId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  plan               SubscriptionPlan    @relation(fields: [planId], references: [id])

  @@map("subscription_payments")
}

model FeatureToggle {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  featureKey String   @map("feature_key") @db.VarChar(100)
  isEnabled  Boolean  @default(false) @map("is_enabled")
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureKey])
  @@map("feature_toggles")
}

// ============================================================
// 2. AUTH / USERS
// ============================================================

model User {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  email                String    @db.VarChar(255)
  phone                String?   @db.VarChar(20)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String?   @map("last_name") @db.VarChar(100)
  avatarUrl            String?   @map("avatar_url")
  isActive             Boolean   @default(true) @map("is_active")
  is2faEnabled         Boolean   @default(false) @map("is_2fa_enabled")
  twoFaSecret          String?   @map("two_fa_secret") @db.VarChar(255)
  lastLoginAt          DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  deactivatedAt        DateTime? @map("deactivated_at")

  tenant                    Tenant                  @relation(fields: [tenantId], references: [id])
  patient                   Patient?
  doctorProfile             DoctorProfile?
  staffProfile              StaffProfile?
  userRoles                 UserRole[]              @relation("UserRoleUser")
  assignedUserRoles         UserRole[]              @relation("UserRoleAssigner")
  loginAuditLogs            LoginAuditLog[]
  departmentsHeaded         Department[]
  patientPersonalHistoryUpdates PatientPersonalHistory[] @relation("PersonalHistoryUpdater")
  patientFamilyHistoryUpdates   PatientFamilyHistory[]   @relation("FamilyHistoryUpdater")
  patientAllergyNotes       PatientAllergy[]        @relation("AllergyNoter")
  patientDocUploads         PatientDocument[]       @relation("DocUploader")
  patientDocVerifications   PatientDocument[]       @relation("DocVerifier")
  appointmentsBooked        Appointment[]           @relation("AppointmentBooker")
  appointmentsCancelled     Appointment[]           @relation("AppointmentCanceller")
  admissionsAdmitted        Admission[]             @relation("Admitter")
  admissionsDischarged      Admission[]             @relation("Discharger")
  transfersRequested        PatientTransfer[]       @relation("TransferRequester")
  transfersApproved         PatientTransfer[]       @relation("TransferApprover")
  vitalsRecorded            Vital[]
  diagnosesRecorded         Diagnosis[]
  nursingNotes              NursingNote[]
  ivLinesInserted           IVLineRecord[]          @relation("IVInserter")
  ivLinesRemoved            IVLineRecord[]          @relation("IVRemover")
  intakeOutputRecords       IntakeOutputRecord[]
  woundCareRecords          WoundCareRecord[]
  dischargeSummariesSigned  DischargeSummary[]
  medicationAdministrations MedicationAdministration[]
  labOrdersOrdered          LabOrder[]
  labSamplesCollected       LabSample[]
  labResultsEntered         LabResult[]
  labReportsReviewed        LabReport[]             @relation("LabReportReviewer")
  labReportsApproved        LabReport[]             @relation("LabReportApprover")
  labReportsSigned          LabReport[]             @relation("LabReportSigner")
  imagingOrdersOrdered      ImagingRequest[]
  imagingResultsRadiologist ImagingResult[]         @relation("ImagingRadiologist")
  imagingResultsSigned      ImagingResult[]         @relation("ImagingResultSigner")
  dispensingRecords         DispensingRecord[]      @relation("Dispenser")
  dispensingVerifications   DispensingRecord[]      @relation("DispensingVerifier")
  drugReturnsProcessed      DrugReturn[]
  stockTransactions         StockTransaction[]
  purchaseOrdersApproved    PurchaseOrder[]
  supplyRequestsRequested   SupplyRequest[]         @relation("SupplyRequester")
  supplyRequestsApproved    SupplyRequest[]         @relation("SupplyApprover")
  billsGenerated            Bill[]                  @relation("BillGenerator")
  billsApproved             Bill[]                  @relation("BillApprover")
  billsCancelled            Bill[]                  @relation("BillCanceller")
  paymentsProcessed         Payment[]
  refundsRequested          Refund[]                @relation("RefundRequester")
  refundsApproved           Refund[]                @relation("RefundApprover")
  discountsApproved         Discount[]
  insuranceClaimsSubmitted  InsuranceClaim[]        @relation("ClaimSubmitter")
  insuranceClaimsReviewed   InsuranceClaim[]        @relation("ClaimReviewer")
  preAuthSubmitted          PreAuthorizationRequest[]
  tpaCommunications         TpaCommunicationLog[]
  bloodDonationsCollected   BloodDonation[]
  crossMatchTests           CrossMatchTest[]
  transfusionsAdministered  Transfusion[]           @relation("TransfusionAdministerer")
  transfusionsOrdered       Transfusion[]           @relation("TransfusionOrderer")
  leaveRequestsApproved     LeaveRequest[]
  payrollProcessed          Payroll[]
  notifications             Notification[]
  messagesSent              Message[]               @relation("MessageSender")
  messagesReceived          Message[]               @relation("MessageReceiver")
  shiftHandoverFrom         ShiftHandoverNote[]     @relation("HandoverFrom")
  shiftHandoverTo           ShiftHandoverNote[]     @relation("HandoverTo")
  ticketsRaised             Ticket[]                @relation("TicketRaiser")
  ticketsAssigned           Ticket[]                @relation("TicketAssignee")
  ticketsEscalated          Ticket[]                @relation("TicketEscalator")
  feedbackSubmitted         Feedback[]
  auditLogs                 AuditLog[]
  complianceDocUploads      ComplianceDocument[]
  incidentReportsReported   IncidentReport[]        @relation("IncidentReporter")
  incidentReportsEscalated  IncidentReport[]        @relation("IncidentEscalator")
  savedReports              SavedReport[]
  scheduledReports          ScheduledReport[]
  supportTickets            SupportTicket[]
  tenantOwners              TenantOwner[]
  subscriptionPayments      SubscriptionPayment[]
  connectionRequests        PatientHospitalConnection[] @relation("ConnectionUser")
  connectionReviews         PatientHospitalConnection[] @relation("ConnectionReviewer")
  mrdRequestsMade           MrdRequest[]                @relation("MrdRequestedBy")
  commissionSettingsUpdated CommissionSetting[]          @relation("CommissionSettingUpdater")
  hospitalCommissionsUpdated HospitalCommission[]        @relation("HospitalCommissionUpdater")
  demoRequestsApproved       DemoRequest[]               @relation("DemoApprover")
  demoRequestsCreatedUser    DemoRequest[]               @relation("DemoCreatedUser")
  ownedSubscriptions         UserSubscription[]          @relation("SubscriptionOwner")
  reservationsCreated        Reservation[]               @relation("ReservationCreator")
  estimationsCreated         Estimation[]                @relation("EstimationCreator")

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String   @db.VarChar(50)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model TenantOwner {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@map("tenant_owners")
}

model Permission {
  id          String  @id @default(uuid())
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user     User  @relation("UserRoleUser", fields: [userId], references: [id])
  role     Role  @relation(fields: [roleId], references: [id])
  assigner User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model LoginAuditLog {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  tenantId      String      @map("tenant_id")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent")
  status        LoginStatus
  failureReason String?     @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("login_audit_logs")
}

model DemoRequest {
  id             String            @id @default(uuid())
  name           String            @db.VarChar(120)
  email          String            @db.VarChar(255)
  phone          String            @db.VarChar(20)
  hospitalName   String            @map("hospital_name") @db.VarChar(255)
  designation    String            @db.VarChar(100)
  city           String            @db.VarChar(100)
  message        String?           @db.Text
  status         DemoRequestStatus @default(pending)
  trialDays      Int?              @map("trial_days")
  trialEndsAt    DateTime?         @map("trial_ends_at")
  trialPlanId    String?           @map("trial_plan_id")
  approvedById   String?           @map("approved_by_id")
  createdTenantId String?          @map("created_tenant_id")
  createdUserId  String?           @map("created_user_id")
  rejectionNote  String?           @map("rejection_note") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  approvedBy     User?             @relation("DemoApprover", fields: [approvedById], references: [id])
  trialPlan      SubscriptionPlan? @relation(fields: [trialPlanId], references: [id])
  createdTenant  Tenant?           @relation(fields: [createdTenantId], references: [id])
  createdUser    User?             @relation("DemoCreatedUser", fields: [createdUserId], references: [id])

  @@map("demo_requests")
}

enum DemoRequestStatus {
  pending
  approved
  rejected
  trial_active
  trial_ended
  converted
}

