model OtRequest {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  patientId          String           @map("patient_id")
  visitId            String           @map("visit_id")
  doctorId           String           @map("doctor_id")
  surgeonId          String?          @map("surgeon_id")
  anaesthetistId     String?          @map("anaesthetist_id")
  otId               String?          @map("ot_id")
  procedureName      String           @map("procedure_name") @db.VarChar(255)
  procedureDetails   String?          @map("procedure_details")
  surgeryType        String?          @map("surgery_type") @db.VarChar(50)
  speciality         String?          @db.VarChar(100)
  urgency            OtRequestUrgency @default(elective)
  preferredDate      DateTime?        @map("preferred_date") @db.Date
  preferredTime      DateTime?        @map("preferred_time") @db.Time()
  scheduledDate      DateTime?        @map("scheduled_date") @db.Date
  scheduledTime      DateTime?        @map("scheduled_time") @db.Time()
  scheduledStartTime String?          @map("scheduled_start_time") @db.VarChar(10)
  scheduledEndTime   String?          @map("scheduled_end_time") @db.VarChar(10)
  actualStartTime    DateTime?        @map("actual_start_time")
  actualEndTime      DateTime?        @map("actual_end_time")
  durationMinutes    Int?             @map("duration_minutes")
  requiredEquipment  Json?            @map("required_equipment")
  preOpChecklist     Json?            @map("pre_op_checklist")
  preOpDiagnosis     String?          @map("pre_op_diagnosis")
  postOpDiagnosis    String?          @map("post_op_diagnosis")
  notes              String?
  /// The surgery tariff this procedure is, for tax.
  ///
  /// Section 4.6 turns on one distinction: therapeutic is exempt, cosmetic is
  /// 18%, "the same theatre, the same surgeon and the same consumables". The
  /// tariff carries the SAC, the treatment, the rate and the auditor's
  /// approval, so the request points at it rather than keeping a second copy
  /// of "is this cosmetic" to hold in step with the first.
  ///
  /// Nullable: a request with no tariff resolves through the category, to
  /// exempt, exactly as every one of them did before this existed.
  serviceTariffId    String?          @map("service_tariff_id")
  billingAmount      Decimal?         @map("billing_amount") @db.Decimal(12, 2)
  billingStatus      String?          @map("billing_status") @db.VarChar(20)
  cancellationReason String?          @map("cancellation_reason")
  status             OtRequestStatus  @default(requested)

  // ── Reschedule ↔ doctor-confirmation loop ───────────────────────────────
  // The doctor books a *preferred* slot; the OT admin schedules the real one.
  // When the admin's slot differs from what the doctor asked for, the booking
  // is not final until the doctor accepts it — modelled as a sub-state on top
  // of `status` so the OtRequestStatus enum (and its migration) stays put.
  //   scheduleState: null | 'awaiting_doctor' | 'confirmed'
  //   doctorResponse: null | 'accepted' | 'rejected'
  // Read and written through shared/ot-schedule.ts, which also carries the
  // self-healing DDL for databases that predate the feature.
  scheduleState         String?   @map("schedule_state") @db.VarChar(24)
  rescheduleReason      String?   @map("reschedule_reason")
  rescheduledBy         String?   @map("rescheduled_by")
  rescheduledAt         DateTime? @map("rescheduled_at")
  previousScheduledDate DateTime? @map("previous_scheduled_date") @db.Date
  previousScheduledTime String?   @map("previous_scheduled_time") @db.VarChar(10)
  doctorResponse        String?   @map("doctor_response") @db.VarChar(20)
  doctorResponseNote    String?   @map("doctor_response_note")
  doctorRespondedAt     DateTime? @map("doctor_responded_at")
  rescheduleCount       Int       @default(0) @map("reschedule_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  visit         Visit             @relation(fields: [visitId], references: [id])
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id])
  surgeon       DoctorProfile?    @relation("OtSurgeon", fields: [surgeonId], references: [id])
  anaesthetist  DoctorProfile?    @relation("OtAnaesthetist", fields: [anaesthetistId], references: [id])
  serviceTariff ServiceTariff?    @relation(fields: [serviceTariffId], references: [id])
  ot            OperatingTheater? @relation(fields: [otId], references: [id])

  @@index([surgeonId])
  @@index([anaesthetistId])
  @@index([scheduledDate])
  @@map("ot_requests")
}

