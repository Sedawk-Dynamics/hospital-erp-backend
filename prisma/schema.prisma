  @@map("notifications")
}

// ============================================================
// CDSS — persisted clinical decision-support alerts
// ============================================================

enum CdssAlertType {
  drug_interaction
  allergy
  dosage
  recall
  critical_value
}

enum CdssAlertStatus {
  active
  acknowledged
  overridden
}

model CdssAlert {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  patientId        String?         @map("patient_id")
  alertType        CdssAlertType   @map("alert_type")
  /**
   * info | minor | moderate | major | contraindicated | critical
   */
  severity         String          @db.VarChar(20)
  message          String
  detail           String?
  drugName         String?         @map("drug_name") @db.VarChar(255)
  parameterName    String?         @map("parameter_name") @db.VarChar(255)
  parameterValue   String?         @map("parameter_value") @db.VarChar(100)
  /**
   * What triggered this alert: prescription | lab_order
   */
  referenceType    String?         @map("reference_type") @db.VarChar(50)
  referenceId      String?         @map("reference_id")
  notifiedUserId   String?         @map("notified_user_id")
  status           CdssAlertStatus @default(active)
  acknowledgedById String?         @map("acknowledged_by_id")
  acknowledgedAt   DateTime?       @map("acknowledged_at")
  acknowledgeNote  String?         @map("acknowledge_note")
  /**
   * Required when status=overridden — the clinical justification.
   */
  overrideReason   String?         @map("override_reason")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  patient        Patient? @relation(fields: [patientId], references: [id])
  acknowledgedBy User?    @relation("CdssAlertAcknowledger", fields: [acknowledgedById], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, alertType, createdAt])
  @@index([tenantId, patientId])
  @@map("cdss_alerts")
}

model Message {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  senderId        String    @map("sender_id")
  receiverId      String    @map("receiver_id")
  subject         String?   @db.VarChar(255)
  content         String
  isEncrypted     Boolean   @default(true) @map("is_encrypted")
  isRead          Boolean   @default(false) @map("is_read")
  readAt          DateTime? @map("read_at")
  parentMessageId String?   @map("parent_message_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  sender        User      @relation("MessageSender", fields: [senderId], references: [id])
  receiver      User      @relation("MessageReceiver", fields: [receiverId], references: [id])
  parentMessage Message?  @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies       Message[] @relation("MessageThread")

  @@map("messages")
}

model ShiftHandoverNote {
  id               String            @id @default(uuid())
  tenantId         String            @map("tenant_id")
  fromNurseId      String            @map("from_nurse_id")
  toNurseId        String?           @map("to_nurse_id")
  wardId           String            @map("ward_id")
  shiftDate        DateTime          @map("shift_date") @db.Date
  shiftType        HandoverShiftType @map("shift_type")
  content          String
  patientStatuses  Json?             @map("patient_statuses")
  outstandingTasks Json?             @map("outstanding_tasks")
  isAcknowledged   Boolean           @default(false) @map("is_acknowledged")
  acknowledgedAt   DateTime?         @map("acknowledged_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  fromNurse        User              @relation("HandoverFrom", fields: [fromNurseId], references: [id])
  toNurse          User?             @relation("HandoverTo", fields: [toNurseId], references: [id])
