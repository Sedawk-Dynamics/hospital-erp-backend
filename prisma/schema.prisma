// 3. INFRASTRUCTURE
// ============================================================

model Department {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String   @db.VarChar(100)
  code       String?  @db.VarChar(20)
  description String?
  headUserId String?  @map("head_user_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  headUser          User?              @relation(fields: [headUserId], references: [id])
  wards             Ward[]
  hospitalResources HospitalResource[]
  stockTransactions StockTransaction[]
  supplyRequests    SupplyRequest[]
  dutyRosters       DutyRoster[]
  staffProfiles     StaffProfile[]
  tickets           Ticket[]
  feedback          Feedback[]
  doctorProfiles    DoctorProfile[]

  @@map("departments")
}

model Ward {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  departmentId String?  @map("department_id")
  name         String   @db.VarChar(100)
  wardType     WardType? @map("ward_type")
  floor        String?  @db.VarChar(20)
  totalBeds    Int      @default(0) @map("total_beds")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  rooms              Room[]
  admissions         Admission[]
  patientTransfersFrom PatientTransfer[] @relation("TransferFromWard")
  patientTransfersTo   PatientTransfer[] @relation("TransferToWard")
  supplyRequests     SupplyRequest[]
  shiftHandoverNotes ShiftHandoverNote[]
  reservations       Reservation[]

  @@map("wards")
}

model Room {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  wardId     String   @map("ward_id")
  roomNumber String   @map("room_number") @db.VarChar(20)
  roomType   RoomType? @map("room_type")
  floor      String?  @db.VarChar(20)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  ward   Ward   @relation(fields: [wardId], references: [id])
  beds   Bed[]

  @@map("rooms")
}

model Bed {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  roomId           String    @map("room_id")
  bedNumber        String    @map("bed_number") @db.VarChar(20)
  bedType          BedType?  @map("bed_type")
  status           BedStatus @default(available)
  currentPatientId String?   @map("current_patient_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  room                Room              @relation(fields: [roomId], references: [id])
  currentPatient      Patient?          @relation(fields: [currentPatientId], references: [id])
  admissions          Admission[]
  patientTransfersFrom PatientTransfer[] @relation("TransferFromBed")
  patientTransfersTo   PatientTransfer[] @relation("TransferToBed")
  reservations        Reservation[]

  @@map("beds")
}

model OperatingTheater {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(100)
  location      String?  @db.VarChar(255)
  status        OtStatus @default(available)
  equipmentList Json?    @map("equipment_list")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  otRequests OtRequest[]

  @@map("operating_theaters")
}

model HospitalResource {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  name                String         @db.VarChar(100)
  resourceType        ResourceType?  @map("resource_type")
  serialNumber        String?        @map("serial_number") @db.VarChar(100)
  departmentId        String?        @map("department_id")
  status              ResourceStatus @default(available)
  location            String?        @db.VarChar(255)
  lastMaintenanceDate DateTime?      @map("last_maintenance_date") @db.Date
  nextMaintenanceDate DateTime?      @map("next_maintenance_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("hospital_resources")
}

