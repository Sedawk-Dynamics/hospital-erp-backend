model ProgressNote {
  id                     String             @id @default(uuid())
  visitId                String             @map("visit_id")
  patientId              String             @map("patient_id")
  doctorId               String             @map("doctor_id")
  noteType               ProgressNoteType?  @map("note_type")
  content                String
  pinToDischargeSummary  Boolean            @default(false) @map("pin_to_discharge_summary")
  isAutoFilled           Boolean            @default(false) @map("is_auto_filled")
  status                 ProgressNoteStatus @default(active)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at")

  visit   Visit         @relation(fields: [visitId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id])

