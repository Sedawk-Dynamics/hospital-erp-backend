// 4. PATIENT MANAGEMENT
// ============================================================

model Patient {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  userId             String?             @map("user_id")
  relationship       PatientRelationship @default(self)
  isSelf             Boolean             @default(false) @map("is_self")
  mrn                String              @db.VarChar(50)
  firstName          String              @map("first_name") @db.VarChar(100)
  lastName           String?             @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  gender             Gender?
  bloodGroup         String?             @map("blood_group") @db.VarChar(5)
  phone              String?             @db.VarChar(20)
  email              String?             @db.VarChar(255)
  addressLine1       String?             @map("address_line1") @db.VarChar(255)
  addressLine2       String?             @map("address_line2") @db.VarChar(255)
  city               String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  postalCode         String?             @map("postal_code") @db.VarChar(20)
  country            String?             @db.VarChar(100)
  photoUrl           String?             @map("photo_url")
  idProofType        String?             @map("id_proof_type") @db.VarChar(50)
  idProofNumber      String?             @map("id_proof_number") @db.VarChar(100)
  idProofDocumentUrl String?             @map("id_proof_document_url")
  maritalStatus      String?             @map("marital_status") @db.VarChar(20)
  nationality        String?             @db.VarChar(100)
  occupation         String?             @db.VarChar(100)
  religion           String?             @db.VarChar(50)
  preferredLanguage  String?             @map("preferred_language") @db.VarChar(50)
  referredBy         String?             @map("referred_by") @db.VarChar(200)
  notes              String?
  abhaNumber         String?             @unique @map("abha_number") @db.VarChar(20)
  abhaAddress        String?             @map("abha_address") @db.VarChar(100)
  abhaLinked         Boolean             @default(false) @map("abha_linked")
  abhaLinkedAt       DateTime?           @map("abha_linked_at")
  kycVerified        Boolean             @default(false) @map("kyc_verified")
  kycVerifiedAt      DateTime?           @map("kyc_verified_at")
  patientType        PatientType?        @map("patient_type")
  isNew              Boolean             @default(true) @map("is_new")
  registrationSource RegistrationSource? @map("registration_source")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant                    Tenant                       @relation(fields: [tenantId], references: [id])
  user                      User?                        @relation(fields: [userId], references: [id])
  beds                      Bed[]
  emergencyContacts         PatientEmergencyContact[]
  personalHistory           PatientPersonalHistory?
  familyHistory             PatientFamilyHistory[]
  allergies                 PatientAllergy[]
  currentMedications        PatientCurrentMedication[]
  documents                 PatientDocument[]
  consents                  PatientConsent[]
  privacySettings           PatientPrivacySetting?
  abhaSyncLogs              AbhaSyncLog[]
  appointments              Appointment[]
  queueTokens               QueueToken[]
  visits                    Visit[]
  admissions                Admission[]
  patientTransfers          PatientTransfer[]
  vitals                    Vital[]
  diagnoses                 Diagnosis[]
  progressNotes             ProgressNote[]
  nursingNotes              NursingNote[]
  ivLineRecords             IVLineRecord[]
  intakeOutputRecords       IntakeOutputRecord[]
  woundCareRecords          WoundCareRecord[]
  admissionAssessments      NursingAdmissionAssessment[]
  painAssessments           PainAssessment[]
  fallRiskAssessments       FallRiskAssessment[]
  clinicalObservations      ClinicalObservation[]
  clinicalDevices           ClinicalDevice[]
  clinicalDeviceChecks      ClinicalDeviceCheck[]
  clinicalProcedures        ClinicalProcedure[]
  dischargeSummaries        DischargeSummary[]
  prescriptions             Prescription[]
  medicationAdministrations MedicationAdministration[]
  labOrders                 LabOrder[]
  labResults                LabResult[]
  labReports                LabReport[]
  imagingRequests           ImagingRequest[]
  imagingResults            ImagingResult[]
  dicomStudies              DicomStudy[]
  dispensingRecords         DispensingRecord[]
  drugReturns               DrugReturn[]
  otKitIssues               OtKitIssue[]
  bills                     Bill[]
  payments                  Payment[]
  refunds                   Refund[]
  insurancePolicies         InsurancePolicy[]
  insuranceClaims           InsuranceClaim[]
  preAuthRequests           PreAuthorizationRequest[]
  crossMatchTests           CrossMatchTest[]
  transfusions              Transfusion[]
  tickets                   Ticket[]
  feedback                  Feedback[]
  incidentReports           IncidentReport[]
  otRequests                OtRequest[]
  cdssAlerts                CdssAlert[]
  hospitalConnection        PatientHospitalConnection?
  mrdRequests               MrdRequest[]
  reservations              Reservation[]
  estimations               Estimation[]
  admissionRequests         AdmissionRequest[]
  emarSchedules             EmarSchedule[]
  formSubmissions           HospitalFormSubmission[]

  @@unique([tenantId, mrn])
  @@map("patients")
}

model PatientEmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  name         String   @db.VarChar(100)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  email        String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_emergency_contacts")
}

model PatientPersonalHistory {
  id                 String              @id @default(uuid())
  patientId          String              @unique @map("patient_id")
  appetite           String?
  diet               String?
  sleepPattern       String?             @map("sleep_pattern")
  disorders          String?
  exerciseHabits     String?             @map("exercise_habits")
  smokingStatus      SmokingStatus?      @map("smoking_status")
  alcoholConsumption AlcoholConsumption? @map("alcohol_consumption")
  notes              String?
  updatedBy          String?             @map("updated_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  updater User?   @relation("PersonalHistoryUpdater", fields: [updatedBy], references: [id])

  @@map("patient_personal_history")
}

model PatientFamilyHistory {
  id            String       @id @default(uuid())
  patientId     String       @map("patient_id")
  conditionName String       @map("condition_name") @db.VarChar(255)
  relationSide  RelationSide @map("relation_side")
  relationship  String?      @db.VarChar(50)
  notes         String?
  updatedBy     String?      @map("updated_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  updater User?   @relation("FamilyHistoryUpdater", fields: [updatedBy], references: [id])

  @@map("patient_family_history")
}

model PatientAllergy {
  id          String           @id @default(uuid())
  patientId   String           @map("patient_id")
  allergyType AllergyType      @map("allergy_type")
  allergen    String           @db.VarChar(255)
  severity    AllergySeverity?
  reaction    String?
  notedBy     String?          @map("noted_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  noter   User?   @relation("AllergyNoter", fields: [notedBy], references: [id])

  @@map("patient_allergies")
}

/// Manually-entered medications that the patient is currently taking but which
/// are NOT generated from our Prescription system (e.g. OTC, prior prescriptions
/// from other hospitals, home remedies). Editable by doctor, viewable by both.
model PatientCurrentMedication {
  id        String    @id @default(uuid())
  patientId String    @map("patient_id")
  drugName  String    @map("drug_name") @db.VarChar(255)
  dosage    String?   @db.VarChar(100)
  frequency String?   @db.VarChar(100)
  route     String?   @db.VarChar(50)
  startedOn DateTime? @map("started_on") @db.Date
  source    String?   @db.VarChar(50)
  notes     String?
  addedBy   String?   @map("added_by")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])
  adder   User?   @relation("CurrentMedAdder", fields: [addedBy], references: [id])

  @@index([patientId, isActive])
  @@map("patient_current_medications")
}

model PatientDocument {
  id            String       @id @default(uuid())
  patientId     String       @map("patient_id")
  documentType  DocumentType @map("document_type")
  title         String       @db.VarChar(255)
  fileUrl       String       @map("file_url")
  fileSizeBytes BigInt?      @map("file_size_bytes")
  mimeType      String?      @map("mime_type") @db.VarChar(50)
  uploadedBy    String?      @map("uploaded_by")
  isVerified    Boolean      @default(false) @map("is_verified")
  verifiedBy    String?      @map("verified_by")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")

  patient  Patient @relation(fields: [patientId], references: [id])
  uploader User?   @relation("DocUploader", fields: [uploadedBy], references: [id])
  verifier User?   @relation("DocVerifier", fields: [verifiedBy], references: [id])

  @@map("patient_documents")
}

model PatientConsent {
  id           String        @id @default(uuid())
  patientId    String        @map("patient_id")
  consentType  ConsentType   @map("consent_type")
  title        String        @db.VarChar(255)
  description  String?
  status       ConsentStatus @default(pending)
  givenAt      DateTime?     @map("given_at")
  revokedAt    DateTime?     @map("revoked_at")
  signatureUrl String?       @map("signature_url")
  witnessName  String?       @map("witness_name") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_consents")
}

model PatientPrivacySetting {
  id                      String   @id @default(uuid())
  patientId               String   @unique @map("patient_id")
  dataAccessPreference    Json?    @map("data_access_preference")
  notificationPreferences Json?    @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_privacy_settings")
}

model AbhaSyncLog {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  patientId         String             @map("patient_id")
  syncDirection     SyncDirection      @map("sync_direction")
  recordType        AbhaSyncRecordType @map("record_type")
  recordId          String             @map("record_id")
  hipId             String?            @map("hip_id") @db.VarChar(100)
  hiuId             String?            @map("hiu_id") @db.VarChar(100)
  transactionId     String?            @map("transaction_id") @db.VarChar(255)
  consentArtifactId String?            @map("consent_artifact_id") @db.VarChar(255)
  fhirBundleUrl     String?            @map("fhir_bundle_url")
  status            AbhaSyncStatus     @default(pending)
  errorMessage      String?            @map("error_message")
  syncedAt          DateTime?          @map("synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@map("abha_sync_logs")
}

