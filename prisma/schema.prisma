model DutyRoster {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  staffId      String           @map("staff_id")
  departmentId String           @map("department_id")
  wardId       String?          @map("ward_id")
  role         String?          @db.VarChar(50)
  shiftDate    DateTime         @map("shift_date") @db.Date
  shiftType    ShiftType        @map("shift_type")
  startTime    DateTime         @map("start_time") @db.Time()
  endTime      DateTime         @map("end_time") @db.Time()
  status       DutyRosterStatus @default(scheduled)
  approvedBy   String?          @map("approved_by")
  approvedAt   DateTime?        @map("approved_at")
  createdBy    String?          @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  department Department   @relation(fields: [departmentId], references: [id])
  ward       Ward?        @relation(fields: [wardId], references: [id])
  approver   User?        @relation("DutyRosterApprover", fields: [approvedBy], references: [id])
  creator    User?        @relation("DutyRosterCreator", fields: [createdBy], references: [id])

  @@index([wardId, shiftDate, shiftType])
  @@index([staffId, shiftDate])
  @@map("duty_rosters")
}

// Per-shift patient→nurse assignment. Only required for IPD admissions.
// Exactly one row with status=active per (admissionId, shiftDate, shiftType) —
// enforced by a partial unique index added by hand in the migration SQL
// (Prisma cannot express partial uniques declaratively):
//   CREATE UNIQUE INDEX uq_nurse_assignment_active
//     ON nurse_assignments(admission_id, shift_date, shift_type)
//     WHERE status = 'active';
model NurseAssignment {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  admissionId    String                @map("admission_id")
  nurseId        String                @map("nurse_id")
  wardId         String                @map("ward_id")
  bedId          String?               @map("bed_id")
  shiftDate      DateTime              @map("shift_date") @db.Date
  shiftType      ShiftType             @map("shift_type")
  assignedById   String                @map("assigned_by_id")
  assignedAt     DateTime              @default(now()) @map("assigned_at")
  status         NurseAssignmentStatus @default(active)
  handedOverToId String?               @map("handed_over_to_id")
  handedOverAt   DateTime?             @map("handed_over_at")
  handoverNoteId String?               @map("handover_note_id")
  endedAt        DateTime?             @map("ended_at")
  endedReason    String?               @map("ended_reason")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  admission    Admission          @relation(fields: [admissionId], references: [id])
  nurse        User               @relation("NurseAssignmentNurse", fields: [nurseId], references: [id])
  ward         Ward               @relation(fields: [wardId], references: [id])
  bed          Bed?               @relation(fields: [bedId], references: [id])
  assigner     User               @relation("NurseAssignmentAssigner", fields: [assignedById], references: [id])
  handedOverTo User?              @relation("NurseAssignmentHandoverTo", fields: [handedOverToId], references: [id])
  handoverNote ShiftHandoverNote? @relation(fields: [handoverNoteId], references: [id])

  @@index([admissionId, status])
  @@index([nurseId, shiftDate])
  @@index([wardId, shiftDate, shiftType])
  @@map("nurse_assignments")
}

// Persistent nurse-to-doctor mapping. Created by `nurse_admin` and used to
// scope the bedside-nurse views to "patients of doctors I'm assigned to".
// One nurse can be assigned to many doctors; one doctor can have many nurses.
// At most one active row per (nurse, doctor) — enforced by a partial unique
// index in prisma/sql/nurse_doctor_assignment_partial_unique.sql.
model NurseDoctorAssignment {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  nurseId      String    @map("nurse_id")
  doctorId     String    @map("doctor_id")
  assignedById String    @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  isActive     Boolean   @default(true) @map("is_active")
  endedAt      DateTime? @map("ended_at")
  endedReason  String?   @map("ended_reason")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  nurse    User          @relation("NurseDoctorAssignmentNurse", fields: [nurseId], references: [id])
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])
  assigner User          @relation("NurseDoctorAssignmentAssigner", fields: [assignedById], references: [id])

  @@index([tenantId, nurseId, isActive])
  @@index([tenantId, doctorId, isActive])
  @@map("nurse_doctor_assignments")
}

model Attendance {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  staffId       String           @map("staff_id")
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  source        AttendanceSource @default(manual)
  status        AttendanceStatus @default(present)
  overtimeHours Decimal          @default(0) @map("overtime_hours") @db.Decimal(4, 2)
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  staff  StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("attendance")
}

model LeaveRequest {
  id         String             @id @default(uuid())
  tenantId   String             @map("tenant_id")
  staffId    String             @map("staff_id")
  leaveType  LeaveType          @map("leave_type")
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  reason     String?
  status     LeaveRequestStatus @default(pending)
  approvedBy String?            @map("approved_by")
  approvedAt DateTime?          @map("approved_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  staff    StaffProfile @relation(fields: [staffId], references: [id])
  approver User?        @relation(fields: [approvedBy], references: [id])

  @@map("leave_requests")
}

model Payroll {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  staffId        String        @map("staff_id")
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  basicSalary    Decimal?      @map("basic_salary") @db.Decimal(12, 2)
  allowances     Decimal       @default(0) @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay    Decimal       @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  grossSalary    Decimal?      @map("gross_salary") @db.Decimal(12, 2)
  taxDeduction   Decimal       @default(0) @map("tax_deduction") @db.Decimal(12, 2)
  netSalary      Decimal?      @map("net_salary") @db.Decimal(12, 2)
  status         PayrollStatus @default(draft)
  processedBy    String?       @map("processed_by")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  processor  User?        @relation(fields: [processedBy], references: [id])
  salarySlip SalarySlip?

  @@map("payroll")
}

model SalarySlip {
  id          String   @id @default(uuid())
  payrollId   String   @unique @map("payroll_id")
  staffId     String   @map("staff_id")
  slipNumber  String?  @unique @map("slip_number") @db.VarChar(50)
  pdfUrl      String?  @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  payroll Payroll      @relation(fields: [payrollId], references: [id])
