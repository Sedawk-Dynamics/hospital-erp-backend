// AI / LLM configuration, resolvable per hospital. A row with tenantId=null is
// the PLATFORM DEFAULT; a row with a tenantId is that hospital's override.
// resolveAiConfig(tenantId) uses the hospital row if present, else the platform
// default (default provider = gemini). API keys live in env (never here); these
// rows only select provider/model + fallbacks and toggle each AI use case, so a
// super-admin can run Gemini for one hospital and OpenAI for another, or turn
// AI off entirely (provider="disabled") — without a redeploy.
model AiConfig {
  id                     String   @id @default(uuid())
  // null = platform default; set = this hospital's override (one row each).
  tenantId               String?  @unique @map("tenant_id")
  // provider: which LLM backend to call — "gemini" | "openai" | "disabled".
  provider               String   @default("gemini") @db.VarChar(20)
  textModel              String   @default("gemini-2.5-flash") @map("text_model") @db.VarChar(100)
  // Ordered same-provider fallback models tried when the primary is rate-limited
  // or unavailable (e.g. free-tier RPD exhausted).
  fallbackModels         String[] @default([]) @map("fallback_models")
  temperature            Decimal  @default(0.4) @db.Decimal(3, 2)
  maxOutputTokens        Int      @default(1024) @map("max_output_tokens")
  // Per-use-case feature flags — one switch per place AI is used, so a
  // super-admin can disable AI in any single surface independently.
  patientChatEnabled     Boolean  @default(true) @map("patient_chat_enabled") // UC2 (Lvl 1)
  bloodReportEnabled     Boolean  @default(true) @map("blood_report_enabled") // UC2.2 blood report analysis
  platformChatEnabled    Boolean  @default(true) @map("platform_chat_enabled") // UC3 (Lvl 1, read-only)
  dischargeAiEnabled     Boolean  @default(true) @map("discharge_ai_enabled") // UC4
  // UC2.1 radiology image diagnosis — deferred to "coming soon" per MVP scope.
  radiologyAiEnabled     Boolean  @default(false) @map("radiology_ai_enabled")
  // Progress-note smart suggestions (doctor SOAP pad).
  progressNotesAiEnabled Boolean  @default(true) @map("progress_notes_ai_enabled")
  // Pharmacy/inventory invoice OCR scan (Add Stock).
  ocrInvoiceEnabled      Boolean  @default(true) @map("ocr_invoice_enabled")
  updatedById            String?  @map("updated_by_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("ai_config")
}

// Platform + per-tenant ICD-10 diagnosis code catalog. Rows with tenantId=null
// are the shared platform reference set (managed by super-admin); rows with a
// tenantId are a hospital's own custom codes. Powers diagnosis autocomplete and
// the CDSS use cases that reference ICD codes.
/// The list of disorders a patient or clinician can pick from when recording
/// "existing disorders".
///
/// Separate from IcdCode on purpose, though it is seeded from it. IcdCode is
/// the WHO CLASSIFICATION — all 12,325 rows of it, including injuries, external
/// causes, pregnancy states and "factors influencing health status", none of
/// which is a disorder someone lives with. This is the shorter, curated list a
/// super admin owns: seeded from the disease chapters (A-N, Q) and then theirs
/// to add to or prune.
///
/// `tenantId` null is the platform list every hospital sees, matching IcdCode.
/// A row keeps its `icdCode` where it has one, so a picked disorder is still
/// coded; a hand-added one may have none.
model Disorder {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  name         String   @db.VarChar(500)
  /// The ICD-10 code this came from, where it has one. Null for a disorder a
  /// super admin added by hand.
  icdCode      String?  @map("icd_code") @db.VarChar(20)
  category     String?  @db.VarChar(255)
  /// Denormalised lowercase name + code + keywords, recomputed on write.
  searchTokens String?  @map("search_tokens")
  keywords     String[] @default([])
  isCustom     Boolean  @default(false) @map("is_custom")
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([icdCode])
  @@map("disorders")
}

model IcdCode {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  code         String   @db.VarChar(20)
  title        String   @db.VarChar(500)
  category     String?  @db.VarChar(255)
  chapter      String?  @db.VarChar(255)
  isBillable   Boolean  @default(true) @map("is_billable")
  isCustom     Boolean  @default(false) @map("is_custom")
  isActive     Boolean  @default(true) @map("is_active")
  // Denormalised lowercase index of code + title + keywords, recomputed on
  // write — drives the search endpoint.
  searchTokens String?  @map("search_tokens")
  keywords     String[] @default([])
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([code])
  @@map("icd_codes")
}

