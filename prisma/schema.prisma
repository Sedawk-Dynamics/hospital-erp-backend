  createdAt         DateTime     @default(now()) @map("created_at")

  visit   Visit   @relation(fields: [visitId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  nurse   User    @relation(fields: [nurseId], references: [id])

  @@map("wound_care_records")
}

model DischargeSummary {
  id                       String                 @id @default(uuid())
  admissionId              String                 @unique @map("admission_id")
  visitId                  String                 @map("visit_id")
  patientId                String                 @map("patient_id")
  doctorId                 String                 @map("doctor_id")
  admissionDate            DateTime?              @map("admission_date")
  dischargeDate            DateTime?              @map("discharge_date")
  diagnosesSummary         String?                @map("diagnoses_summary")
  proceduresSummary        String?                @map("procedures_summary")
  labResultsSummary        String?                @map("lab_results_summary")
  medicationReconciliation String?                @map("medication_reconciliation")
  dischargeInstructions    String?                @map("discharge_instructions")
  followUpDate             DateTime?              @map("follow_up_date") @db.Date
  followUpInstructions     String?                @map("follow_up_instructions")
  status                   DischargeSummaryStatus @default(draft)
  signedBy                 String?                @map("signed_by")
  signedAt                 DateTime?              @map("signed_at")
  eSignatureUrl            String?                @map("e_signature_url")
  pdfUrl                   String?                @map("pdf_url")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at")

  admission Admission     @relation(fields: [admissionId], references: [id])
  visit     Visit         @relation(fields: [visitId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  signer    User?         @relation(fields: [signedBy], references: [id])

  @@map("discharge_summaries")
}

// ============================================================
// 8. PRESCRIPTIONS & MEDICATIONS
// ============================================================

model Prescription {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  visitId          String             @map("visit_id")
  patientId        String             @map("patient_id")
  doctorId         String             @map("doctor_id")
  prescriptionType PrescriptionType   @map("prescription_type")
  status           PrescriptionStatus @default(active)
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  visit             Visit              @relation(fields: [visitId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])
  prescriptionItems PrescriptionItem[]
  dispensingRecords DispensingRecord[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String          @id @default(uuid())
  prescriptionId String          @map("prescription_id")
  drugId         String?         @map("drug_id")
  drugName       String          @map("drug_name") @db.VarChar(255)
  dosage         String          @db.VarChar(100)
  frequency      String          @db.VarChar(100)
  duration       String?         @db.VarChar(100)
  route          MedicationRoute @default(oral)
  instructions   String?
  quantity       Int?
  isPrn          Boolean         @default(false) @map("is_prn")
  createdAt      DateTime        @default(now()) @map("created_at")

  prescription              Prescription               @relation(fields: [prescriptionId], references: [id])
  drug                      DrugFormulary?             @relation(fields: [drugId], references: [id])
  medicationAdministrations MedicationAdministration[]
  dispensingRecords         DispensingRecord[]

  @@map("prescription_items")
}

model MedicationAdministration {
  id                 String         @id @default(uuid())
  prescriptionItemId String         @map("prescription_item_id")
  patientId          String         @map("patient_id")
  administeredBy     String         @map("administered_by")
  administeredAt     DateTime       @map("administered_at")
  doseGiven          String?        @map("dose_given") @db.VarChar(100)
  status             MedAdminStatus
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")

  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  administrator    User             @relation(fields: [administeredBy], references: [id])

  @@map("medication_administrations")
}

// ============================================================
// 9. LAB & IMAGING
// ============================================================

model LabDepartment {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  labTestCatalog LabTestCatalog[]

  @@map("lab_departments")
}

model LabTestCatalog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  labDepartmentId String   @map("lab_department_id")
  testName        String   @map("test_name") @db.VarChar(255)
  testCode        String?  @map("test_code") @db.VarChar(50)
  description     String?
  normalRange     String?  @map("normal_range")
  unit            String?  @db.VarChar(50)
  price           Decimal? @db.Decimal(10, 2)
  turnaroundHours Int?     @map("turnaround_hours")
  sampleType      String?  @map("sample_type") @db.VarChar(50)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  labDepartment LabDepartment @relation(fields: [labDepartmentId], references: [id])
  labOrderItems LabOrderItem[]

  @@map("lab_test_catalog")
}

model LabOrder {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  patientId        String        @map("patient_id")
  visitId          String        @map("visit_id")
  orderedBy        String        @map("ordered_by")
  urgency          Urgency       @default(routine)
  status           LabOrderStatus @default(ordered)
  isThirdParty     Boolean       @default(false) @map("is_third_party")
  thirdPartyLabName String?      @map("third_party_lab_name") @db.VarChar(255)
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  visit         Visit          @relation(fields: [visitId], references: [id])
  orderer       User           @relation(fields: [orderedBy], references: [id])
  labOrderItems LabOrderItem[]
  labSamples    LabSample[]
  labResults    LabResult[]
  labReport     LabReport?

  @@map("lab_orders")
}

model LabOrderItem {
  id         String             @id @default(uuid())
  labOrderId String             @map("lab_order_id")
  testId     String             @map("test_id")
  status     LabOrderItemStatus @default(pending)
  createdAt  DateTime           @default(now()) @map("created_at")

  labOrder   LabOrder       @relation(fields: [labOrderId], references: [id])
  test       LabTestCatalog @relation(fields: [testId], references: [id])
  labResults LabResult[]

  @@map("lab_order_items")
}

model LabSample {
  id              String          @id @default(uuid())
  labOrderId      String          @map("lab_order_id")
  sampleType      String          @map("sample_type") @db.VarChar(50)
  barcode         String?         @unique @db.VarChar(100)
  collectedBy     String?         @map("collected_by")
  collectedAt     DateTime?       @map("collected_at")
  receivedAt      DateTime?       @map("received_at")
  status          LabSampleStatus @default(collected)
  rejectionReason String?         @map("rejection_reason")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  labOrder  LabOrder @relation(fields: [labOrderId], references: [id])
  collector User?    @relation(fields: [collectedBy], references: [id])

  @@map("lab_samples")
}

model LabResult {
  id             String   @id @default(uuid())
  labOrderItemId String   @map("lab_order_item_id")
  labOrderId     String   @map("lab_order_id")
  patientId      String   @map("patient_id")
  parameterName  String   @map("parameter_name") @db.VarChar(255)
  value          String?  @db.VarChar(255)
  unit           String?  @db.VarChar(50)
  normalRange    String?  @map("normal_range") @db.VarChar(100)
  isAbnormal     Boolean  @default(false) @map("is_abnormal")
  enteredBy      String?  @map("entered_by")
  enteredAt      DateTime @default(now()) @map("entered_at")

  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  labOrder     LabOrder     @relation(fields: [labOrderId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  enterer      User?        @relation(fields: [enteredBy], references: [id])

  @@map("lab_results")
}

model LabReport {
  id               String          @id @default(uuid())
  labOrderId       String          @unique @map("lab_order_id")
  patientId        String          @map("patient_id")
  reportContent    String?         @map("report_content")
  hospitalBranding Json?           @map("hospital_branding")
  qrCodeUrl        String?         @map("qr_code_url")
  pdfUrl           String?         @map("pdf_url")
  status           LabReportStatus @default(draft)
  reviewedBy       String?         @map("reviewed_by")
  reviewedAt       DateTime?       @map("reviewed_at")
  approvedBy       String?         @map("approved_by")
  approvedAt       DateTime?       @map("approved_at")
  signedBy         String?         @map("signed_by")
  signedAt         DateTime?       @map("signed_at")
  version          Int             @default(1)
  correctionNotes  String?         @map("correction_notes")
  publishedAt      DateTime?       @map("published_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  labOrder LabOrder @relation(fields: [labOrderId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  reviewer User?    @relation("LabReportReviewer", fields: [reviewedBy], references: [id])
  approver User?    @relation("LabReportApprover", fields: [approvedBy], references: [id])
  signer   User?    @relation("LabReportSigner", fields: [signedBy], references: [id])

  @@map("lab_reports")
}

// ============================================================
// 10. IMAGING
// ============================================================

model ImagingRequest {
  id                 String               @id @default(uuid())
  tenantId           String               @map("tenant_id")
  patientId          String               @map("patient_id")
  visitId            String               @map("visit_id")
  orderedBy          String               @map("ordered_by")
  imagingType        ImagingType          @map("imaging_type")
  bodyPart           String?              @map("body_part") @db.VarChar(100)
  urgency            Urgency              @default(routine)
  clinicalIndication String?              @map("clinical_indication")
  status             ImagingRequestStatus @default(requested)
  scheduledAt        DateTime?            @map("scheduled_at")
  completedAt        DateTime?            @map("completed_at")
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  visit         Visit          @relation(fields: [visitId], references: [id])
  orderer       User           @relation(fields: [orderedBy], references: [id])
  imagingResult ImagingResult?

  @@map("imaging_requests")
}

model ImagingResult {
  id               String              @id @default(uuid())
  imagingRequestId String              @unique @map("imaging_request_id")
  patientId        String              @map("patient_id")
  findings         String?
  impression       String?
  radiologistId    String?             @map("radiologist_id")
  imageUrls        Json?               @map("image_urls")
  pacsReferenceId  String?             @map("pacs_reference_id") @db.VarChar(255)
  pdfReportUrl     String?             @map("pdf_report_url")
  status           ImagingResultStatus @default(draft)
  signedBy         String?             @map("signed_by")
  signedAt         DateTime?           @map("signed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")

  imagingRequest ImagingRequest @relation(fields: [imagingRequestId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  radiologist    User?          @relation("ImagingRadiologist", fields: [radiologistId], references: [id])
  signer         User?          @relation("ImagingResultSigner", fields: [signedBy], references: [id])

  @@map("imaging_results")
}

// ============================================================
// 11. PHARMACY
// ============================================================

model DrugCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  drugFormulary DrugFormulary[]

  @@map("drug_categories")
}

model DrugFormulary {
  id                String     @id @default(uuid())
  tenantId          String     @map("tenant_id")
  drugName          String     @map("drug_name") @db.VarChar(255)
  genericName       String?    @map("generic_name") @db.VarChar(255)
  categoryId        String?    @map("category_id")
  manufacturer      String?    @db.VarChar(255)
  dosageForm        DosageForm? @map("dosage_form")
  strength          String?    @db.VarChar(100)
  unitOfMeasurement String?    @map("unit_of_measurement") @db.VarChar(20)
  price             Decimal?   @db.Decimal(10, 2)
  indications       String?
  contraindications String?
  isActive          Boolean    @default(true) @map("is_active")
  isRecalled        Boolean    @default(false) @map("is_recalled")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  category          DrugCategory?      @relation(fields: [categoryId], references: [id])
  drugBatches       DrugBatch[]
  prescriptionItems PrescriptionItem[]

  @@map("drug_formulary")
}

model DrugBatch {
  id                String    @id @default(uuid())
  drugId            String    @map("drug_id")
  tenantId          String    @map("tenant_id")
  batchNumber       String    @map("batch_number") @db.VarChar(100)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime  @map("expiry_date") @db.Date
  supplierId        String?   @map("supplier_id")
  purchasePrice     Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice      Decimal?  @map("selling_price") @db.Decimal(10, 2)
  quantityReceived  Int       @map("quantity_received")
  quantityInStock   Int       @map("quantity_in_stock")
  isExpired         Boolean   @default(false) @map("is_expired")
  isRecalled        Boolean   @default(false) @map("is_recalled")
  recallReason      String?   @map("recall_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  drug              DrugFormulary      @relation(fields: [drugId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  dispensingRecords DispensingRecord[]
  drugReturns       DrugReturn[]

  @@map("drug_batches")
}

model DispensingRecord {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  prescriptionId     String   @map("prescription_id")
  prescriptionItemId String   @map("prescription_item_id")
  patientId          String   @map("patient_id")
  drugBatchId        String   @map("drug_batch_id")
  quantityDispensed  Int      @map("quantity_dispensed")
  dispensedBy        String   @map("dispensed_by")
  dispensedAt        DateTime @default(now()) @map("dispensed_at")
  verifiedBy         String?  @map("verified_by")
  notes              String?

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  prescription     Prescription     @relation(fields: [prescriptionId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  drugBatch        DrugBatch        @relation(fields: [drugBatchId], references: [id])
  dispenser        User             @relation("Dispenser", fields: [dispensedBy], references: [id])
  verifier         User?            @relation("DispensingVerifier", fields: [verifiedBy], references: [id])

  @@map("dispensing_records")
}

model DrugReturn {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  returnType  ReturnType      @map("return_type")
  drugBatchId String          @map("drug_batch_id")
  patientId   String?         @map("patient_id")
  supplierId  String?         @map("supplier_id")
  quantity    Int
  reason      String?
  processedBy String?         @map("processed_by")
  status      DrugReturnStatus @default(pending)
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  drugBatch DrugBatch @relation(fields: [drugBatchId], references: [id])
  patient   Patient?  @relation(fields: [patientId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  processor User?     @relation(fields: [processedBy], references: [id])

  @@map("drug_returns")
}

// ============================================================
// 12. INVENTORY & PURCHASE
// ============================================================

model Supplier {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  name          String      @db.VarChar(255)
  contactPerson String?     @map("contact_person") @db.VarChar(100)
  phone         String?     @db.VarChar(20)
  email         String?     @db.VarChar(255)
  address       String?
  gstNumber     String?     @map("gst_number") @db.VarChar(50)
  licenseNumber String?     @map("license_number") @db.VarChar(100)
  supplyType    SupplyType? @map("supply_type")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  drugBatches       DrugBatch[]
  drugReturns       DrugReturn[]
  stockTransactions StockTransaction[]
  purchaseOrders    PurchaseOrder[]

  @@map("suppliers")
}

model InventoryItem {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  itemName              String            @map("item_name") @db.VarChar(255)
  itemCode              String?           @map("item_code") @db.VarChar(50)
  category              InventoryCategory
  description           String?
  unitOfMeasurement     String?           @map("unit_of_measurement") @db.VarChar(20)
  minimumStockThreshold Int               @default(10) @map("minimum_stock_threshold")
  currentStock          Int               @default(0) @map("current_stock")
  costPerUnit           Decimal?          @map("cost_per_unit") @db.Decimal(10, 2)
  sellingPricePerUnit   Decimal?          @map("selling_price_per_unit") @db.Decimal(10, 2)
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  supplyRequests     SupplyRequest[]

  @@map("inventory_items")
}

model StockTransaction {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  inventoryItemId String               @map("inventory_item_id")
  transactionType StockTransactionType @map("transaction_type")
  quantity        Int
  batchNumber     String?              @map("batch_number") @db.VarChar(100)
  expiryDate      DateTime?            @map("expiry_date") @db.Date
  supplierId      String?              @map("supplier_id")
  referenceType   String?              @map("reference_type") @db.VarChar(50)
  referenceId     String?              @map("reference_id")
  unitCost        Decimal?             @map("unit_cost") @db.Decimal(10, 2)
  totalCost       Decimal?             @map("total_cost") @db.Decimal(12, 2)
  departmentId    String?              @map("department_id")
  notes           String?
  performedBy     String               @map("performed_by")
  createdAt       DateTime             @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  performer     User          @relation(fields: [performedBy], references: [id])

  @@map("stock_transactions")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  supplierId           String              @map("supplier_id")
  orderNumber          String              @unique @map("order_number") @db.VarChar(50)
  orderDate            DateTime            @map("order_date") @db.Date
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  status               PurchaseOrderStatus @default(draft)
  totalAmount          Decimal?            @map("total_amount") @db.Decimal(12, 2)
  approvedBy           String?             @map("approved_by")
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  approver User?               @relation(fields: [approvedBy], references: [id])
  items    PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  inventoryItemId String   @map("inventory_item_id")
  quantityOrdered Int      @map("quantity_ordered")
  quantityReceived Int     @default(0) @map("quantity_received")
  unitPrice       Decimal? @map("unit_price") @db.Decimal(10, 2)
  totalPrice      Decimal? @map("total_price") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("purchase_order_items")
}

model SupplyRequest {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  requestedBy       String              @map("requested_by")
  departmentId      String              @map("department_id")
  wardId            String?             @map("ward_id")
  inventoryItemId   String              @map("inventory_item_id")
  quantityRequested Int                 @map("quantity_requested")
  quantityFulfilled Int                 @default(0) @map("quantity_fulfilled")
  status            SupplyRequestStatus @default(pending)
  urgency           SupplyUrgency       @default(routine)
  approvedBy        String?             @map("approved_by")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  requester     User          @relation("SupplyRequester", fields: [requestedBy], references: [id])
  department    Department    @relation(fields: [departmentId], references: [id])
  ward          Ward?         @relation(fields: [wardId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  approver      User?         @relation("SupplyApprover", fields: [approvedBy], references: [id])

  @@map("supply_requests")
}

// ============================================================
// 13. BILLING & PAYMENTS
// ============================================================

model ServiceTariff {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  serviceName    String                @map("service_name") @db.VarChar(255)
  serviceCode    String?               @map("service_code") @db.VarChar(50)
  category       ServiceTariffCategory
  basePrice      Decimal               @map("base_price") @db.Decimal(12, 2)
  gstRatePercent Decimal               @default(0) @map("gst_rate_percent") @db.Decimal(4, 2)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  billItems BillItem[]

  @@map("service_tariffs")
}

model Bill {
  id                     String     @id @default(uuid())
  tenantId               String     @map("tenant_id")
  patientId              String     @map("patient_id")
  visitId                String?    @map("visit_id")
  admissionId            String?    @map("admission_id")
  billNumber             String     @unique @map("bill_number") @db.VarChar(50)
  billDate               DateTime   @map("bill_date")
  subtotal               Decimal    @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount              Decimal    @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount            Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  insuranceCoveredAmount Decimal    @default(0) @map("insurance_covered_amount") @db.Decimal(12, 2)
  patientPayableAmount   Decimal    @default(0) @map("patient_payable_amount") @db.Decimal(12, 2)
  amountPaid             Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue             Decimal    @default(0) @map("balance_due") @db.Decimal(12, 2)
  status                 BillStatus @default(draft)
  generatedBy            String?    @map("generated_by")
  approvedBy             String?    @map("approved_by")
  cancelledBy            String?    @map("cancelled_by")
  cancellationReason     String?    @map("cancellation_reason")
  pdfUrl                 String?    @map("pdf_url")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id])
  visit           Visit?           @relation(fields: [visitId], references: [id])
  admission       Admission?       @relation(fields: [admissionId], references: [id])
  generator       User?            @relation("BillGenerator", fields: [generatedBy], references: [id])
  approver        User?            @relation("BillApprover", fields: [approvedBy], references: [id])
  canceller       User?            @relation("BillCanceller", fields: [cancelledBy], references: [id])
  billItems       BillItem[]
  payments        Payment[]
  refunds         Refund[]
  discounts       Discount[]
  insuranceClaims InsuranceClaim[]

  @@map("bills")
}

model BillItem {
  id              String           @id @default(uuid())
  billId          String           @map("bill_id")
  serviceTariffId String?          @map("service_tariff_id")
  description     String           @db.VarChar(500)
  category        BillItemCategory
  quantity        Int              @default(1)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxPercent      Decimal          @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(12, 2)
  referenceType   String?          @map("reference_type") @db.VarChar(50)
  referenceId     String?          @map("reference_id")
  isAutoPulled    Boolean          @default(false) @map("is_auto_pulled")
  createdAt       DateTime         @default(now()) @map("created_at")

  bill          Bill           @relation(fields: [billId], references: [id])
  serviceTariff ServiceTariff? @relation(fields: [serviceTariffId], references: [id])

  @@map("bill_items")
}

model Payment {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  billId           String        @map("bill_id")
  patientId        String        @map("patient_id")
  paymentDate      DateTime      @map("payment_date")
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentType      PaymentTypeEnum @default(regular) @map("payment_type")
  transactionId    String?       @map("transaction_id") @db.VarChar(100)
  gatewayReference String?       @map("gateway_reference") @db.VarChar(255)
  idempotencyKey   String?       @unique @map("idempotency_key") @db.VarChar(255)
  status           PaymentStatus @default(completed)
  processedBy      String?       @map("processed_by")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  bill      Bill     @relation(fields: [billId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
  processor User?    @relation(fields: [processedBy], references: [id])
  receipt    Receipt?
  refunds    Refund[]
  transfers  PaymentTransfer[]

  @@map("payments")
}

model Receipt {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  paymentId     String   @unique @map("payment_id")
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(50)
  receiptDate   DateTime @map("receipt_date")
  amount        Decimal  @db.Decimal(12, 2)
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

model Refund {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  billId      String       @map("bill_id")
  paymentId   String       @map("payment_id")
  patientId   String       @map("patient_id")
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(requested)
  requestedBy String?      @map("requested_by")
  approvedBy  String?      @map("approved_by")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  bill      Bill    @relation(fields: [billId], references: [id])
  payment   Payment @relation(fields: [paymentId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  requester User?   @relation("RefundRequester", fields: [requestedBy], references: [id])
  approver  User?   @relation("RefundApprover", fields: [approvedBy], references: [id])

  @@map("refunds")
}

model Discount {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  billId       String       @map("bill_id")
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(10, 2)
  reason       String?
  approvedBy   String?      @map("approved_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  bill     Bill   @relation(fields: [billId], references: [id])
  approver User?  @relation(fields: [approvedBy], references: [id])

  @@map("discounts")
}

// ============================================================
// 14. INSURANCE & TPA
// ============================================================

model Insurer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  insurancePolicies InsurancePolicy[]

  @@map("insurers")
}

model TpaProvider {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  insurancePolicies    InsurancePolicy[]
  tpaCommunicationLogs TpaCommunicationLog[]

  @@map("tpa_providers")
}

model InsurancePolicy {
  id              String                @id @default(uuid())
  tenantId        String                @map("tenant_id")
  patientId       String                @map("patient_id")
  insurerId       String                @map("insurer_id")
  tpaId           String?               @map("tpa_id")
  policyNumber    String                @map("policy_number") @db.VarChar(100)
  groupNumber     String?               @map("group_number") @db.VarChar(100)
  planName        String?               @map("plan_name") @db.VarChar(255)
  coverageAmount  Decimal?              @map("coverage_amount") @db.Decimal(12, 2)
  coPayPercent    Decimal               @default(0) @map("co_pay_percent") @db.Decimal(5, 2)
  deductibleAmount Decimal              @default(0) @map("deductible_amount") @db.Decimal(10, 2)
  exclusions      String?
  validFrom       DateTime              @map("valid_from") @db.Date
  validTo         DateTime              @map("valid_to") @db.Date
  status          InsurancePolicyStatus @default(active)
  createdAt       DateTime              @default(now()) @map("created_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  patient         Patient                  @relation(fields: [patientId], references: [id])
  insurer         Insurer                  @relation(fields: [insurerId], references: [id])
  tpa             TpaProvider?             @relation(fields: [tpaId], references: [id])
  insuranceClaims InsuranceClaim[]
  preAuthRequests PreAuthorizationRequest[]

  @@map("insurance_policies")
}

model InsuranceClaim {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  patientId       String      @map("patient_id")
  policyId        String      @map("policy_id")
  billId          String      @map("bill_id")
  claimNumber     String?     @unique @map("claim_number") @db.VarChar(100)
  claimAmount     Decimal     @map("claim_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?    @map("approved_amount") @db.Decimal(12, 2)
  patientShare    Decimal?    @map("patient_share") @db.Decimal(12, 2)
  status          ClaimStatus @default(submitted)
  submissionDate  DateTime    @map("submission_date")
  approvalDate    DateTime?   @map("approval_date")
  settlementDate  DateTime?   @map("settlement_date")
  rejectionReason String?     @map("rejection_reason")
  documentsUrl    Json?       @map("documents_url")
  submittedBy     String?     @map("submitted_by")
  reviewedBy      String?     @map("reviewed_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  patient             Patient             @relation(fields: [patientId], references: [id])
  policy              InsurancePolicy     @relation(fields: [policyId], references: [id])
  bill                Bill                @relation(fields: [billId], references: [id])
  submitter           User?               @relation("ClaimSubmitter", fields: [submittedBy], references: [id])
  reviewer            User?               @relation("ClaimReviewer", fields: [reviewedBy], references: [id])
  tpaCommunicationLogs TpaCommunicationLog[]

  @@map("insurance_claims")
}

model PreAuthorizationRequest {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  patientId            String        @map("patient_id")
  policyId             String        @map("policy_id")
  procedureDescription String        @map("procedure_description")
  estimatedCost        Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  status               PreAuthStatus @default(pending)
  approvalNumber       String?       @map("approval_number") @db.VarChar(100)
  validFrom            DateTime?     @map("valid_from") @db.Date
  validTo              DateTime?     @map("valid_to") @db.Date
  notes                String?
  submittedBy          String?       @map("submitted_by")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  patient   Patient         @relation(fields: [patientId], references: [id])
  policy    InsurancePolicy @relation(fields: [policyId], references: [id])
  submitter User?           @relation(fields: [submittedBy], references: [id])

  @@map("pre_authorization_requests")
}

model TpaCommunicationLog {
  id                String                 @id @default(uuid())
  tenantId          String                 @map("tenant_id")
  claimId           String?                @map("claim_id")
  tpaId             String                 @map("tpa_id")
  communicationType CommunicationType?     @map("communication_type")
  subject           String?                @db.VarChar(255)
  content           String?
  direction         CommunicationDirection?
  communicatedBy    String?                @map("communicated_by")
  createdAt         DateTime               @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  claim        InsuranceClaim? @relation(fields: [claimId], references: [id])
  tpa          TpaProvider     @relation(fields: [tpaId], references: [id])
  communicator User?           @relation(fields: [communicatedBy], references: [id])

  @@map("tpa_communication_logs")
}

// ============================================================
// 15. BLOOD BANK
// ============================================================

model BloodDonor {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String?   @map("last_name") @db.VarChar(100)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           Gender?
  bloodGroup       String    @map("blood_group") @db.VarChar(5)
  phone            String?   @db.VarChar(20)
  email            String?   @db.VarChar(255)
  address          String?
  healthStatus     String?   @map("health_status")
  isEligible       Boolean   @default(true) @map("is_eligible")
  lastDonationDate DateTime? @map("last_donation_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  bloodDonations BloodDonation[]

  @@map("blood_donors")
}

model BloodDonation {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  donorId         String          @map("donor_id")
  donationDate    DateTime        @map("donation_date")
  donationType    DonationType    @map("donation_type")
  volumeMl        Int             @map("volume_ml")
  bagNumber       String?         @unique @map("bag_number") @db.VarChar(50)
  screeningResult ScreeningResult @default(pending) @map("screening_result")
  notes           String?
  collectedBy     String?         @map("collected_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  donor          BloodDonor       @relation(fields: [donorId], references: [id])
  collector      User?            @relation(fields: [collectedBy], references: [id])
  bloodInventory BloodInventory[]

  @@map("blood_donations")
}

model BloodInventory {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  donationId      String?              @map("donation_id")
  componentType   BloodComponentType   @map("component_type")
  bloodGroup      String               @map("blood_group") @db.VarChar(5)
  bagNumber       String?              @unique @map("bag_number") @db.VarChar(50)
  volumeMl        Int                  @map("volume_ml")
  collectionDate  DateTime             @map("collection_date") @db.Date
  expiryDate      DateTime             @map("expiry_date") @db.Date
  status          BloodInventoryStatus @default(available)
  storageLocation String?              @map("storage_location") @db.VarChar(100)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  donation        BloodDonation?  @relation(fields: [donationId], references: [id])
  crossMatchTests CrossMatchTest[]
  transfusions    Transfusion[]

  @@map("blood_inventory")
}

model CrossMatchTest {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  patientId        String           @map("patient_id")
  bloodInventoryId String           @map("blood_inventory_id")
  result           CrossMatchResult @default(pending)
  testedBy         String?          @map("tested_by")
  testedAt         DateTime?        @map("tested_at")
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  bloodInventory BloodInventory @relation(fields: [bloodInventoryId], references: [id])
  tester         User?          @relation(fields: [testedBy], references: [id])
  transfusions   Transfusion[]

  @@map("cross_match_tests")
}

model Transfusion {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  patientId        String   @map("patient_id")
  visitId          String   @map("visit_id")
  bloodInventoryId String   @map("blood_inventory_id")
  crossMatchId     String   @map("cross_match_id")
  transfusionDate  DateTime @map("transfusion_date")
  volumeMl         Int      @map("volume_ml")
  administeredBy   String   @map("administered_by")
  orderedBy        String   @map("ordered_by")
  adverseReaction  Boolean  @default(false) @map("adverse_reaction")
  reactionDetails  String?  @map("reaction_details")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  patient        Patient        @relation(fields: [patientId], references: [id])
  visit          Visit          @relation(fields: [visitId], references: [id])
  bloodInventory BloodInventory @relation(fields: [bloodInventoryId], references: [id])
  crossMatch     CrossMatchTest @relation(fields: [crossMatchId], references: [id])
  administrator  User           @relation("TransfusionAdministerer", fields: [administeredBy], references: [id])
  orderer        User           @relation("TransfusionOrderer", fields: [orderedBy], references: [id])

  @@map("transfusions")
}

// ============================================================
// 16. HUMAN RESOURCES (HR)
// ============================================================

model StaffProfile {
  id                    String          @id @default(uuid())
  userId                String          @unique @map("user_id")
  tenantId              String          @map("tenant_id")
  departmentId          String          @map("department_id")
  employeeId            String?         @unique @map("employee_id") @db.VarChar(50)
  position              String?         @db.VarChar(100)
  dateOfJoining         DateTime?       @map("date_of_joining") @db.Date
  dateOfBirth           DateTime?       @map("date_of_birth") @db.Date
  gender                Gender?
  address               String?
  emergencyContactName  String?         @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone String?         @map("emergency_contact_phone") @db.VarChar(20)
  salary                Decimal?        @db.Decimal(12, 2)
  employmentType        EmploymentType? @map("employment_type")
  status                StaffStatus     @default(active)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  department     Department      @relation(fields: [departmentId], references: [id])
  staffLicenses  StaffLicense[]
  dutyRosters    DutyRoster[]
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  payroll        Payroll[]
  salarySlips    SalarySlip[]

  @@map("staff_profiles")
}

model StaffLicense {
  id               String        @id @default(uuid())
  staffId          String        @map("staff_id")
  licenseType      String        @map("license_type") @db.VarChar(100)
  licenseNumber    String        @map("license_number") @db.VarChar(100)
  issuingAuthority String?       @map("issuing_authority") @db.VarChar(255)
  issuedDate       DateTime?     @map("issued_date") @db.Date
  expiryDate       DateTime?     @map("expiry_date") @db.Date
  documentUrl      String?       @map("document_url")
  status           LicenseStatus @default(active)
  createdAt        DateTime      @default(now()) @map("created_at")

  staff StaffProfile @relation(fields: [staffId], references: [id])

  @@map("staff_licenses")
}

model DutyRoster {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  staffId      String           @map("staff_id")
  departmentId String           @map("department_id")
  shiftDate    DateTime         @map("shift_date") @db.Date
  shiftType    ShiftType        @map("shift_type")
  startTime    DateTime         @map("start_time") @db.Time()
  endTime      DateTime         @map("end_time") @db.Time()
  status       DutyRosterStatus @default(scheduled)
  createdAt    DateTime         @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  department Department   @relation(fields: [departmentId], references: [id])

  @@map("duty_rosters")
}

model Attendance {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  staffId       String           @map("staff_id")
  date          DateTime         @db.Date
  checkIn       DateTime?        @map("check_in")
  checkOut      DateTime?        @map("check_out")
  source        AttendanceSource @default(manual)
  status        AttendanceStatus @default(present)
  overtimeHours Decimal          @default(0) @map("overtime_hours") @db.Decimal(4, 2)
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  staff  StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("attendance")
}

model LeaveRequest {
  id         String             @id @default(uuid())
  tenantId   String             @map("tenant_id")
  staffId    String             @map("staff_id")
  leaveType  LeaveType          @map("leave_type")
  startDate  DateTime           @map("start_date") @db.Date
  endDate    DateTime           @map("end_date") @db.Date
  reason     String?
  status     LeaveRequestStatus @default(pending)
  approvedBy String?            @map("approved_by")
  approvedAt DateTime?          @map("approved_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  staff    StaffProfile @relation(fields: [staffId], references: [id])
  approver User?        @relation(fields: [approvedBy], references: [id])

  @@map("leave_requests")
}

model Payroll {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  staffId        String        @map("staff_id")
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  basicSalary    Decimal?      @map("basic_salary") @db.Decimal(12, 2)
  allowances     Decimal       @default(0) @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay    Decimal       @default(0) @map("overtime_pay") @db.Decimal(12, 2)
  grossSalary    Decimal?      @map("gross_salary") @db.Decimal(12, 2)
  taxDeduction   Decimal       @default(0) @map("tax_deduction") @db.Decimal(12, 2)
  netSalary      Decimal?      @map("net_salary") @db.Decimal(12, 2)
  status         PayrollStatus @default(draft)
  processedBy    String?       @map("processed_by")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  staff      StaffProfile @relation(fields: [staffId], references: [id])
  processor  User?        @relation(fields: [processedBy], references: [id])
  salarySlip SalarySlip?

  @@map("payroll")
}

model SalarySlip {
  id          String   @id @default(uuid())
  payrollId   String   @unique @map("payroll_id")
  staffId     String   @map("staff_id")
  slipNumber  String?  @unique @map("slip_number") @db.VarChar(50)
  pdfUrl      String?  @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  payroll Payroll      @relation(fields: [payrollId], references: [id])
  staff   StaffProfile @relation(fields: [staffId], references: [id])

  @@map("salary_slips")
}

// ============================================================
// 17. COMMUNICATION & NOTIFICATIONS
// ============================================================

model Notification {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  userId           String              @map("user_id")
  title            String              @db.VarChar(255)
  message          String
  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel @default(in_app)
  referenceType    String?             @map("reference_type") @db.VarChar(50)
  referenceId      String?             @map("reference_id")
  isRead           Boolean             @default(false) @map("is_read")
  readAt           DateTime?           @map("read_at")
  sentAt           DateTime?           @map("sent_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Message {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  senderId        String   @map("sender_id")
  receiverId      String   @map("receiver_id")
  subject         String?  @db.VarChar(255)
  content         String
  isEncrypted     Boolean  @default(true) @map("is_encrypted")
  isRead          Boolean  @default(false) @map("is_read")
  readAt          DateTime? @map("read_at")
  parentMessageId String?  @map("parent_message_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver      User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  parentMessage Message? @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies       Message[] @relation("MessageThread")

  @@map("messages")
}

model ShiftHandoverNote {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  fromNurseId     String            @map("from_nurse_id")
  toNurseId       String?           @map("to_nurse_id")
  wardId          String            @map("ward_id")
  shiftDate       DateTime          @map("shift_date") @db.Date
  shiftType       HandoverShiftType @map("shift_type")
  content         String
  patientStatuses Json?             @map("patient_statuses")
  outstandingTasks Json?            @map("outstanding_tasks")
  isAcknowledged  Boolean           @default(false) @map("is_acknowledged")
  acknowledgedAt  DateTime?         @map("acknowledged_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  fromNurse User   @relation("HandoverFrom", fields: [fromNurseId], references: [id])
  toNurse   User?  @relation("HandoverTo", fields: [toNurseId], references: [id])
  ward      Ward   @relation(fields: [wardId], references: [id])

  @@map("shift_handover_notes")
}

// ============================================================
// 18. TICKETS, FEEDBACK & COMPLIANCE
// ============================================================

model Ticket {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  ticketNumber     String       @unique @map("ticket_number") @db.VarChar(50)
  raisedBy         String       @map("raised_by")
  assignedTo       String?      @map("assigned_to")
  ticketType       TicketType   @map("ticket_type")
  subject          String       @db.VarChar(255)
  description      String?
  priority         Priority     @default(medium)
  status           TicketStatus @default(open)
  patientId        String?      @map("patient_id")
  departmentId     String?      @map("department_id")
  resolutionNotes  String?      @map("resolution_notes")
  resolvedAt       DateTime?    @map("resolved_at")
  escalatedTo      String?      @map("escalated_to")
  attachments      Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  raiser     User        @relation("TicketRaiser", fields: [raisedBy], references: [id])
  assignee   User?       @relation("TicketAssignee", fields: [assignedTo], references: [id])
  patient    Patient?    @relation(fields: [patientId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  escalator  User?       @relation("TicketEscalator", fields: [escalatedTo], references: [id])

  @@map("tickets")
}

model Feedback {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  submittedBy   String         @map("submitted_by")
  patientId     String?        @map("patient_id")
  feedbackType  FeedbackType   @map("feedback_type")
  subject       String?        @db.VarChar(255)
  content       String
  rating        Int?           @db.SmallInt
  doctorId      String?        @map("doctor_id")
  departmentId  String?        @map("department_id")
  status        FeedbackStatus @default(submitted)
  adminResponse String?        @map("admin_response")
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  submitter  User           @relation(fields: [submittedBy], references: [id])
  patient    Patient?       @relation(fields: [patientId], references: [id])
  doctor     DoctorProfile? @relation(fields: [doctorId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])

  @@map("feedback")
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  userId      String      @map("user_id")
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(100)
  entityId    String      @map("entity_id")
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent")
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

model ComplianceDocument {
  id           String                   @id @default(uuid())
  tenantId     String                   @map("tenant_id")
  documentType ComplianceDocumentType   @map("document_type")
  title        String                   @db.VarChar(255)
  description  String?
  fileUrl      String?                  @map("file_url")
  issuedDate   DateTime?                @map("issued_date") @db.Date
  expiryDate   DateTime?                @map("expiry_date") @db.Date
  status       ComplianceDocumentStatus @default(active)
  uploadedBy   String?                  @map("uploaded_by")
  createdAt    DateTime                 @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  uploader User?  @relation(fields: [uploadedBy], references: [id])

  @@map("compliance_documents")
}

model OtRequest {
  id                String          @id @default(uuid())
  tenantId          String          @map("tenant_id")
  patientId         String          @map("patient_id")
  visitId           String          @map("visit_id")
  doctorId          String          @map("doctor_id")
  otId              String?         @map("ot_id")
  procedureName     String          @map("procedure_name") @db.VarChar(255)
  procedureDetails  String?         @map("procedure_details")
  urgency           OtRequestUrgency @default(elective)
  preferredDate     DateTime?       @map("preferred_date") @db.Date
  preferredTime     DateTime?       @map("preferred_time") @db.Time()
  scheduledDate     DateTime?       @map("scheduled_date") @db.Date
  scheduledTime     DateTime?       @map("scheduled_time") @db.Time()
  durationMinutes   Int?            @map("duration_minutes")
  requiredEquipment Json?           @map("required_equipment")
  preOpChecklist    Json?           @map("pre_op_checklist")
  status            OtRequestStatus @default(requested)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  patient Patient           @relation(fields: [patientId], references: [id])
  visit   Visit             @relation(fields: [visitId], references: [id])
  doctor  DoctorProfile     @relation(fields: [doctorId], references: [id])
  ot      OperatingTheater? @relation(fields: [otId], references: [id])

  @@map("ot_requests")
}

model IncidentReport {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  reportedBy      String           @map("reported_by")
  patientId       String?          @map("patient_id")
  incidentType    IncidentType     @map("incident_type")
  description     String
  severity        IncidentSeverity?
  location        String?          @db.VarChar(255)
  occurredAt      DateTime?        @map("occurred_at")
  status          IncidentStatus   @default(reported)
  resolutionNotes String?          @map("resolution_notes")
  resolvedAt      DateTime?        @map("resolved_at")
  escalatedTo     String?          @map("escalated_to")
  createdAt       DateTime         @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  reporter  User     @relation("IncidentReporter", fields: [reportedBy], references: [id])
  patient   Patient? @relation(fields: [patientId], references: [id])
  escalator User?    @relation("IncidentEscalator", fields: [escalatedTo], references: [id])

  @@map("incident_reports")
}

// ============================================================
// 19. REPORTS & SUPER ADMIN
