  emergencyContacts       PatientEmergencyContact[]
  personalHistory         PatientPersonalHistory?
  familyHistory           PatientFamilyHistory[]
  allergies               PatientAllergy[]
  documents               PatientDocument[]
  consents                PatientConsent[]
  privacySettings         PatientPrivacySetting?
  abhaSyncLogs            AbhaSyncLog[]
  appointments            Appointment[]
  queueTokens             QueueToken[]
  visits                  Visit[]
  admissions              Admission[]
  patientTransfers        PatientTransfer[]
  vitals                  Vital[]
  diagnoses               Diagnosis[]
  progressNotes           ProgressNote[]
  nursingNotes            NursingNote[]
  ivLineRecords           IVLineRecord[]
  intakeOutputRecords     IntakeOutputRecord[]
  woundCareRecords        WoundCareRecord[]
  dischargeSummaries      DischargeSummary[]
  prescriptions           Prescription[]
  medicationAdministrations MedicationAdministration[]
  labOrders               LabOrder[]
  labResults              LabResult[]
  labReports              LabReport[]
  imagingRequests         ImagingRequest[]
  imagingResults          ImagingResult[]
  dispensingRecords       DispensingRecord[]
  drugReturns             DrugReturn[]
  bills                   Bill[]
  payments                Payment[]
  refunds                 Refund[]
  insurancePolicies       InsurancePolicy[]
  insuranceClaims         InsuranceClaim[]
  preAuthRequests         PreAuthorizationRequest[]
  crossMatchTests         CrossMatchTest[]
  transfusions            Transfusion[]
  tickets                 Ticket[]
  feedback                Feedback[]
  incidentReports         IncidentReport[]
  otRequests              OtRequest[]
  hospitalConnection      PatientHospitalConnection?
  mrdRequests             MrdRequest[]
  reservations            Reservation[]
  estimations             Estimation[]

  @@unique([tenantId, mrn])
  @@map("patients")
}

model PatientEmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  name         String   @db.VarChar(100)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  email        String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_emergency_contacts")
}

model PatientPersonalHistory {
  id                 String             @id @default(uuid())
  patientId          String             @unique @map("patient_id")
  appetite           String?
  diet               String?
  sleepPattern       String?            @map("sleep_pattern")
  disorders          String?
  exerciseHabits     String?            @map("exercise_habits")
  smokingStatus      SmokingStatus?     @map("smoking_status")
  alcoholConsumption AlcoholConsumption? @map("alcohol_consumption")
  notes              String?
  updatedBy          String?            @map("updated_by")
