  sequence                Int      @default(1)
  allocatedAmount         Decimal? @map("allocated_amount") @db.Decimal(12, 2)
  originalDocumentsHeld   Boolean  @default(false) @map("original_documents_held")
  deductionCertificateUrl String?  @map("deduction_certificate_url")
