// ============================================================
// 5. APPOINTMENTS & SCHEDULING
// ============================================================

model DoctorProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  tenantId         String   @map("tenant_id")
  departmentId     String   @map("department_id")
  specialization   String?  @db.VarChar(255)
  qualifications   String?
  licenseNumber    String?  @map("license_number") @db.VarChar(100)
  experienceYears  Int?     @map("experience_years")
  consultationFee  Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  // Days after a paid consultation with THIS doctor during which a return
  // visit carries no consultation fee. Per doctor, not per hospital: the window
  // that suits a surgeon reviewing a post-op wound is not the one for a
  // physician following a chronic case, and it is their fee being waived.
  // Null or 0 = no free follow-up (what every existing doctor keeps).
  freeFollowUpDays Int?     @map("free_follow_up_days")
  bio              String?
  isAvailable      Boolean  @default(true) @map("is_available")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user                     User                     @relation(fields: [userId], references: [id])
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  department               Department               @relation(fields: [departmentId], references: [id])
  schedules                DoctorSchedule[]
  scheduleOverrides        DoctorScheduleOverride[]
  leaves                   DoctorLeave[]
  appointments             Appointment[]
  queueTokens              QueueToken[]
  visits                   Visit[]
  admissions               Admission[]
  patientTransfersFrom     PatientTransfer[]        @relation("TransferFromDoctor")
  patientTransfersTo       PatientTransfer[]        @relation("TransferToDoctor")
  progressNotes            ProgressNote[]
  progressNoteTemplates    ProgressNoteTemplate[]
  dischargeSummaries       DischargeSummary[]
  prescriptions            Prescription[]
  otRequests               OtRequest[]
  otRequestsAsSurgeon      OtRequest[]              @relation("OtSurgeon")
  otRequestsAsAnaesthetist OtRequest[]              @relation("OtAnaesthetist")
  feedback                 Feedback[]
  reservations             Reservation[]
  estimations              Estimation[]
  admissionRequests        AdmissionRequest[]
  nurseAssignments         NurseDoctorAssignment[]

  @@map("doctor_profiles")
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  doctorId            String   @map("doctor_id")
  dayOfWeek           Int      @map("day_of_week") @db.SmallInt
  startTime           DateTime @map("start_time") @db.Time()
  endTime             DateTime @map("end_time") @db.Time()
  slotDurationMinutes Int      @default(15) @map("slot_duration_minutes")
  maxPatients         Int?     @map("max_patients")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@map("doctor_schedules")
}

model DoctorScheduleOverride {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  date      DateTime @db.Date
  isDayOff  Boolean  @default(false) @map("is_day_off")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  doctor DoctorProfile         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  shifts DoctorOverrideShift[]

  @@unique([doctorId, date])
  @@map("doctor_schedule_overrides")
}

model DoctorOverrideShift {
  id                  String   @id @default(uuid())
  overrideId          String   @map("override_id")
  startTime           DateTime @map("start_time") @db.Time()
  endTime             DateTime @map("end_time") @db.Time()
  slotDurationMinutes Int      @default(15) @map("slot_duration_minutes")
  maxPatients         Int?     @map("max_patients")

  override DoctorScheduleOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@map("doctor_override_shifts")
}

model DoctorLeave {
  id         String             @id @default(uuid())
  doctorId   String             @map("doctor_id")
  leaveDate  DateTime           @map("leave_date") @db.Date
  endDate    DateTime?          @map("end_date") @db.Date
  startTime  DateTime?          @map("start_time") @db.Time()
  endTime    DateTime?          @map("end_time") @db.Time()
  leaveType  LeaveType          @default(casual) @map("leave_type")
  status     LeaveRequestStatus @default(pending)
  reason     String?
  approvedBy String?            @map("approved_by")
  approvedAt DateTime?          @map("approved_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  doctor   DoctorProfile @relation(fields: [doctorId], references: [id])
  approver User?         @relation("DoctorLeaveApprover", fields: [approvedBy], references: [id])

  @@map("doctor_leaves")
}

model Appointment {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  patientId             String            @map("patient_id")
  doctorId              String            @map("doctor_id")
  appointmentDate       DateTime          @map("appointment_date") @db.Date
  startTime             DateTime          @map("start_time") @db.Time()
  endTime               DateTime?         @map("end_time") @db.Time()
  appointmentType       AppointmentType   @default(scheduled) @map("appointment_type")
  consultationType      String?           @map("consultation_type") @db.VarChar(30)
  priority              String?           @db.VarChar(20)
  visitType             VisitTypeAppt     @default(new) @map("visit_type")
  // Whether the front desk chose to add the hospital's one-time registration
  // fee to this appointment's bill. Null = the desk never said, so the rule
  // decides (charge it iff this is the patient's first visit HERE and it has
  // not been charged before). Accessed via raw SQL like `admission_type` —
  // the client is not regenerated for it.
  chargeRegistrationFee Boolean?          @map("charge_registration_fee")
  status                AppointmentStatus @default(booked)
  reason                String?
  notes                 String?
  bookedBy              String?           @map("booked_by")
  cancelledBy           String?           @map("cancelled_by")
  cancellationReason    String?           @map("cancellation_reason")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  patient         Patient                  @relation(fields: [patientId], references: [id])
  doctor          DoctorProfile            @relation(fields: [doctorId], references: [id])
  booker          User?                    @relation("AppointmentBooker", fields: [bookedBy], references: [id])
  canceller       User?                    @relation("AppointmentCanceller", fields: [cancelledBy], references: [id])
  queueTokens     QueueToken[]
  visits          Visit[]
  formSubmissions HospitalFormSubmission[]

  @@map("appointments")
}

model QueueToken {
  id                    String      @id @default(uuid())
  tenantId              String      @map("tenant_id")
  patientId             String      @map("patient_id")
  doctorId              String      @map("doctor_id")
  appointmentId         String?     @map("appointment_id")
  tokenNumber           String      @map("token_number") @db.VarChar(20)
  queueDate             DateTime    @map("queue_date") @db.Date
  status                QueueStatus @default(waiting)
  checkInTime           DateTime?   @map("check_in_time")
  consultationStartTime DateTime?   @map("consultation_start_time")
  consultationEndTime   DateTime?   @map("consultation_end_time")
  createdAt             DateTime    @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])

  @@map("queue_tokens")
}

// ============================================================
// 6. CLINICAL / VISITS & ADMISSIONS
// ============================================================

model Visit {
  id                      String      @id @default(uuid())
  tenantId                String      @map("tenant_id")
  patientId               String      @map("patient_id")
  // Nullable — a patient can be admitted (IP/Emergency/Day Care) before a
  // consultation doctor is assigned; the doctor is filled in later.
  doctorId                String?     @map("doctor_id")
  appointmentId           String?     @map("appointment_id")
  visitType               VisitType   @map("visit_type")
  visitDate               DateTime    @map("visit_date")
  chiefComplaint          String?     @map("chief_complaint")
  // What the NURSE was told at intake, kept apart from the doctor's own
  // framing above. One shared box meant whoever saved last replaced the other
  // and nothing recorded who said what — but the patient's words at the door
  // and the clinician's reading of the problem are different statements and
  // both are worth keeping.
  nurseChiefComplaint     String?     @map("nurse_chief_complaint")
  nurseChiefComplaintById String?     @map("nurse_chief_complaint_by")
  nurseChiefComplaintAt   DateTime?   @map("nurse_chief_complaint_at")
  status                  VisitStatus @default(active)
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id])
  patient              Patient                      @relation(fields: [patientId], references: [id])
  doctor               DoctorProfile?               @relation(fields: [doctorId], references: [id])
  appointment          Appointment?                 @relation(fields: [appointmentId], references: [id])
  admission            Admission?
  patientTransfers     PatientTransfer[]
  vitals               Vital[]
  diagnoses            Diagnosis[]
  progressNotes        ProgressNote[]
  nursingNotes         NursingNote[]
  ivLineRecords        IVLineRecord[]
  intakeOutputRecords  IntakeOutputRecord[]
  woundCareRecords     WoundCareRecord[]
  admissionAssessments NursingAdmissionAssessment[]
  painAssessments      PainAssessment[]
  fallRiskAssessments  FallRiskAssessment[]
  clinicalObservations ClinicalObservation[]
  clinicalDevices      ClinicalDevice[]
  clinicalDeviceChecks ClinicalDeviceCheck[]
  clinicalProcedures   ClinicalProcedure[]
  dischargeSummaries   DischargeSummary[]
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  imagingRequests      ImagingRequest[]
  bills                Bill[]
  transfusions         Transfusion[]
  otRequests           OtRequest[]
  admissionRequests    AdmissionRequest[]
  formSubmissions      HospitalFormSubmission[]
  insuranceCases       InsuranceCase[]

  @@map("visits")
}

model Admission {
  id                    String          @id @default(uuid())
  tenantId              String          @map("tenant_id")
  visitId               String          @unique @map("visit_id")
  patientId             String          @map("patient_id")
  // G6 (2.3): nullable so an Emergency/Casualty "pending-placement" admission can
  // be opened for a trauma patient before a doctor is assigned or a bed is
  // allocated. A normal admission always sets both; they are filled in later for
  // an ER admission when the patient is placed.
  doctorId              String?         @map("doctor_id")
  bedId                 String?         @map("bed_id")
  wardId                String?         @map("ward_id")
  admissionDate         DateTime        @map("admission_date")
  dischargeDate         DateTime?       @map("discharge_date")
  expectedDischargeDate DateTime?       @map("expected_discharge_date") @db.Date
  admissionReason       String?         @map("admission_reason")
  depositAmount         Decimal         @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  // G12: how this IP patient's charges are settled — drives the pharmacy's
  // "collect payment?" decision. cash | package | insurance | corporate.
  // Null is treated as 'cash'. Set by the front desk at admission.
  billingCategory       String?         @map("billing_category") @db.VarChar(20)
  // Admission care type — ip | emergency | daycare. All three share the same IP
  // flow; this is just a tag + filter dimension. Null is treated as 'ip'. Access
  // is via raw SQL until the Prisma client is regenerated (dev server locks it).
  admissionType         String?         @map("admission_type") @db.VarChar(20)
  status                AdmissionStatus @default(admitted)
  admittedBy            String?         @map("admitted_by")
  dischargedBy          String?         @map("discharged_by")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant                       @relation(fields: [tenantId], references: [id])
  visit                Visit                        @relation(fields: [visitId], references: [id])
  patient              Patient                      @relation(fields: [patientId], references: [id])
  doctor               DoctorProfile?               @relation(fields: [doctorId], references: [id])
  bed                  Bed?                         @relation(fields: [bedId], references: [id])
  ward                 Ward?                        @relation(fields: [wardId], references: [id])
  admitter             User?                        @relation("Admitter", fields: [admittedBy], references: [id])
  discharger           User?                        @relation("Discharger", fields: [dischargedBy], references: [id])
  dischargeSummary     DischargeSummary?
  ivLineRecords        IVLineRecord[]
  nursingNotes         NursingNote[]
  progressNotes        ProgressNote[]
  nurseAssignments     NurseAssignment[]
  admissionAssessments NursingAdmissionAssessment[]
  painAssessments      PainAssessment[]
  fallRiskAssessments  FallRiskAssessment[]
  clinicalObservations ClinicalObservation[]
  clinicalDevices      ClinicalDevice[]
  clinicalProcedures   ClinicalProcedure[]
  bills                Bill[]
  emarSchedules        EmarSchedule[]
  formSubmissions      HospitalFormSubmission[]
  insuranceCases       InsuranceCase[]

  @@map("admissions")
}

model PatientTransfer {
  id           String         @id @default(uuid())
  tenantId     String         @map("tenant_id")
  patientId    String         @map("patient_id")
  visitId      String         @map("visit_id")
  transferType TransferType   @map("transfer_type")
  fromDoctorId String?        @map("from_doctor_id")
  toDoctorId   String?        @map("to_doctor_id")
  fromBedId    String?        @map("from_bed_id")
  toBedId      String?        @map("to_bed_id")
  fromWardId   String?        @map("from_ward_id")
  toWardId     String?        @map("to_ward_id")
  reason       String?
  requestedBy  String?        @map("requested_by")
  approvedBy   String?        @map("approved_by")
  status       TransferStatus @default(requested)
  createdAt    DateTime       @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  patient    Patient        @relation(fields: [patientId], references: [id])
  visit      Visit          @relation(fields: [visitId], references: [id])
  fromDoctor DoctorProfile? @relation("TransferFromDoctor", fields: [fromDoctorId], references: [id])
  toDoctor   DoctorProfile? @relation("TransferToDoctor", fields: [toDoctorId], references: [id])
  fromBed    Bed?           @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBed      Bed?           @relation("TransferToBed", fields: [toBedId], references: [id])
  fromWard   Ward?          @relation("TransferFromWard", fields: [fromWardId], references: [id])
  toWard     Ward?          @relation("TransferToWard", fields: [toWardId], references: [id])
  requester  User?          @relation("TransferRequester", fields: [requestedBy], references: [id])
  approver   User?          @relation("TransferApprover", fields: [approvedBy], references: [id])

  @@map("patient_transfers")
}

// ============================================================
// 6b. RESERVATIONS & ESTIMATIONS
// ============================================================

model Reservation {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  patientId         String            @map("patient_id")
  doctorId          String            @map("doctor_id")
  wardId            String            @map("ward_id")
  bedId             String?           @map("bed_id")
  reservedDate      DateTime          @map("reserved_date")
  expectedAdmission DateTime?         @map("expected_admission")
  diagnosis         String?
  speciality        String?           @db.VarChar(100)
  advanceAmount     Decimal           @default(0) @map("advance_amount") @db.Decimal(12, 2)
  notes             String?
  status            ReservationStatus @default(reserved)
  admissionId       String?           @unique @map("admission_id")
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id])
  ward    Ward          @relation(fields: [wardId], references: [id])
  bed     Bed?          @relation(fields: [bedId], references: [id])
  creator User?         @relation("ReservationCreator", fields: [createdBy], references: [id])

  @@map("reservations")
}

model Estimation {
  id                   String           @id @default(uuid())
  tenantId             String           @map("tenant_id")
  patientId            String           @map("patient_id")
  doctorId             String           @map("doctor_id")
  complaints           String?
  estimationPeriodDays Int              @default(1) @map("estimation_period_days")
  totalEstimateAmount  Decimal          @default(0) @map("total_estimate_amount") @db.Decimal(12, 2)
  items                Json?            @default("[]")
  notes                String?
  status               EstimationStatus @default(draft)
  admissionId          String?          @map("admission_id")
  createdBy            String?          @map("created_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id])
  creator User?         @relation("EstimationCreator", fields: [createdBy], references: [id])

  @@map("estimations")
}

// Doctor-raised request to admit an OP patient. The front desk works the
// pending queue from the IP Home page and either accepts (optionally creating
// a Reservation when ward/bed are known) or rejects. Linking to Visit is
// optional — emergency walk-ins can be requested before any visit exists.
model AdmissionRequest {
  id                    String                  @id @default(uuid())
  tenantId              String                  @map("tenant_id")
  patientId             String                  @map("patient_id")
  visitId               String?                 @map("visit_id")
  doctorId              String                  @map("doctor_id")
  reason                String                  @db.VarChar(500)
  provisionalDiagnosis  String?                 @map("provisional_diagnosis") @db.VarChar(1000)
  urgency               AdmissionRequestUrgency @default(routine)
  preferredWardType     String?                 @map("preferred_ward_type") @db.VarChar(100)
  expectedAdmissionDate DateTime?               @map("expected_admission_date") @db.Date
  notes                 String?
  status                AdmissionRequestStatus  @default(pending)
  reservationId         String?                 @map("reservation_id")
  admissionId           String?                 @map("admission_id")
  rejectionReason       String?                 @map("rejection_reason")
  requestedById         String?                 @map("requested_by_id")
  processedById         String?                 @map("processed_by_id")
  processedAt           DateTime?               @map("processed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  visit       Visit?        @relation(fields: [visitId], references: [id])
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  requestedBy User?         @relation("AdmissionRequestRequester", fields: [requestedById], references: [id])
  processedBy User?         @relation("AdmissionRequestProcessor", fields: [processedById], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("admission_requests")
}

model Vital {
  id                     String   @id @default(uuid())
  visitId                String   @map("visit_id")
  patientId              String   @map("patient_id")
  bloodPressureSystolic  Int?     @map("blood_pressure_systolic")
  bloodPressureDiastolic Int?     @map("blood_pressure_diastolic")
  pulseRate              Int?     @map("pulse_rate")
  temperature            Decimal? @db.Decimal(4, 1)
  respiratoryRate        Int?     @map("respiratory_rate")
  oxygenSaturation       Decimal? @map("oxygen_saturation") @db.Decimal(4, 1)
  weightKg               Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm               Decimal? @map("height_cm") @db.Decimal(5, 1)
  bmi                    Decimal? @db.Decimal(4, 1)
  bloodSugar             Decimal? @map("blood_sugar") @db.Decimal(6, 2)
  notes                  String?
  recordedBy             String?  @map("recorded_by")
  recordedAt             DateTime @default(now()) @map("recorded_at")

  // Append-only correction chain. When a doctor (or an out-of-grace-window nurse)
  // corrects a vital, insert a new row with supersedesVitalId pointing to the
  // original. The canonical latest reading is the row whose id is NOT referenced
  // by another row's supersedesVitalId — in practice query with
  // `WHERE id NOT IN (SELECT supersedes_vital_id FROM vitals WHERE supersedes_vital_id IS NOT NULL)`.
  supersedesVitalId String? @map("supersedes_vital_id")
  correctionReason  String? @map("correction_reason")
  correctedById     String? @map("corrected_by_id")
  isCorrection      Boolean @default(false) @map("is_correction")

  visit       Visit   @relation(fields: [visitId], references: [id])
  patient     Patient @relation(fields: [patientId], references: [id])
  recorder    User?   @relation(fields: [recordedBy], references: [id])
  supersedes  Vital?  @relation("VitalCorrection", fields: [supersedesVitalId], references: [id])
  correctedBy Vital[] @relation("VitalCorrection")
  corrector   User?   @relation("VitalCorrector", fields: [correctedById], references: [id])

  @@index([visitId, recordedAt])
  @@index([supersedesVitalId])
  @@map("vitals")
}

model Diagnosis {
  id            String        @id @default(uuid())
  visitId       String        @map("visit_id")
  patientId     String        @map("patient_id")
  icdCode       String?       @map("icd_code") @db.VarChar(20)
  diagnosisName String        @map("diagnosis_name") @db.VarChar(500)
  diagnosisType DiagnosisType @default(primary) @map("diagnosis_type")
  notes         String?
  diagnosedBy   String?       @map("diagnosed_by")
  diagnosedAt   DateTime      @default(now()) @map("diagnosed_at")

  visit     Visit   @relation(fields: [visitId], references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  diagnoser User?   @relation(fields: [diagnosedBy], references: [id])

  @@map("diagnoses")
}

// ============================================================
// 7. NOTES & DISCHARGE
// ============================================================

model ProgressNote {
  id                    String             @id @default(uuid())
  visitId               String             @map("visit_id")
  admissionId           String?            @map("admission_id")
  patientId             String             @map("patient_id")
  doctorId              String             @map("doctor_id")
  // Optional link to a prescription. When set, the note rides along with that
  // prescription so anyone who can view the prescription also sees this note.
  prescriptionId        String?            @map("prescription_id")
  noteType              ProgressNoteType?  @map("note_type")
  content               String
  impressions           String?
  discussions           String?
  conclusions           String?
  // Structured SOAP payloads — each is a typed JSON blob matching
  // the shape enforced by progress-notes.validation.ts. Free text still
  // allowed in `content` for the 20% flex; SOAP carries the 80% guided part.
  subjective            Json?
  objective             Json?
  assessment            Json?
  plan                  Json?
  customFields          Json?              @map("custom_fields")
  weightKgAtEntry       Decimal?           @map("weight_kg_at_entry") @db.Decimal(5, 2)
  // How the patient is doing, as the doctor judges it on this round. Lets a
  // routine ward round be recorded as "prescription written, patient stable"
  // without prose, and gives the timeline and discharge summary a trend to
  // read. Same vocabulary nursing already uses on ClinicalObservation, so the
  // two sides of the chart describe a patient the same way.
  generalCondition      GeneralCondition?  @map("general_condition")
  pinToDischargeSummary Boolean            @default(false) @map("pin_to_discharge_summary")
  isAutoFilled          Boolean            @default(false) @map("is_auto_filled")
  status                ProgressNoteStatus @default(active)
  archivedAt            DateTime?          @map("archived_at")
  archiveReason         String?            @map("archive_reason") @db.VarChar(50)
  signedAt              DateTime?          @map("signed_at")
  signedById            String?            @map("signed_by_id")
  lockedAt              DateTime?          @map("locked_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")

  visit        Visit                   @relation(fields: [visitId], references: [id])
  admission    Admission?              @relation(fields: [admissionId], references: [id])
  patient      Patient                 @relation(fields: [patientId], references: [id])
  doctor       DoctorProfile           @relation(fields: [doctorId], references: [id])
  prescription Prescription?           @relation(fields: [prescriptionId], references: [id])
  signer       User?                   @relation("ProgressNoteSigner", fields: [signedById], references: [id])
  amendments   ProgressNoteAmendment[]
  pins         ProgressNotePin[]

  @@index([status, createdAt])
  @@index([admissionId, createdAt])
  @@index([prescriptionId])
  @@map("progress_notes")
}

model ProgressNoteTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  doctorId  String   @map("doctor_id")
  name      String   @db.VarChar(120)
  fields    Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  doctor DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId, isDefault])
  @@map("progress_note_templates")
}

// Append-only audit trail for every field change on a progress note.
// Reason is required when editing a signed/locked note; for in-window
// edits (still active) it's optional but we still record the diff.
model ProgressNoteAmendment {
  id            String   @id @default(uuid())
  noteId        String   @map("note_id")
  editorId      String   @map("editor_id")
  fieldName     String   @map("field_name") @db.VarChar(80)
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  note   ProgressNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editor User         @relation("ProgressNoteAmendmentEditor", fields: [editorId], references: [id])

  @@index([noteId, createdAt])
  @@map("progress_note_amendments")
}

// Per-section discharge pin — replaces the single boolean pinToDischargeSummary.
// The boolean remains for backward compat; new UI creates one row per pinned
// section so that the auto-built summary can slot content into the right place.
model ProgressNotePin {
  id               String           @id @default(uuid())
  noteId           String           @map("note_id")
  dischargeSection DischargeSection @map("discharge_section")
  content          String
  createdAt        DateTime         @default(now()) @map("created_at")

  note ProgressNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("progress_note_pins")
}

// Master catalog of physical examination findings used as the SOAP
// "Physical Observations" dropdown. A null tenantId means it's a
// global (Sedawk-seeded) entry; tenant-scoped rows let hospitals add
// their own without polluting the global list.
model PhysicalObservationCatalog {
  id          String                    @id @default(uuid())
  tenantId    String?                   @map("tenant_id")
  system      PhysicalObservationSystem
  name        String                    @db.VarChar(200)
  description String?
  isGlobal    Boolean                   @default(false) @map("is_global")
  isActive    Boolean                   @default(true) @map("is_active")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, system, isActive])
  @@map("physical_observation_catalog")
}

model NursingNote {
  id          String           @id @default(uuid())
  visitId     String?          @map("visit_id")
  patientId   String           @map("patient_id")
  nurseId     String           @map("nurse_id")
  admissionId String?          @map("admission_id")
  noteType    NursingNoteType? @map("note_type")
  content     String
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")

  visit     Visit?     @relation(fields: [visitId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  nurse     User       @relation(fields: [nurseId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])

  @@map("nursing_notes")
}

model IVLineRecord {
  id                           String           @id @default(uuid())
  visitId                      String           @map("visit_id")
  patientId                    String           @map("patient_id")
  admissionId                  String?          @map("admission_id")
  lineType                     IVLineType       @map("line_type")
  catheterGauge                String?          @map("catheter_gauge") @db.VarChar(10)
  insertionSite                String           @map("insertion_site") @db.VarChar(100)
  insertedAt                   DateTime         @map("inserted_at")
  insertedBy                   String           @map("inserted_by")
  removedAt                    DateTime?        @map("removed_at")
  removedBy                    String?          @map("removed_by")
  removalReason                IVRemovalReason? @map("removal_reason")
  dressingChangeFrequencyHours Int              @default(72) @map("dressing_change_frequency_hours")
  lastDressingChangeAt         DateTime?        @map("last_dressing_change_at")
  lastFlushedAt                DateTime?        @map("last_flushed_at")
  fluidType                    String?          @map("fluid_type") @db.VarChar(100)
  flowRateMlPerHr              Int?             @map("flow_rate_ml_per_hr")
  status                       IVLineStatus     @default(active)
  complications                String?
  notes                        String?
  createdAt                    DateTime         @default(now()) @map("created_at")
  updatedAt                    DateTime         @default(now()) @updatedAt @map("updated_at")

  visit               Visit                @relation(fields: [visitId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  admission           Admission?           @relation(fields: [admissionId], references: [id])
  inserter            User                 @relation("IVInserter", fields: [insertedBy], references: [id])
  remover             User?                @relation("IVRemover", fields: [removedBy], references: [id])
  intakeOutputRecords IntakeOutputRecord[]

  @@map("iv_line_records")
}

model IntakeOutputRecord {
  id               String      @id @default(uuid())
  visitId          String      @map("visit_id")
  patientId        String      @map("patient_id")
  nurseId          String      @map("nurse_id")
  recordDatetime   DateTime    @map("record_datetime")
  entryType        IOEntryType @map("entry_type")
  category         IOCategory
  volumeMl         Int         @map("volume_ml")
  fluidDescription String?     @map("fluid_description") @db.VarChar(255)
  ivLineId         String?     @map("iv_line_id")
  // Free-text subtype (drain type, route, etc.) and per-source extras
  subType          String?     @map("sub_type") @db.VarChar(100)
  color            String?     @db.VarChar(50)
  frequencyCount   Int?        @map("frequency_count")
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")

  visit   Visit         @relation(fields: [visitId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])
  nurse   User          @relation(fields: [nurseId], references: [id])
  ivLine  IVLineRecord? @relation(fields: [ivLineId], references: [id])

  @@map("intake_output_records")
}

model WoundCareRecord {
  id                String         @id @default(uuid())
  visitId           String         @map("visit_id")
  patientId         String         @map("patient_id")
  nurseId           String         @map("nurse_id")
  woundLocation     String         @map("wound_location") @db.VarChar(100)
  woundType         WoundType?     @map("wound_type")
  woundStage        WoundStage?    @map("wound_stage")
  lengthCm          Decimal?       @map("length_cm") @db.Decimal(5, 2)
  widthCm           Decimal?       @map("width_cm") @db.Decimal(5, 2)
  depthCm           Decimal?       @map("depth_cm") @db.Decimal(5, 2)
  exudateType       ExudateType?   @map("exudate_type")
  exudateAmount     ExudateAmount? @map("exudate_amount")
  dressingApplied   String?        @map("dressing_applied") @db.VarChar(255)
  treatmentNotes    String?        @map("treatment_notes")
  photoUrl          String?        @map("photo_url")
  assessedAt        DateTime       @map("assessed_at")
  nextAssessmentDue DateTime?      @map("next_assessment_due")
  status            WoundStatus    @default(active)
  createdAt         DateTime       @default(now()) @map("created_at")

  visit   Visit   @relation(fields: [visitId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  nurse   User    @relation(fields: [nurseId], references: [id])

  @@map("wound_care_records")
}

// Nursing admission intake. One per admission/visit; capture on the
// patient's first contact with the ward. Free-text fields stay short
// — anything more clinical lives in NursingNote.
model NursingAdmissionAssessment {
  id                 String              @id @default(uuid())
  visitId            String              @map("visit_id")
  admissionId        String?             @map("admission_id")
  patientId          String              @map("patient_id")
  nurseId            String              @map("nurse_id")
  arrivalMode        ArrivalMode?        @map("arrival_mode")
  consciousnessLevel ConsciousnessLevel? @map("consciousness_level")
  chiefComplaint     String?             @map("chief_complaint")
  allergies          String?
  currentMedications String?             @map("current_medications")
  skinCondition      String?             @map("skin_condition")
  mobility           String?
  nutritionStatus    String?             @map("nutrition_status")
  elimination        String?
  preferredLanguage  String?             @map("preferred_language")
  religiousNeeds     String?             @map("religious_needs")
  nextOfKin          Json?               @map("next_of_kin")
  notes              String?
  assessedAt         DateTime            @default(now()) @map("assessed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  visit     Visit      @relation(fields: [visitId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  nurse     User       @relation(fields: [nurseId], references: [id])

  @@index([patientId, assessedAt])
  @@index([admissionId])
  @@map("nursing_admission_assessments")
}

// Pain reassessments are frequent; expect many rows per admission.
// `painScore` is a 0–10 numeric on whichever scale was used (FLACC
// is also 0–10 by design, so a single column stays fine).
model PainAssessment {
  id                 String    @id @default(uuid())
  visitId            String    @map("visit_id")
  admissionId        String?   @map("admission_id")
  patientId          String    @map("patient_id")
  nurseId            String    @map("nurse_id")
  painScore          Int       @map("pain_score")
  painScale          PainScale @default(numeric) @map("pain_scale")
  painLocation       String?   @map("pain_location") @db.VarChar(255)
  painCharacter      String?   @map("pain_character") @db.VarChar(255)
  painOnsetAt        DateTime? @map("pain_onset_at")
  aggravatingFactors String?   @map("aggravating_factors")
  relievingFactors   String?   @map("relieving_factors")
  intervention       String?
  reassessmentDueAt  DateTime? @map("reassessment_due_at")
  notes              String?
  assessedAt         DateTime  @default(now()) @map("assessed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  visit     Visit      @relation(fields: [visitId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  nurse     User       @relation(fields: [nurseId], references: [id])

  @@index([patientId, assessedAt])
  @@index([admissionId])
  @@map("pain_assessments")
}

// Morse Fall Scale. Subscores carry the weights from the published
// scale (history 0/25, secondary 0/15, aid 0/15/30, IV 0/20, gait
// 0/10/20, mental 0/15). Total + risk band are computed server-side
// and stored so reports can group without re-deriving.
model FallRiskAssessment {
  id                 String        @id @default(uuid())
  visitId            String        @map("visit_id")
  admissionId        String?       @map("admission_id")
  patientId          String        @map("patient_id")
  nurseId            String        @map("nurse_id")
  historyOfFalling   Int           @default(0) @map("history_of_falling")
  secondaryDiagnosis Int           @default(0) @map("secondary_diagnosis")
  ambulatoryAid      Int           @default(0) @map("ambulatory_aid")
  ivOrSalineLock     Int           @default(0) @map("iv_or_saline_lock")
  gait               Int           @default(0)
  mentalStatus       Int           @default(0) @map("mental_status")
  totalScore         Int           @map("total_score")
  riskLevel          FallRiskLevel @map("risk_level")
  intervention       String?
  notes              String?
  assessedAt         DateTime      @default(now()) @map("assessed_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  visit     Visit      @relation(fields: [visitId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  nurse     User       @relation(fields: [nurseId], references: [id])

  @@index([patientId, assessedAt])
  @@index([admissionId])
  @@map("fall_risk_assessments")
}

// ── Clinical Charting models ─────────────────────────────
//
// Multi-section bedside note. One row per "rounds" snapshot — pain,
// AVPU, mobility, condition, oral intake/output and free-text notes.
// Fluid intake/urine output kept here are the *bedside snapshot*; the
// authoritative running tally lives in IntakeOutputRecord.
model ClinicalObservation {
  id                String            @id @default(uuid())
  visitId           String            @map("visit_id")
  admissionId       String?           @map("admission_id")
  patientId         String            @map("patient_id")
  nurseId           String            @map("nurse_id")
  observedAt        DateTime          @default(now()) @map("observed_at")
  painScore         Int?              @map("pain_score")
  painLocation      String?           @map("pain_location") @db.VarChar(255)
  consciousnessAvpu AvpuLevel?        @map("consciousness_avpu")
  generalCondition  GeneralCondition? @map("general_condition")
  mobility          MobilityLevel?
  fluidIntakeMl     Int?              @map("fluid_intake_ml")
  foodIntakeNotes   String?           @map("food_intake_notes")
  urineOutputMl     Int?              @map("urine_output_ml")
  stoolPassed       Boolean?          @map("stool_passed")
  stoolCount        Int?              @map("stool_count")
  notes             String?
  metadata          Json?
  createdAt         DateTime          @default(now()) @map("created_at")

  visit     Visit      @relation(fields: [visitId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  nurse     User       @relation(fields: [nurseId], references: [id])

  @@index([patientId, observedAt])
  @@index([admissionId])
  @@map("clinical_observations")
}

// Ongoing device/line state. Lifecycle = inserted → checked* → removed.
// Repeated checks live in ClinicalDeviceCheck so the device row
// captures *current* status without rewriting history.
model ClinicalDevice {
  id                   String               @id @default(uuid())
  visitId              String               @map("visit_id")
  admissionId          String?              @map("admission_id")
  patientId            String               @map("patient_id")
  deviceType           ClinicalDeviceType   @map("device_type")
  deviceSubtype        String?              @map("device_subtype") @db.VarChar(100)
  site                 String               @db.VarChar(100)
  insertionTime        DateTime             @map("insertion_time")
  insertedBy           String               @map("inserted_by")
  removalTime          DateTime?            @map("removal_time")
  removedBy            String?              @map("removed_by")
  status               ClinicalDeviceStatus @default(active)
  flowStatus           DeviceFlowStatus?    @map("flow_status")
  fluidType            String?              @map("fluid_type") @db.VarChar(100)
  flowRateMlPerHr      Int?                 @map("flow_rate_ml_per_hr")
  oxygenMode           OxygenMode?          @map("oxygen_mode")
  oxygenFlowRate       Decimal?             @map("oxygen_flow_rate") @db.Decimal(5, 2)
  createdByProcedureId String?              @map("created_by_procedure_id")
  notes                String?
  metadata             Json?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at")

  visit              Visit                 @relation(fields: [visitId], references: [id])
  admission          Admission?            @relation(fields: [admissionId], references: [id])
  patient            Patient               @relation(fields: [patientId], references: [id])
  inserter           User                  @relation("DeviceInserter", fields: [insertedBy], references: [id])
  remover            User?                 @relation("DeviceRemover", fields: [removedBy], references: [id])
  createdByProcedure ClinicalProcedure?    @relation(fields: [createdByProcedureId], references: [id])
  checks             ClinicalDeviceCheck[]

  @@index([patientId, status])
  @@index([visitId, status])
  @@index([admissionId])
  @@map("clinical_devices")
}

// Periodic monitoring against a ClinicalDevice. One row per check —
// gives a timeline of patency / site / complications.
model ClinicalDeviceCheck {
  id                 String               @id @default(uuid())
  deviceId           String               @map("device_id")
  visitId            String               @map("visit_id")
  patientId          String               @map("patient_id")
  nurseId            String               @map("nurse_id")
  checkedAt          DateTime             @default(now()) @map("checked_at")
  patency            DevicePatency?
  siteCondition      DeviceSiteCondition? @map("site_condition")
  painPresent        Boolean?             @map("pain_present")
  securement         DeviceSecurement?
  flowStatus         DeviceFlowStatus?    @map("flow_status")
  urineFlow          UrineFlow?           @map("urine_flow")
  urineColor         UrineColor?          @map("urine_color")
  infectionSuspected Boolean?             @map("infection_suspected")
  dislodged          Boolean?
  blocked            Boolean?
  remarks            String?
  metadata           Json?
  createdAt          DateTime             @default(now()) @map("created_at")

  device  ClinicalDevice @relation(fields: [deviceId], references: [id])
  visit   Visit          @relation(fields: [visitId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  nurse   User           @relation(fields: [nurseId], references: [id])

  @@index([deviceId, checkedAt])
  @@index([patientId, checkedAt])
  @@map("clinical_device_checks")
}

// One-time clinical action (e.g. IV insertion, catheterisation,
// suctioning, dressing change). When the action creates an ongoing
// item (IV cannula, drain) the resulting ClinicalDevice points back
// here via `createdByProcedureId`.
model ClinicalProcedure {
  id                String                 @id @default(uuid())
  visitId           String                 @map("visit_id")
  admissionId       String?                @map("admission_id")
  patientId         String                 @map("patient_id")
  nurseId           String                 @map("nurse_id")
  procedureType     String                 @map("procedure_type") @db.VarChar(100)
  procedureSubtype  String?                @map("procedure_subtype") @db.VarChar(100)
  performedAt       DateTime               @map("performed_at")
  site              String?                @db.VarChar(100)
  side              ProcedureSide?
  status            ProcedureStatus        @default(successful)
  attemptCount      Int?                   @map("attempt_count")
  asepticTechnique  Boolean?               @map("aseptic_technique")
  equipmentUsed     String?                @map("equipment_used") @db.VarChar(255)
  complications     ProcedureComplication?
  complicationNotes String?                @map("complication_notes")
  tolerance         ProcedureTolerance?
  painScore         Int?                   @map("pain_score")
  deviceCreated     Boolean                @default(false) @map("device_created")
  notes             String?
  metadata          Json?
  createdAt         DateTime               @default(now()) @map("created_at")

  visit     Visit            @relation(fields: [visitId], references: [id])
  admission Admission?       @relation(fields: [admissionId], references: [id])
  patient   Patient          @relation(fields: [patientId], references: [id])
  nurse     User             @relation(fields: [nurseId], references: [id])
  devices   ClinicalDevice[]

  @@index([patientId, performedAt])
  @@index([admissionId])
  @@map("clinical_procedures")
}

model DischargeSummary {
  id                       String                 @id @default(uuid())
  admissionId              String                 @unique @map("admission_id")
  visitId                  String                 @map("visit_id")
  patientId                String                 @map("patient_id")
  doctorId                 String                 @map("doctor_id")
  admissionDate            DateTime?              @map("admission_date")
  dischargeDate            DateTime?              @map("discharge_date")
  headerSummary            String?                @map("header_summary")
  diagnosesSummary         String?                @map("diagnoses_summary")
  proceduresSummary        String?                @map("procedures_summary")
  labResultsSummary        String?                @map("lab_results_summary")
  keyLabsSummary           String?                @map("key_labs_summary")
  medicationReconciliation String?                @map("medication_reconciliation")
  dischargeInstructions    String?                @map("discharge_instructions")
  followUpDate             DateTime?              @map("follow_up_date") @db.Date
  // "Come back in about three months" — an interval with no fixed day, which
  // is what a discharging doctor usually means. Resolving it to a calendar date
  // at the moment of signing invents a precision nobody intended, and the
  // patient then reads a specific day as an appointment they have missed.
  // Held ALONGSIDE followUpDate, not instead of it: a review that genuinely is
  // on the 14th should still say the 14th.
  followUpAfterValue       Int?                   @map("follow_up_after_value")
  followUpAfterUnit        String?                @map("follow_up_after_unit") @db.VarChar(10)
  followUpInstructions     String?                @map("follow_up_instructions")
  status                   DischargeSummaryStatus @default(draft)
  signedBy                 String?                @map("signed_by")
  signedAt                 DateTime?              @map("signed_at")
  eSignatureUrl            String?                @map("e_signature_url")
  pdfUrl                   String?                @map("pdf_url")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @default(now()) @updatedAt @map("updated_at")

  admission Admission     @relation(fields: [admissionId], references: [id])
  visit     Visit         @relation(fields: [visitId], references: [id])
  patient   Patient       @relation(fields: [patientId], references: [id])
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  signer    User?         @relation(fields: [signedBy], references: [id])

  @@map("discharge_summaries")
}

// ============================================================
// 8. PRESCRIPTIONS & MEDICATIONS
// ============================================================

model Prescription {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  visitId          String             @map("visit_id")
  patientId        String             @map("patient_id")
  doctorId         String             @map("doctor_id")
  prescriptionType PrescriptionType   @map("prescription_type")
  status           PrescriptionStatus @default(active)
  // G12: ward→pharmacy fulfilment lifecycle, independent of the clinical
  // dispensing status. ordered | preparing | ready | collected (null = ordered).
  pharmacyStatus   String?            @map("pharmacy_status") @db.VarChar(20)
  notes            String?
  followUpDate     DateTime?          @map("follow_up_date") @db.Date
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  visit             Visit              @relation(fields: [visitId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])
  prescriptionItems PrescriptionItem[]
  dispensingRecords DispensingRecord[]
  emarSchedules     EmarSchedule[]
  progressNotes     ProgressNote[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String          @id @default(uuid())
  prescriptionId String          @map("prescription_id")
  drugId         String?         @map("drug_id")
  drugName       String          @map("drug_name") @db.VarChar(255)
  dosage         String          @db.VarChar(100)
  frequency      String          @db.VarChar(100)
  duration       String?         @db.VarChar(100)
  route          MedicationRoute @default(oral)
  instructions   String?
  // Per-intake dose multiplier (units taken each occasion, default 1). Combined
  // with frequency + duration to derive `quantity` — e.g. 1-1-1 × 3 days × dose
  // 2 = 18. Stored so the pharmacy and any re-compute path agree with the pad.
  doseQuantity   Decimal?        @default(1) @map("dose_quantity") @db.Decimal(6, 2)
  quantity       Int?
  isPrn          Boolean         @default(false) @map("is_prn")
  createdAt      DateTime        @default(now()) @map("created_at")

  prescription              Prescription               @relation(fields: [prescriptionId], references: [id])
  drug                      DrugFormulary?             @relation(fields: [drugId], references: [id])
  medicationAdministrations MedicationAdministration[]
  dispensingRecords         DispensingRecord[]
  emarSchedules             EmarSchedule[]

  @@map("prescription_items")
}

model MedicationAdministration {
  id                 String         @id @default(uuid())
  prescriptionItemId String         @map("prescription_item_id")
  patientId          String         @map("patient_id")
  administeredBy     String         @map("administered_by")
  administeredAt     DateTime       @map("administered_at")
  doseGiven          String?        @map("dose_given") @db.VarChar(100)
  status             MedAdminStatus
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")

  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  administrator    User             @relation(fields: [administeredBy], references: [id])

  @@map("medication_administrations")
}

// ============================================================
// 8b. eMAR — DOSE-LEVEL EXECUTION
// ============================================================
// The eMAR module converts physician prescriptions into time-based
// executable dose tasks, one row per dose. This is a separate
// purpose-built layer over PrescriptionItem; it does NOT replace
// MedicationAdministration (which stays as the legacy/ad-hoc admin log).

enum EmarFrequencyType {
  slot     @map("slot")
  interval @map("interval")
  once     @map("once")
  prn      @map("prn")
}

enum EmarDoseStatus {
  pending    @map("pending")
  due        @map("due")
  overdue    @map("overdue")
  given      @map("given")
  given_late @map("given_late")
  missed     @map("missed")
  held       @map("held")
  refused    @map("refused")
  cancelled  @map("cancelled")
}

enum EmarAuditAction {
  generated @map("generated")
  given     @map("given")
  late      @map("late")
  missed    @map("missed")
  held      @map("held")
  refused   @map("refused")
  amended   @map("amended")
  cancelled @map("cancelled")
  prn       @map("prn")
  status    @map("status")
}

/// Per-tenant configurable time slots that map slot codes (MORNING,
/// AFTERNOON, NIGHT, ...) to actual times of day. Defaults are seeded
/// per tenant and can be edited by nurse_admin.
model EmarTimeSlot {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String   @db.VarChar(40) // MORNING, AFTERNOON, NIGHT, etc.
  label     String   @db.VarChar(80)
  time      String   @db.VarChar(5) // "HH:mm"
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("emar_time_slots")
}

/// Per-tenant frequency master mapping codes (BD, TID, Q6H, ...) to
/// either a list of slot codes (slot-based) or an interval in hours.
model EmarFrequency {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  code                  String            @db.VarChar(40) // BD, TID, Q6H, OD, STAT, PRN
  label                 String            @db.VarChar(120)
  type                  EmarFrequencyType
  slotCodes             String[]          @default([]) @map("slot_codes") // for slot type: ["MORNING","NIGHT"]
  intervalHours         Int?              @map("interval_hours") // for interval type: 6
  minPrnIntervalMinutes Int?              @map("min_prn_interval_minutes") // for prn type
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("emar_frequencies")
}

/// Per-tenant eMAR settings (grace period etc).
model EmarSettings {
  id                           String   @id @default(uuid())
  tenantId                     String   @unique @map("tenant_id")
  gracePeriodMinutes           Int      @default(120) @map("grace_period_minutes")
  defaultPrnMinIntervalMinutes Int      @default(240) @map("default_prn_min_interval_minutes")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("emar_settings")
}

/// Core execution table — one row per individual dose. The eMAR UI
/// reads from this table exclusively. PRN orders DO NOT pre-generate
/// rows; they are inserted on-the-fly when a nurse triggers a dose.
model EmarSchedule {
  id                 String          @id @default(uuid())
  tenantId           String          @map("tenant_id")
  prescriptionId     String          @map("prescription_id")
  prescriptionItemId String          @map("prescription_item_id")
  patientId          String          @map("patient_id")
  admissionId        String?         @map("admission_id")
  // G4 (1.4): traceability link to the pharmacy supply that covers these doses —
  // the dispensed batch + its DispensingRecord, stamped when a ward indent for the
  // same drug is dispensed. Scalar (no relation); eMAR stays a clinical record with
  // no stock/bill effect (link, don't double-deduct).
  drugBatchId        String?         @map("drug_batch_id")
  dispensingRecordId String?         @map("dispensing_record_id")
  drugName           String          @map("drug_name") @db.VarChar(255)
  dosage             String          @db.VarChar(100)
  route              MedicationRoute @default(oral)
  frequencyCode      String?         @map("frequency_code") @db.VarChar(40)
  slotCode           String?         @map("slot_code") @db.VarChar(40)
  scheduledAt        DateTime        @map("scheduled_at")
  status             EmarDoseStatus  @default(pending)
  isPrn              Boolean         @default(false) @map("is_prn")
  // Action audit fields
  actionedAt         DateTime?       @map("actioned_at") // when the row last transitioned
  actualGivenTime    DateTime?       @map("actual_given_time") // when nurse actually gave
  givenById          String?         @map("given_by_id")
  delayMinutes       Int?            @map("delay_minutes") // for given_late: actualGivenTime - scheduledAt
  reason             String?
  notes              String?
  // Amendment tracking
  amendedAt          DateTime?       @map("amended_at")
  amendedById        String?         @map("amended_by_id")
  previousStatus     EmarDoseStatus? @map("previous_status")
  // Soft cancel (e.g., when prescription cancelled)
  cancelledAt        DateTime?       @map("cancelled_at")
  cancelReason       String?         @map("cancel_reason")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  prescription     Prescription     @relation(fields: [prescriptionId], references: [id])
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  patient          Patient          @relation(fields: [patientId], references: [id])
  admission        Admission?       @relation(fields: [admissionId], references: [id])
  givenBy          User?            @relation("EmarGivenBy", fields: [givenById], references: [id])
  amendedBy        User?            @relation("EmarAmendedBy", fields: [amendedById], references: [id])
  auditLogs        EmarAuditLog[]
  ndpsPatientDose  NdpsPatientDose?

  @@index([tenantId, scheduledAt])
  @@index([tenantId, patientId, scheduledAt])
  @@index([tenantId, admissionId, scheduledAt])
  @@index([tenantId, status])
  @@map("emar_schedules")
}

/// Append-only audit trail. Every status change on a schedule row
/// produces a record here. The schedule row itself can be edited
/// (amended) but old states are preserved here.
model EmarAuditLog {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  scheduleId    String          @map("schedule_id")
  action        EmarAuditAction
  fromStatus    EmarDoseStatus? @map("from_status")
  toStatus      EmarDoseStatus  @map("to_status")
  performedById String?         @map("performed_by_id")
  performedAt   DateTime        @default(now()) @map("performed_at")
  serverTime    DateTime        @default(now()) @map("server_time")
  reason        String?
  notes         String?
  delayMinutes  Int?            @map("delay_minutes")
  metadata      Json?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  schedule    EmarSchedule @relation(fields: [scheduleId], references: [id])
  performedBy User?        @relation(fields: [performedById], references: [id])

  @@index([tenantId, scheduleId])
  @@index([tenantId, performedAt])
  @@map("emar_audit_logs")
}

// ============================================================
// 9. LAB & IMAGING
// ============================================================

// Per-tenant lab test definition. `parameters` (when set) is the structured
// list of result fields a technician/supervisor fills in when entering
// results — e.g. CBC ships 22 parameters (Hemoglobin, WBC, ...) with their
// own units + reference ranges. When `parameters` is null, the catalog
// behaves like a legacy flat test (the lab UI falls back to free-form
// parameter rows).
//
// Most catalogs are clones of a platform-wide LabTestTemplate (see
// `templateId`); admins can also build a standalone catalog with no template
// link. `parameters` is a snapshot so later template edits never silently
// mutate a hospital's existing test sheet.
model LabTestCatalog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  templateId      String?  @map("template_id")
  testName        String   @map("test_name") @db.VarChar(255)
  testCode        String?  @map("test_code") @db.VarChar(50)
  description     String?
  normalRange     String?  @map("normal_range")
  unit            String?  @db.VarChar(50)
  price           Decimal? @db.Decimal(10, 2)
  // A diagnostic test is an exempt healthcare service, but the invoice still
  // has to print its SAC and the return still has to group by it. This table
  // had no tax field of any kind.
  sacCode         String?  @map("sac_code") @db.VarChar(20)
  gstTreatment    String?  @map("gst_treatment") @db.VarChar(20)
  turnaroundHours Int?     @map("turnaround_hours")
  sampleType      String?  @map("sample_type") @db.VarChar(50)
  specimen        String?  @db.VarChar(255)
  instructions    String?
  // Structured ParameterSpec[] — see seed-lab-test-templates.ts for the
  // canonical shape. Validated by lab.validation.parametersSchema.
  parameters      Json?
  // Free-text interpretation / clinical-significance notes printed at the
  // bottom of the branded report.
  interpretation  String?
  // Synonyms (e.g. "FBC", "Hemogram", "Full Body Blood Count") + tags
  // (e.g. "hemoglobin", "wbc"). Power the dynamic-search layer so a doctor
  // typing "hemoglobin" surfaces CBC even though that string is not in the
  // canonical test name. Hospital admins can edit both freely without
  // touching the platform template.
  aliases         String[] @default([])
  tags            String[] @default([])
  // Denormalised lowercase index of name + code + aliases + tags + parameter
  // names — used for fast substring match (illike) in the dynamic-search
  // endpoint. Recomputed by the service on every create/update.
  searchTokens    String?  @map("search_tokens")
  // `true` when this row was authored locally (no platform template) — the
  // hospital admin built it from scratch via the Create Custom Test surface.
  // Custom rows live independently of master data; a future re-clone-all
  // never touches them because templateId is null.
  isCustom        Boolean  @default(false) @map("is_custom")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  template      LabTestTemplate? @relation(fields: [templateId], references: [id])
  labOrderItems LabOrderItem[]

  @@index([tenantId, templateId])
  @@index([tenantId, isActive])
  @@map("lab_test_catalog")
}

// Platform-wide lab test template. Authored by super_admin once and cloned
// by hospital admins into their own LabTestCatalog. Hospitals can re-clone
// later to pick up new parameters, but `LabTestCatalog.parameters` is a
// snapshot — edits to a template never retroactively mutate existing
// catalogs.
model LabTestTemplate {
  id              String   @id @default(uuid())
  name            String   @unique @db.VarChar(255)
  code            String?  @db.VarChar(50)
  sampleType      String?  @map("sample_type") @db.VarChar(50)
  specimen        String?  @db.VarChar(255)
  instructions    String?
  description     String?
  defaultPrice    Decimal? @map("default_price") @db.Decimal(10, 2)
  turnaroundHours Int?     @map("turnaround_hours")
  parameters      Json // ParameterSpec[]
  interpretation  String?
  // Synonyms + tags drive the dynamic-search layer. Aliases are alternative
  // test names a hospital might use ("FBC" -> CBC); tags are loose keywords
  // (parameter names, anatomy, indication keywords) that surface the test
  // when searched. Hospitals can extend both on their cloned catalog row
  // without touching the master template.
  aliases         String[] @default([])
  tags            String[] @default([])
  // Denormalised lowercase index of name + code + aliases + tags + parameter
  // names — recomputed by the service on every create/update.
  searchTokens    String?  @map("search_tokens")
  isPublished     Boolean  @default(true) @map("is_published")
  version         Int      @default(1)
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  createdBy User             @relation("LabTestTemplateCreator", fields: [createdById], references: [id])
  catalogs  LabTestCatalog[]

  @@map("lab_test_templates")
}

// ─────────────────────────────────────────────────────────────
// Lab Unit Groups + Units
// ─────────────────────────────────────────────────────────────
// Two-tier hierarchy (parameter → unit_group → unit) finalised in the
// 2026-05-23 meeting. Examples:
//   "concentration_mass"   → mg/dL (base), g/dL, µg/dL, ng/dL, mg/L, …
//   "concentration_molar"  → mmol/L (base), µmol/L, nmol/L, pmol/L, mEq/L
//   "hematology_counts"    → 10^3/µL (base), 10^6/µL, 10^9/L, 10^12/L, …
// The structure prepares the system for future automated conversion (the
// meeting deliberately deferred the conversion *logic* but kept the *data
// hierarchy* so it can be added later without a schema migration).
//
// `tenantId` is nullable: NULL = platform-wide group (managed by super-
// admin), non-NULL = hospital-local group/unit. Hospitals can create their
// own groups + units without polluting the global catalog (matches the
// dynamic-forms architecture). `isSystem` flags rows seeded from
// `LAB_UNIT_GROUPS` constants — UI hides delete on them.
model LabUnitGroup {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  code        String   @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant?   @relation(fields: [tenantId], references: [id])
  units  LabUnit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("lab_unit_groups")
}

model LabUnit {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id")
  unitGroupId      String   @map("unit_group_id")
  symbol           String   @db.VarChar(60)
  name             String?  @db.VarChar(120)
  // conversionFactor + isBase prepare for future unit-conversion logic
  // (deferred per the meeting). isBase = true for the canonical unit of the
  // group (e.g. mg/dL for concentration_mass); conversionFactor = ratio
  // to that base unit. Nullable today because we ship factors only for
  // simple linear pairs.
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(20, 10)
  isBase           Boolean  @default(false) @map("is_base")
  isSystem         Boolean  @default(false) @map("is_system")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant?      @relation(fields: [tenantId], references: [id])
  unitGroup LabUnitGroup @relation(fields: [unitGroupId], references: [id], onDelete: Cascade)

  @@unique([unitGroupId, symbol])
  @@index([tenantId, unitGroupId])
  @@map("lab_units")
}

model LabOrder {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  patientId             String         @map("patient_id")
  visitId               String         @map("visit_id")
  orderedBy             String         @map("ordered_by")
  assignedToId          String?        @map("assigned_to_id")
  acceptedAt            DateTime?      @map("accepted_at")
  acceptedBy            String?        @map("accepted_by")
  // Payment gate, mirroring ImagingRequest so both diagnostic modules run the
  // one flow. The lab admin accepts the order at their own counter: an OP
  // patient pays there and then, an admitted patient's charge goes straight to
  // the IP ledger (which counts as cleared — it settles at discharge). An order
  // may still be accepted unpaid for a TPA / credit patient, in which case the
  // reason is recorded and the order carries an Unpaid badge until it is settled.
  paymentVerified       Boolean        @default(false) @map("payment_verified")
  paymentVerifiedBy     String?        @map("payment_verified_by")
  paymentVerifiedAt     DateTime?      @map("payment_verified_at")
  paymentDeferredReason String?        @map("payment_deferred_reason")
  urgency               Urgency        @default(routine)
  status                LabOrderStatus @default(ordered)
  isThirdParty          Boolean        @default(false) @map("is_third_party")
  thirdPartyLabName     String?        @map("third_party_lab_name") @db.VarChar(255)
  notes                 String?
  // Patient marked this order done from outside (got tested elsewhere).
  // When set, the lab worklist hides the order (status flips to completed)
  // and the doctor / nurse views show a "Marked done by patient" badge
  // linking to the uploaded report.
  completedExternallyAt DateTime?      @map("completed_externally_at")
  completedExternallyBy String?        @map("completed_externally_by")
  externalReportUrl     String?        @map("external_report_url")
  externalNotes         String?        @map("external_notes")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  patient           Patient         @relation(fields: [patientId], references: [id])
  visit             Visit           @relation(fields: [visitId], references: [id])
  orderer           User            @relation(fields: [orderedBy], references: [id])
  assignedTo        User?           @relation("LabOrderAssignee", fields: [assignedToId], references: [id])
  acceptedByUser    User?           @relation("LabOrderAcceptor", fields: [acceptedBy], references: [id])
  paymentVerifier   User?           @relation("LabOrderPaymentVerifier", fields: [paymentVerifiedBy], references: [id])
  externalCompleter User?           @relation("LabOrderExternalCompleter", fields: [completedExternallyBy], references: [id])
  labOrderItems     LabOrderItem[]
  labSamples        LabSample[]
  labResults        LabResult[]
  labReport         LabReport?
  attachments       LabAttachment[]

  @@map("lab_orders")
}

model LabOrderItem {
  id         String             @id @default(uuid())
  labOrderId String             @map("lab_order_id")
  testId     String             @map("test_id")
  status     LabOrderItemStatus @default(pending)
  createdAt  DateTime           @default(now()) @map("created_at")

  labOrder   LabOrder       @relation(fields: [labOrderId], references: [id])
  test       LabTestCatalog @relation(fields: [testId], references: [id])
  labResults LabResult[]

  @@map("lab_order_items")
}

model LabSample {
  id              String          @id @default(uuid())
  labOrderId      String          @map("lab_order_id")
  sampleType      String          @map("sample_type") @db.VarChar(50)
  barcode         String?         @unique @db.VarChar(100)
  collectedBy     String?         @map("collected_by")
  collectedAt     DateTime?       @map("collected_at")
  receivedAt      DateTime?       @map("received_at")
  status          LabSampleStatus @default(collected)
  rejectionReason String?         @map("rejection_reason")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  labOrder  LabOrder @relation(fields: [labOrderId], references: [id])
  collector User?    @relation(fields: [collectedBy], references: [id])

  @@map("lab_samples")
}

model LabResult {
  id              String          @id @default(uuid())
  labOrderItemId  String          @map("lab_order_item_id")
  labOrderId      String          @map("lab_order_id")
  patientId       String          @map("patient_id")
  parameterName   String          @map("parameter_name") @db.VarChar(255)
  value           String?         @db.VarChar(255)
  unit            String?         @db.VarChar(50)
  normalRange     String?         @map("normal_range") @db.VarChar(100)
  isAbnormal      Boolean         @default(false) @map("is_abnormal")
  status          LabResultStatus @default(entered)
  // How the value got here: 'manual' (typed into the result grid) or 'ocr'
  // (read off an uploaded report PDF/scan). Null = manual, for rows that
  // predate this. An OCR row is machine-read and unverified until the lab
  // confirms it, so the entry grid marks it for review.
  source          String?         @db.VarChar(20)
  enteredBy       String?         @map("entered_by")
  enteredAt       DateTime        @default(now()) @map("entered_at")
  verifiedBy      String?         @map("verified_by")
  verifiedAt      DateTime?       @map("verified_at")
  correctionNotes String?         @map("correction_notes")

  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  labOrder     LabOrder     @relation(fields: [labOrderId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  enterer      User?        @relation(fields: [enteredBy], references: [id])
  verifier     User?        @relation("LabResultVerifier", fields: [verifiedBy], references: [id])

  // One value per parameter per test. The real constraint is a UNIQUE index on
  // (lab_order_item_id, LOWER(parameter_name)) — Prisma cannot express the
  // LOWER(), so it lives in the migration and this index keeps `db push` from
  // planning around a column pair it thinks is unconstrained.
  @@index([labOrderItemId, parameterName])
  @@map("lab_results")
}

model LabReport {
  id               String          @id @default(uuid())
  labOrderId       String          @unique @map("lab_order_id")
  patientId        String          @map("patient_id")
  reportContent    String?         @map("report_content")
  hospitalBranding Json?           @map("hospital_branding")
  qrCodeUrl        String?         @map("qr_code_url")
  pdfUrl           String?         @map("pdf_url")
  status           LabReportStatus @default(draft)
  reviewedBy       String?         @map("reviewed_by")
  reviewedAt       DateTime?       @map("reviewed_at")
  approvedBy       String?         @map("approved_by")
  approvedAt       DateTime?       @map("approved_at")
  signedBy         String?         @map("signed_by")
  signedAt         DateTime?       @map("signed_at")
  version          Int             @default(1)
  correctionNotes  String?         @map("correction_notes")
  publishedAt      DateTime?       @map("published_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")

  labOrder    LabOrder        @relation(fields: [labOrderId], references: [id])
  patient     Patient         @relation(fields: [patientId], references: [id])
  reviewer    User?           @relation("LabReportReviewer", fields: [reviewedBy], references: [id])
  approver    User?           @relation("LabReportApprover", fields: [approvedBy], references: [id])
  signer      User?           @relation("LabReportSigner", fields: [signedBy], references: [id])
  attachments LabAttachment[]

  @@map("lab_reports")
}

// LabAttachment — files (PDFs, scanned reports, microscopy images, gel scans,
// instrument output) tied to a lab order (and optionally to a specific report
// or order item). Persisted on disk under /uploads with metadata in this row;
// the same file is what doctors, nurses and patients see in their respective
// surfaces. Soft-deleted via deletedAt so audit trail is preserved.
model LabAttachment {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  labOrderId     String                @map("lab_order_id")
  labReportId    String?               @map("lab_report_id")
  labOrderItemId String?               @map("lab_order_item_id")
  category       LabAttachmentCategory @default(report_pdf)
  fileName       String                @map("file_name") @db.VarChar(255)
  fileUrl        String                @map("file_url")
  mimeType       String                @map("mime_type") @db.VarChar(100)
  sizeBytes      Int                   @map("size_bytes")
  description    String?
  uploadedBy     String                @map("uploaded_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  deletedAt      DateTime?             @map("deleted_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  labOrder  LabOrder   @relation(fields: [labOrderId], references: [id])
  labReport LabReport? @relation(fields: [labReportId], references: [id])
  uploader  User       @relation("LabAttachmentUploader", fields: [uploadedBy], references: [id])

  @@index([tenantId, labOrderId])
  @@index([tenantId, labReportId])
  @@map("lab_attachments")
}

// ============================================================
// 10. IMAGING
// ============================================================

model ImagingRequest {
  id                    String                @id @default(uuid())
  tenantId              String                @map("tenant_id")
  patientId             String                @map("patient_id")
  visitId               String                @map("visit_id")
  orderedBy             String                @map("ordered_by")
  imagingType           ImagingType           @map("imaging_type")
  bodyPart              String?               @map("body_part") @db.VarChar(100)
  urgency               Urgency               @default(routine)
  clinicalIndication    String?               @map("clinical_indication")
  status                ImagingRequestStatus  @default(requested)
  scheduledAt           DateTime?             @map("scheduled_at")
  completedAt           DateTime?             @map("completed_at")
  assignedTechnicianId  String?               @map("assigned_technician_id")
  room                  String?               @db.VarChar(100)
  notes                 String?
  // Patient self-completion (scan done at another facility). Hides the
  // request from the radiology worklist and surfaces a "Marked done by
  // patient" badge to the doctor + nurse with a link to the upload.
  completedExternallyAt DateTime?             @map("completed_externally_at")
  completedExternallyBy String?               @map("completed_externally_by")
  externalReportUrl     String?               @map("external_report_url")
  externalNotes         String?               @map("external_notes")
  // Payment-verify gate (2026-05-27). The doctor's request lands in the
  // radiology_admin queue first; the admin clicks "Verify Payment" once the
  // patient has paid the imaging charge at the cash counter. Only then does
  // the radiologist see the request in their worklist. Keeps clinical staff
  // out of payment workflows.
  paymentVerified       Boolean               @default(false) @map("payment_verified")
  paymentVerifiedBy     String?               @map("payment_verified_by")
  paymentVerifiedAt     DateTime?             @map("payment_verified_at")
  // Accepting is the admin's single act: take the money (or record why it is
  // deferred), admit the study, hand it to a radiologist. Mirrors LabOrder so
  // both diagnostic modules read the same. `paymentVerified` above remains the
  // gate the radiologist's queue filters on.
  acceptedAt            DateTime?             @map("accepted_at")
  acceptedBy            String?               @map("accepted_by")
  paymentDeferredReason String?               @map("payment_deferred_reason")
  // Admin closure (2026-06-01). Captures requests that end without a report
  // file — patient no-show, refused, done elsewhere, not required, etc. The
  // status lands on `no_show` or `cancelled`; this preserves the reason.
  closureReason         ImagingClosureReason? @map("closure_reason")
  closureNote           String?               @map("closure_note")
  closedBy              String?               @map("closed_by")
  closedAt              DateTime?             @map("closed_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  patient            Patient             @relation(fields: [patientId], references: [id])
  visit              Visit               @relation(fields: [visitId], references: [id])
  orderer            User                @relation(fields: [orderedBy], references: [id])
  assignedTechnician User?               @relation("ImagingTechnician", fields: [assignedTechnicianId], references: [id])
  externalCompleter  User?               @relation("ImagingRequestExternalCompleter", fields: [completedExternallyBy], references: [id])
  paymentVerifier    User?               @relation("ImagingPaymentVerifier", fields: [paymentVerifiedBy], references: [id])
  acceptedByUser     User?               @relation("ImagingRequestAcceptor", fields: [acceptedBy], references: [id])
  closer             User?               @relation("ImagingRequestCloser", fields: [closedBy], references: [id])
  imagingResult      ImagingResult?
  attachments        ImagingAttachment[]

  @@map("imaging_requests")
}

model ImagingResult {
  id               String              @id @default(uuid())
  imagingRequestId String              @unique @map("imaging_request_id")
  patientId        String              @map("patient_id")
  impression       String?
  radiologistId    String?             @map("radiologist_id")
  imageUrls        Json?               @map("image_urls")
  pacsReferenceId  String?             @map("pacs_reference_id") @db.VarChar(255)
  pdfReportUrl     String?             @map("pdf_report_url")
  status           ImagingResultStatus @default(draft)
  signedBy         String?             @map("signed_by")
  signedAt         DateTime?           @map("signed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")

  imagingRequest ImagingRequest      @relation(fields: [imagingRequestId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id])
  radiologist    User?               @relation("ImagingRadiologist", fields: [radiologistId], references: [id])
  signer         User?               @relation("ImagingResultSigner", fields: [signedBy], references: [id])
  dicomStudies   DicomStudy[]
  attachments    ImagingAttachment[]

  @@map("imaging_results")
}

// ImagingAttachment — files attached to a radiology order or its result.
// Mirrors LabAttachment in spirit but accepts a broader allowlist (DICOM
// .dcm files from modality output, video loops from USG/echo, JPEG/PNG
// snapshots, scanned PDF reports). Same on-disk storage as lab uploads
// (multer → /uploads/...) so doctors, nurses and patients all read the
// same file via the public static handler.
model ImagingAttachment {
  id               String                    @id @default(uuid())
  tenantId         String                    @map("tenant_id")
  imagingRequestId String                    @map("imaging_request_id")
  imagingResultId  String?                   @map("imaging_result_id")
  category         ImagingAttachmentCategory @default(image)
  fileName         String                    @map("file_name") @db.VarChar(255)
  fileUrl          String                    @map("file_url")
  mimeType         String                    @map("mime_type") @db.VarChar(100)
  sizeBytes        Int                       @map("size_bytes")
  description      String?
  uploadedBy       String                    @map("uploaded_by")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?                 @map("deleted_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  imagingRequest ImagingRequest @relation(fields: [imagingRequestId], references: [id])
  imagingResult  ImagingResult? @relation(fields: [imagingResultId], references: [id])
  uploader       User           @relation("ImagingAttachmentUploader", fields: [uploadedBy], references: [id])

  @@index([tenantId, imagingRequestId])
  @@index([tenantId, imagingResultId])
  @@map("imaging_attachments")
}

// ============================================================
// 10b. PACS / DICOM
// ============================================================
// Lightweight metadata-only storage: actual DICOM files live on disk
// (uploads/dicom/<studyUid>/...) and a web viewer (OHIF/Cornerstone)
// renders them via study/series/instance URLs served from this app.
//
// For a real DICOM PACS receive (DIMSE C-STORE SCP) you'd run a separate
// process — this layer is the metadata + retrieve side; integrate that
// process to POST DicomInstance rows here on receipt.

model DicomStudy {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  imagingResultId    String?   @map("imaging_result_id")
  imagingRequestId   String?   @map("imaging_request_id")
  patientId          String    @map("patient_id")
  studyInstanceUid   String    @unique @map("study_instance_uid") @db.VarChar(255)
  accessionNumber    String?   @map("accession_number") @db.VarChar(64)
  studyDate          DateTime? @map("study_date")
  studyDescription   String?   @map("study_description") @db.VarChar(255)
  modality           String?   @db.VarChar(20)
  numberOfSeries     Int?      @map("number_of_series")
  numberOfInstances  Int?      @map("number_of_instances")
  patientName        String?   @map("patient_name") @db.VarChar(255)
  patientDicomId     String?   @map("patient_dicom_id") @db.VarChar(64)
  referringPhysician String?   @map("referring_physician") @db.VarChar(255)
  storagePath        String?   @map("storage_path")
  viewerUrl          String?   @map("viewer_url")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  imagingResult ImagingResult?  @relation(fields: [imagingResultId], references: [id])
  patient       Patient         @relation(fields: [patientId], references: [id])
  series        DicomSeries[]
  instances     DicomInstance[]

  @@index([tenantId, patientId, studyDate])
  @@map("dicom_studies")
}

model DicomSeries {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  studyId           String   @map("study_id")
  seriesInstanceUid String   @unique @map("series_instance_uid") @db.VarChar(255)
  seriesNumber      Int?     @map("series_number")
  seriesDescription String?  @map("series_description") @db.VarChar(255)
  modality          String?  @db.VarChar(20)
  bodyPart          String?  @map("body_part") @db.VarChar(100)
  numberOfInstances Int?     @map("number_of_instances")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  study     DicomStudy      @relation(fields: [studyId], references: [id], onDelete: Cascade)
  instances DicomInstance[]

  @@index([tenantId, studyId])
  @@map("dicom_series")
}

model DicomInstance {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  studyId        String   @map("study_id")
  seriesId       String?  @map("series_id")
  sopInstanceUid String   @unique @map("sop_instance_uid") @db.VarChar(255)
  sopClassUid    String?  @map("sop_class_uid") @db.VarChar(255)
  instanceNumber Int?     @map("instance_number")
  fileUrl        String   @map("file_url")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  mimeType       String?  @map("mime_type") @db.VarChar(100)
  rows           Int?
  columns        Int?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  study  DicomStudy   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  series DicomSeries? @relation(fields: [seriesId], references: [id])

  @@index([tenantId, studyId])
  @@map("dicom_instances")
}

// ============================================================
// 11. PHARMACY
// ============================================================

// Global reference catalogue seeded from the open Indian medicine dataset
// (~254K brands). Tenant-agnostic: no tenantId. Hospitals SEARCH this and
// "add to formulary" only the drugs they actually stock — the cloned row
// lands in DrugFormulary with drugMasterId set (mirrors LabTestTemplate ->
// LabTestCatalog). Doctors can still free-text any drug not present here.
model DrugMaster {
  id                   String      @id @default(uuid())
  name                 String      @db.VarChar(255)
  genericName          String?     @map("generic_name") @db.VarChar(500)
  manufacturer         String?     @db.VarChar(255)
  type                 String?     @db.VarChar(50)
  dosageForm           DosageForm? @map("dosage_form")
  strength             String?     @db.VarChar(100)
  packSizeLabel        String?     @map("pack_size_label") @db.VarChar(255)
  // Numeric base units per pack/strip (e.g. 10), resolved from the label. Copied
  // straight into DrugFormulary.packSize on import so a strip sells as loose
  // units. Null = indivisible container (bottle/vial/tube).
  packSize             Int?        @map("pack_size")
  mrp                  Decimal?    @db.Decimal(10, 2)
  isDiscontinued       Boolean     @default(false) @map("is_discontinued")
  // LEGACY, DELIBERATELY LEFT NULL. checkSaleCompliance() already reads this
  // column and is already wired into createPharmacySale, so populating it would
  // silently switch counter enforcement on. The classifier writes
  // `scheduleResolved` instead; the compliance gate is repointed at that field
  // in a later phase, behind a per-hospital enforcement setting.
  schedule             String?     @db.VarChar(10)
  // ── Resolved by the schedule classifier (see drug-schedule.classifier.ts) ──
  // 'X' | 'H1' | 'H' | 'G' | 'H2' | 'OTC'. Null = not yet classified.
  scheduleResolved     String?     @map("schedule_resolved") @db.VarChar(10)
  // Human-readable justification ("matched Schedule H1 salt Tramadol"), kept so
  // a pharmacist or an inspector can see WHY a drug carries its schedule.
  scheduleReason       String?     @map("schedule_reason")
  // NDPS overlay, independent of scheduleResolved: 'narcotic' | 'psychotropic'.
  controlledClass      String?     @map("controlled_class") @db.VarChar(20)
  // Physical safe custody + witness co-sign. False for benzodiazepines,
  // tramadol and zolpidem, which dispense over the counter under their own
  // schedule.
  vaultControlled      Boolean     @default(false) @map("vault_controlled")
  // Schedule H2 brand — Rule 96(6)-(7) QR/barcode obligation, not an Rx gate.
  requiresQrScan       Boolean     @default(false) @map("requires_qr_scan")
  // Salts parsed out of genericName: [{ raw, norm, strengthValue, strengthUnit,
  // perVolumeMl }]. Cached so the backfill and the reports do not re-parse.
  saltsJson            Json?       @map("salts_json")
  classifiedAt         DateTime?   @map("classified_at")
  // Bumped when the classifier's logic changes, so a re-run can find stale rows.
  classifierVersion    Int?        @map("classifier_version")
  // Product Resolution Engine identity + compliance fields. GTIN-13 is the
  // consumer unit (a single strip/bottle); casePackGtin (GTIN-14) is the outer
  // wholesale case, and unitsPerCase translates a scanned case into N consumer
  // units. manufacturerCode is the maker's own product code (second-tier match).
  // hsnCode / gstRate drive tax + compliance validation at inward and billing.
  // A GTIN identifies one product, so it is unique across the whole platform
  // catalog. Nulls are allowed to repeat (Postgres treats them as distinct);
  // writes normalise a blank to NULL so an empty field never trips the index.
  gtin                 String?     @unique @db.VarChar(20)
  casePackGtin         String?     @unique @map("case_pack_gtin") @db.VarChar(20)
  unitsPerCase         Int?        @map("units_per_case")
  manufacturerCode     String?     @map("manufacturer_code") @db.VarChar(100)
  hsnCode              String?     @map("hsn_code") @db.VarChar(20)
  gstRate              Decimal?    @map("gst_rate") @db.Decimal(5, 2)
  // Explicit product-level treatment for exceptions that HSN alone cannot
  // express (for example the medicines named in Notification 10/2025-CT(R)).
  // Null means "resolve from the HSN master"; ordinary taxable medicines stay
  // null so a later statutory HSN-rate change is picked up automatically.
  gstTreatment         String?     @map("gst_treatment") @db.VarChar(20)
  // 'notification' for the built-in named-medicine exemption, 'manual' for a
  // super-admin classification. Lets a later catalogue refresh safely remove
  // an inferred exemption without touching a person's decision.
  gstTreatmentSource   String?     @map("gst_treatment_source") @db.VarChar(20)
  // Version of the catalogue GST classifier that last considered this row.
  // It lets startup process only new/changed vendor rows instead of rescanning
  // the entire catalogue on every boot.
  gstClassifierVersion Int?        @map("gst_classifier_version")
  aliases              String[]    @default([])
  tags                 String[]    @default([])
  // Rich clinical detail (populated from the richer dataset / future provider
  // feeds). Reference data shared by all hospitals.
  saltComposition      String?     @map("salt_composition")
  description          String? // uses / "about" text
  sideEffects          String?     @map("side_effects")
  drugInteractions     Json?       @map("drug_interactions") // { drug[], brand[], effect[] }
  // Denormalised lowercase index of name + generic + manufacturer, recomputed
  // on every create/update — drives the catalog search endpoint.
  searchTokens         String?     @map("search_tokens")
  isPublished          Boolean     @default(true) @map("is_published")
  createdById          String?     @map("created_by_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at")

  // ── Vendor catalogue (see drug-catalog.release.ts) ──
  // The vendor's own product ID: "DRS003256" for a drug, "DR001826" for an OTC
  // product. Stable from one monthly drop to the next, so a refresh matches on
  // it instead of guessing from name + manufacturer + pack. Null on a row a
  // super admin or a pharmacist added by hand.
  sourceId         String?  @unique @map("source_id") @db.VarChar(40)
  // The release that last wrote the row ("2026-06"). A product missing from a
  // later release is marked discontinued, never deleted — a hospital's
  // formulary may still point at it.
  sourceRelease    String?  @map("source_release") @db.VarChar(20)
  // Fingerprint of everything the vendor supplied for this row, so a refresh
  // rewrites only the products that actually changed.
  sourceHash       String?  @map("source_hash") @db.VarChar(32)
  // The pack as data: "Strip" + "10", "Bottle" + "100 ml". packSizeLabel keeps
  // the sentence ("strip of 10 tablets") that the pack-size parser reads.
  packageType      String?  @map("package_type") @db.VarChar(40)
  packQuantity     String?  @map("pack_quantity") @db.VarChar(40)
  // The vendor's dosage form, finer than the DosageForm it maps to: "Tablet SR",
  // "Oral Suspension", "Powder for Injection".
  productForm      String?  @map("product_form") @db.VarChar(60)
  // What the vendor's label says. NOT a schedule — the schedule is decided by
  // the salt master and the classifier, and nothing reads this to gate a sale.
  rxRequired       Boolean? @map("rx_required")
  habitForming     Boolean? @map("habit_forming")
  therapeuticClass String?  @map("therapeutic_class") @db.VarChar(120)
  chemicalClass    String?  @map("chemical_class") @db.VarChar(255)
  actionClass      String?  @map("action_class") @db.VarChar(255)
  // OTC products: the vendor's category ("Vitamins & Nutrition") and where it
  // sits ("Nutritional Needs > Vitamins & Nutrition").
  productCategory  String?  @map("product_category") @db.VarChar(120)
  categoryPath     String?  @map("category_path") @db.VarChar(400)
  storage          String?  @db.VarChar(120)
  countryOfOrigin  String?  @map("country_of_origin") @db.VarChar(80)
  // The vendor's six verdicts: { alcohol, pregnancy, lactation, driving,
  // kidney, liver } → 'safe' | 'safe_if_prescribed' | 'caution' | 'unsafe' |
  // 'consult_doctor' | 'not_relevant'. The advice behind them is in `monograph`.
  safetyAdvice     Json?    @map("safety_advice")
  // Section → DrugText.id. A drug has { intro, benefits, howToUse, howItWorks,
  // safetyAdvice, missedDose, interactions, faq, marketer }, an OTC product
  // { highlights, information, ingredients, benefits, directions, safetyInfo,
  // marketer }. The prose lives in DrugText because it is shared — see there.
  monograph        Json?

  formularyItems DrugFormulary[]
  /// Structured composition. Replaces parsing `saltComposition` at classify time.
  salts          DrugSalt[]

  @@index([name])
  @@index([scheduleResolved])
  @@map("drug_master")
}

/// Catalogue prose, stored once and shared by every product that uses it.
///
/// The vendor writes one text per molecule or formulation and pastes each
/// brand's name into it, so 399,090 drugs carry 1.5 GB of prose but only about
/// 37 MB once the name is taken back out. A text is stored with the product's
/// name replaced by {{name}}; `renderTemplate` puts it back when the text is
/// shown, which returns the vendor's words exactly. DrugMaster.monograph points
/// at these by id.
///
/// An integer id on purpose: three-quarters of a million products each hold
/// several references, and a UUID in every one would cost a couple of hundred
/// megabytes of JSON for nothing.
model DrugText {
  id        Int      @id @default(autoincrement())
  /// sha256 of the body, first 32 hex characters — how an import recognises a
  /// text it already has, so the same words are never stored twice.
  hash      String   @unique @db.VarChar(32)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("drug_texts")
}

/// One vendor catalogue release applied to drug_master.
///
/// Auto-seed compares the release bundled in the image with the last COMPLETE
/// row here, so a deploy that ships a new release imports it once and every
/// later boot costs a single query. A row left 'importing' by a crash is simply
/// picked up again — every phase of the import is idempotent.
model DrugCatalogRelease {
  id            String    @id @default(uuid())
  release       String    @unique @db.VarChar(20)
  // 'importing' | 'complete' | 'failed'
  status        String    @db.VarChar(20)
  sources       String[]  @default([])
  products      Int       @default(0)
  inserted      Int       @default(0)
  updated       Int       @default(0)
  discontinued  Int       @default(0)
  texts         Int       @default(0)
  // Rows of the previous open dataset removed, and what happened to the
  // hospital formulary rows that had been imported from them.
  legacyRemoved Int       @default(0) @map("legacy_removed")
  relinked      Int       @default(0)
  unlinked      Int       @default(0)
  // Which hospital drugs lost their catalogue link, and which identity fields
  // (GTIN, HSN) were carried across — the audit trail for the swap.
  report        Json?
  error         String?
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@map("drug_catalog_releases")
}

// ============================================================
// HSN → GST reference (platform-wide tax master)
// ============================================================
// In India GST is legally determined by an item's HSN code, so this is the
// single source of truth that turns an HSN code into a GST rate. It is platform
// reference data (no tenantId — every hospital shares it, like the drug catalog
// or ICD codes). At stock inward the entered/scanned HSN is looked up here by
// LONGEST-PREFIX match (an 8-digit tariff item wins over its 4-digit chapter
// heading) and the matching gstRate auto-fills the batch's GST, so the operator
// never has to remember the rate for each medicine.
model HsnGstRate {
  id          String   @id @default(uuid())
  // Digits only (spaces/dots stripped on write). 4-digit headings (e.g. "3004")
  // act as a chapter-wide default; 6/8-digit entries override for specific items
  // (e.g. "30049010" ORS is nil while the "3004" default is 5%).
  hsnCode     String   @unique @map("hsn_code") @db.VarChar(20)
  description String?  @db.VarChar(255)
  gstRate     Decimal  @map("gst_rate") @db.Decimal(5, 2)
  // What KIND of zero a zero is: 'taxable' | 'nil_rated' | 'exempt' | 'non_gst'.
  // A rate on its own cannot say — GSTR-1 and GSTR-3B report nil-rated, exempt
  // and non-GST turnover on three different lines, so collapsing them all into
  // "0%" throws away the distinction the return asks for.
  treatment   String?  @db.VarChar(20)
  // Loose grouping for the reference UI ('medicine' | 'consumable' | 'device' | …).
  category    String?  @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("hsn_gst_rates")
}

// ============================================================
// SAC → GST reference (platform-wide tax master, for SERVICES)
// ============================================================
// The other half of the pair above. HSN classifies GOODS; SAC classifies
// SERVICES, and a hospital sells far more of the second than the first —
// consultation, surgery, nursing, diagnostics, room accommodation. None of it
// had a tax master at all, which is why every service rate in this system was
// either hard-coded to zero or typed in by hand at the counter.
//
// Same shape and same rules as HsnGstRate on purpose: platform reference data
// with no tenantId, matched by LONGEST PREFIX so a 6-digit code (999312,
// medical and dental services) beats its 4-digit heading (9993, human health).
//
// `treatment` matters more here than it does for goods. Almost every healthcare
// SAC is EXEMPT rather than nil-rated or zero-percent-taxable, and the return
// reports exempt turnover on its own line — which is also the numerator of the
// input-credit reversal a hospital has to compute every month.
/// The list of GST rates the law recognises, with the dates each was legal.
///
/// PLATFORM data. A slab is not a hospital's opinion — it is the set of rates
/// Parliament has enacted, identical for every hospital on the platform, and a
/// rate outside it on an invoice is an invoice that will be rejected.
///
/// Date-ranged rather than a flat list, because the answer changed on 22
/// September 2025: GST 2.0 retired 12% and 28% and introduced 40%. A bill
/// raised in June 2025 at 12% was correct and must stay correct; the same rate
/// on a bill raised today is not. A single boolean cannot say both, so each
/// slab carries the window it was legal in and the check is made AS AT the
/// bill's own date.
///
/// `effectiveTo` null means "still in force".
model GstSlab {
  id            String    @id @default(uuid())
  ratePercent   Decimal   @map("rate_percent") @db.Decimal(5, 2)
  /// What to call it on a screen — "5%", "Nil", "40% (sin goods)".
  label         String    @db.VarChar(40)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  /// Why this window exists — the notification or Council meeting behind it.
  note          String?   @db.VarChar(255)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([ratePercent, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
  @@map("gst_slabs")
}

/// The category fallback the rate chain has a branch for and had no data for.
///
/// `determineTax` step 7 reads `masters.categoryDefault`; the resolver passed a
/// literal null for it on every call, so the branch was unreachable — no
/// bill_item in this database has ever carried `rate_source = 'category_default'`.
///
/// It is a FALLBACK, never an override: it sits below the item master and the
/// HSN/SAC masters in the chain, and anything it makes taxable is flagged
/// `requiresResolution` so the finalisation gate refuses it. That is exactly the
/// safety rule the Changes document asks for.
///
/// PLATFORM data, like the masters beside it — "consultation is exempt" is not a
/// hospital's opinion.
model GstCategoryDefault {
  id          String   @id @default(uuid())
  /// One of the engine's SupplyKind values.
  supplyKind  String   @unique @map("supply_kind") @db.VarChar(20)
  ratePercent Decimal  @default(0) @map("rate_percent") @db.Decimal(5, 2)
  /// 'taxable' | 'exempt' | 'nil_rated' | 'non_gst' | 'zero_rated'.
  treatment   String   @default("exempt") @db.VarChar(20)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("gst_category_defaults")
}

model SacCode {
  id          String   @id @default(uuid())
  // Digits only (spaces/dots stripped on write), like hsn_code.
  sacCode     String   @unique @map("sac_code") @db.VarChar(20)
  description String?  @db.VarChar(255)
  gstRate     Decimal  @map("gst_rate") @db.Decimal(5, 2)
  // 'taxable' | 'exempt' | 'nil_rated' | 'non_gst' | 'zero_rated'.
  treatment   String?  @db.VarChar(20)
  // Loose grouping for the reference UI ('healthcare' | 'accommodation' | …).
  category    String?  @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("sac_codes")
}

/// Every change to a tax master, kept because a rate that moved explains a bill
/// that suddenly costs a different amount.
///
/// PLATFORM data, like the masters themselves — there is no tenant column,
/// because a change to 3004 changes it for every hospital at once, and that is
/// exactly what makes the impact worth reporting.
model GstRateChange {
  id                String   @id @default(uuid())
  /// 'hsn' or 'sac'. The two masters are separate tables and one log.
  codeType          String   @map("code_type") @db.VarChar(8)
  code              String   @db.VarChar(20)
  description       String?  @db.VarChar(255)
  previousRate      Decimal? @map("previous_rate") @db.Decimal(5, 2)
  newRate           Decimal? @map("new_rate") @db.Decimal(5, 2)
  previousTreatment String?  @map("previous_treatment") @db.VarChar(20)
  newTreatment      String?  @map("new_treatment") @db.VarChar(20)
  /// 'create' | 'update' | 'deactivate' — a deactivation changes what an item
  /// resolves to just as surely as a rate does.
  action            String   @db.VarChar(12)
  changedBy         String?  @map("changed_by")
  changedAt         DateTime @default(now()) @map("changed_at")

  changer User? @relation(fields: [changedBy], references: [id])

  @@index([changedAt])
  @@index([codeType, code])
  @@map("gst_rate_changes")
}

/// A frozen copy of what a hospital actually filed for a period.
///
/// The reports are live: they read today's bills, and a bill raised or amended
/// after filing changes what they say. That is right for the current month and
/// wrong for a closed one — an accountant asked "what did you file in
/// September" needs the figures AS FILED, not as they look now.
///
/// So this stores the RETURN figures rather than the register behind them: the
/// rate summary, the HSN summary, the GSTR-1 tables and the GSTR-3B boxes. They
/// are small, they are what was filed, and they cannot drift.
model GstFiledPeriod {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  financialYear String    @map("financial_year") @db.VarChar(7)
  /// The return period as MMYYYY, matching what the portal calls it.
  returnPeriod  String    @map("return_period") @db.VarChar(6)
  periodFrom    DateTime  @map("period_from") @db.Date
  periodTo      DateTime  @map("period_to") @db.Date
  filedAt       DateTime  @default(now()) @map("filed_at")
  filedBy       String?   @map("filed_by")
  note          String?
  /// The figures as filed. Not the register — see the model comment.
  snapshot      Json
  /// When the period was LOCKED, which is a separate act from filing.
  ///
  /// Archiving the figures is a record; locking is a decision. A hospital wants
  /// the snapshot the moment it files and may not want the doors shut until it
  /// has checked. Null means open, and every period archived before this
  /// existed stays exactly as editable as it was.
  lockedAt      DateTime? @map("locked_at")
  lockedBy      String?   @map("locked_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  filer  User?  @relation("GstPeriodFiler", fields: [filedBy], references: [id])
  locker User?  @relation("GstPeriodLocker", fields: [lockedBy], references: [id])

  @@unique([tenantId, returnPeriod])
  @@index([tenantId, filedAt])
  @@index([tenantId, lockedAt])
  @@map("gst_filed_periods")
}

/// One GSTR-2B statement, as downloaded from the portal.
///
/// 2B is what the government says the hospital's SUPPLIERS have declared, and a
/// hospital may only claim credit that appears in it. Nothing in this system
/// can produce that — it has to be imported.
model Gstr2bImport {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  /// MMYYYY, the period the statement covers — the file's own `rtnprd`.
  returnPeriod String    @map("return_period") @db.VarChar(6)
  /// The recipient GSTIN the file was generated for. Checked against ours.
  gstin        String?   @db.VarChar(15)
  generatedAt  DateTime? @map("generated_at")
  version      String?   @db.VarChar(20)
  fileName     String?   @map("file_name") @db.VarChar(255)
  importedAt   DateTime  @default(now()) @map("imported_at")
  importedBy   String?   @map("imported_by")
  invoiceCount Int       @default(0) @map("invoice_count")
  taxTotal     Decimal   @default(0) @map("tax_total") @db.Decimal(14, 2)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  importer User?            @relation(fields: [importedBy], references: [id])
  rows     Gstr2bDocument[]

  /// One statement per period. Re-importing replaces it — the portal reissues
  /// 2B for a period and the latest download is the only one that counts.
  @@unique([tenantId, returnPeriod])
  @@index([tenantId, importedAt])
  @@map("gstr2b_imports")
}

/// One document out of a GSTR-2B statement — an invoice or a supplier's note.
model Gstr2bDocument {
  id               String    @id @default(uuid())
  importId         String    @map("import_id")
  tenantId         String    @map("tenant_id")
  returnPeriod     String    @map("return_period") @db.VarChar(6)
  supplierGstin    String    @map("supplier_gstin") @db.VarChar(15)
  supplierName     String?   @map("supplier_name") @db.VarChar(255)
  /// 'invoice' | 'credit_note' | 'debit_note'.
  documentType     String    @map("document_type") @db.VarChar(12)
  documentNumber   String    @map("document_number") @db.VarChar(60)
  /// Uppercased with punctuation stripped, so "SUP/001" matches "sup-001".
  matchKey         String    @map("match_key") @db.VarChar(60)
  documentDate     DateTime? @map("document_date")
  documentValue    Decimal   @default(0) @map("document_value") @db.Decimal(14, 2)
  taxableValue     Decimal   @default(0) @map("taxable_value") @db.Decimal(14, 2)
  igstAmount       Decimal   @default(0) @map("igst_amount") @db.Decimal(14, 2)
  cgstAmount       Decimal   @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount       Decimal   @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  cessAmount       Decimal   @default(0) @map("cess_amount") @db.Decimal(14, 2)
  taxAmount        Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  placeOfSupply    String?   @map("place_of_supply") @db.VarChar(2)
  /// The portal's own verdict. 'N' means the credit is blocked whatever we did.
  itcAvailable     Boolean   @default(true) @map("itc_available")
  itcBlockedReason String?   @map("itc_blocked_reason") @db.VarChar(255)
  supplierFiledOn  DateTime? @map("supplier_filed_on")
  createdAt        DateTime  @default(now()) @map("created_at")

  import Gstr2bImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([tenantId, returnPeriod])
  @@index([tenantId, supplierGstin, matchKey])
  @@map("gstr2b_documents")
}

// ============================================================
// GST document numbering
// ============================================================
// A GST invoice series must be unique and CONSECUTIVE for a financial year,
// per registered person, per document type. None of the five series this system
// already has satisfies that: they all reset daily and they are all shared
// across tenants, because bill_number is globally unique.
//
// So the invoice number is its own thing, allotted from a counter that is
// scoped exactly the way the law scopes it — one hospital, one document type,
// one financial year. The row IS the counter: `lastNumber` is incremented under
// a row lock, which is what makes the series gap-free even when two counters
// finalise at the same instant.
model GstDocumentSeries {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  /// 'tax_invoice' | 'bill_of_supply' | 'invoice_cum_bill_of_supply' | 'credit_note'
  documentType  String   @map("document_type") @db.VarChar(30)
  /// "2026-27".
  financialYear String   @map("financial_year") @db.VarChar(7)
  /// What the hospital wants printed, e.g. "GC/TI". Defaults per document type.
  prefix        String   @db.VarChar(24)
  lastNumber    Int      @default(0) @map("last_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, documentType, financialYear])
  @@map("gst_document_series")
}

// ============================================================
// Credit notes — the document a reversal is supposed to produce
// ============================================================
// Refunds, cancellations, returns and post-supply discounts all move money
// back, and until now not one of them reversed the TAX that moved with it. The
// output tax stayed declared on a supply that no longer happened, so the
// hospital kept owing the department money on a sale it had undone.
//
// A credit note is not a recalculation. It MIRRORS the lines it reverses —
// their codes, their rates, their split — scaled by how much came back and
// negated. Recomputing from today's master would produce a credit that does not
// equal its debit whenever a rate has moved since, and the residue would sit on
// the books with nothing to explain it.
model CreditNote {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  /// Its own continuous series, allotted the same way an invoice number is.
  creditNoteNumber String   @unique @map("credit_note_number") @db.VarChar(50)
  /// 'credit' or 'debit'. The same document with the sign the other way up:
  /// same series shape, same link to the original invoice, same line-level
  /// reversal, same section 34 time limit. A debit note is what a concession
  /// REDUCED after an invoice was issued needs — money going back ON to an
  /// issued invoice — and until now the system could not raise one.
  noteType         String   @default("credit") @map("note_type") @db.VarChar(8)
  /// The document being reversed. A credit note without one is not a credit note.
  billId           String   @map("bill_id")
  patientId        String?  @map("patient_id")
  issueDate        DateTime @map("issue_date")
  financialYear    String?  @map("financial_year") @db.VarChar(7)
  /// sales_return | cancellation | post_supply_discount | reversal | correction
  reason           String   @db.VarChar(40)
  reasonNote       String?  @map("reason_note")
  /// The money movement this note documents, where there was one.
  refundId         String?  @map("refund_id")
  drugReturnId     String?  @map("drug_return_id")

  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  cgstAmount   Decimal @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount   Decimal @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount   Decimal @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cessAmount   Decimal @default(0) @map("cess_amount") @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount  Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  /// Snapshots, like the invoice's — this note was issued under these details.
  supplierGstin          String? @map("supplier_gstin") @db.VarChar(15)
  placeOfSupplyStateCode String? @map("place_of_supply_state_code") @db.VarChar(2)
  recipientGstin         String? @map("recipient_gstin") @db.VarChar(15)
  /// A note raised after 30 November following the year end cannot reduce tax
  /// liability. The money still goes back; the tax simply cannot be recovered.
  withinTimeLimit        Boolean @default(true) @map("within_time_limit")

  // ── E-invoice ──
  // A note raised against a REGISTERED recipient is an e-invoice document in
  // its own right. Reported by D-1 and D-2 alongside the invoices, because a
  // register showing every B2B invoice registered while the notes reversing
  // them had never been sent would be complete-looking and wrong.
  irn            String?   @unique @db.VarChar(64)
  irnAckNo       String?   @map("irn_ack_no") @db.VarChar(30)
  irnAckDate     DateTime? @map("irn_ack_date")
  irnQrPayload   String?   @map("irn_qr_payload")
  irnStatus      String?   @map("irn_status") @db.VarChar(20)
  irnError       String?   @map("irn_error")
  irnAttemptedAt DateTime? @map("irn_attempted_at")

  issuedBy  String?  @map("issued_by")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  bill    Bill             @relation(fields: [billId], references: [id])
  patient Patient?         @relation(fields: [patientId], references: [id])
  issuer  User?            @relation(fields: [issuedBy], references: [id])
  items   CreditNoteItem[]

  @@index([tenantId, issueDate])
  @@index([billId])
  @@index([tenantId, irnStatus, issueDate])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String   @id @default(uuid())
  creditNoteId String   @map("credit_note_id")
  /// The line being reversed, so a partial credit can be traced to its debit.
  billItemId   String?  @map("bill_item_id")
  description  String   @db.VarChar(500)
  hsnSacCode   String?  @map("hsn_sac_code") @db.VarChar(20)
  gstTreatment String?  @map("gst_treatment") @db.VarChar(20)
  quantity     Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  taxableValue Decimal  @default(0) @map("taxable_value") @db.Decimal(12, 2)
  taxPercent   Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  cgstAmount   Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount   Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount   Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cessAmount   Decimal  @default(0) @map("cess_amount") @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  billItem   BillItem?  @relation(fields: [billItemId], references: [id])

  @@index([creditNoteId])
  @@map("credit_note_items")
}

// ============================================================
// Drug schedule reference (Drugs & Cosmetics Rules 1945 + NDPS Act)
// ============================================================
// Platform reference data — no tenantId, like HsnGstRate / ICD codes. Every row
// is ONE published rule: "this salt (or this brand) puts a product in this
// schedule". The classifier resolves a drug by running the statutory cascade
// H2-brand → X → H1 → H → G → OTC over a product's salts, then applies the NDPS
// rows as a SEPARATE OVERLAY.
//
// Two independent axes, deliberately not collapsed into one flag:
//   scheduleCode    — what the counter must collect (Rx, register, Rx copy)
//   controlledClass — which register/report the drug appears in
// Tramadol is Schedule H1 (CDSCO) AND a psychotropic (NDPS docx): it dispenses
// normally with an H1 register line and still shows in the controlled register.
// Collapsing those into one boolean is what would wrongly vault 26 SKUs.
model DrugScheduleRule {
  id           String   @id @default(uuid())
  // 'X' | 'H1' | 'H' | 'G' | 'H2' | 'NDPS'. NDPS rows are an overlay: they set
  // controlledClass/vault/threshold fields and never win the cascade themselves.
  scheduleCode String   @map("schedule_code") @db.VarChar(10)
  // 'salt'  — match a molecule in the product's composition (the normal case)
  // 'brand' — match the whole trade name (Schedule H2's 300 named formulations)
  // 'class' — a therapeutic-class entry ("Antibiotics", "Corticosteroids"),
  //           matched by `pattern` only AFTER every salt match has failed.
  matchType    String   @map("match_type") @db.VarChar(20)
  // As published in the schedule, for display and audit ("why was this X?").
  matchValue   String   @map("match_value") @db.VarChar(255)
  // Lookup key: lowercased, punctuation-stripped, trailing salt form removed, so
  // the schedule's "Chlorpheniramine" matches a product's "Chlorpheniramine
  // Maleate". Brand rows keep the full lowercased trade name.
  matchNorm    String   @map("match_norm") @db.VarChar(255)
  // Extra lookup keys: Indian labelling spellings (phenobarbitone/phenobarbital),
  // INN synonyms (paracetamol/acetaminophen), and the variants generated from
  // multi-salt entries ("Diclofenac Sodium/Potassium/Acid" → "diclofenac").
  aliases      String[] @default([])
  // Regex for matchType='class' only. Null for salt/brand rows.
  pattern      String?

  // ── NDPS overlay ──
  // 'none' | 'narcotic' | 'psychotropic' — drives register/report membership.
  controlledClass String? @map("controlled_class") @db.VarChar(20)
  isNarcotic      Boolean @default(false) @map("is_narcotic")
  // 'opioid' | 'benzodiazepine' | 'barbiturate' | 'cns_stimulant' | 'dissociative' | 'other'
  narcoticClass   String? @map("narcotic_class") @db.VarChar(40)
  // Physical safe custody + witness co-sign. False for the benzodiazepines and
  // tramadol/zolpidem, which are dispensed over the counter under their own
  // CDSCO schedule.
  vaultControlled Boolean @default(false) @map("vault_controlled")

  // ── Concentration exemption (the codeine decision tree) ──
  // When the product is a COMBINATION and the molecule stays within both limits,
  // it falls back to `fallbackSchedule` instead of full NDPS control. A
  // single-ingredient preparation is never exempt, and an unknown strength fails
  // safe to full NDPS.
  exemptIfCombination     Boolean  @default(false) @map("exempt_if_combination")
  maxPerUnitMg            Decimal? @map("max_per_unit_mg") @db.Decimal(10, 3)
  maxConcentrationPercent Decimal? @map("max_concentration_percent") @db.Decimal(6, 3)
  fallbackSchedule        String?  @map("fallback_schedule") @db.VarChar(10)

  // Schedule G's own Note: preparations intended for topical/external use are
  // NOT covered, so a topical hit resolves to OTC.
  topicalExempt Boolean @default(false) @map("topical_exempt")

  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([scheduleCode, matchType, matchNorm])
  @@index([matchNorm])
  @@index([matchType, isActive])
  @@map("drug_schedule_rules")
}

// ============================================================
// Salt master — the structured replacement for classifying by string
// ============================================================
// A drug's composition used to live only as text, and its schedule was decided
// by parsing that text and matching it against DrugScheduleRule by name on every
// classification. Three fragile steps stacked — parse, normalise, match — and
// most of the classifier's bugs came from that stack: a flavour name ("American
// Ice Cream") read as a topical preparation, strengths destroyed by a lossy
// round-trip, "Diclofenac Sodium/Potassium/Acid" failing to match plain
// Diclofenac.
//
// The catalog turns out to hold only 1,685 distinct molecules across 253,987
// products and 367,027 salt occurrences — small enough to curate by hand. So the
// molecule becomes a row, the schedule becomes a column on it, and deciding a
// product's schedule becomes a join instead of a string comparison.
//
// Parsing does not disappear; it moves to INGESTION. Text is turned into DrugSalt
// rows once when a drug is imported, and never re-parsed afterwards.
//
// Salt is the source of truth for salt-level schedules. DrugScheduleRule keeps
// only what is not a molecule: the 300 Schedule H2 brand formulations and the 6
// therapeutic-class entries.
model Salt {
  id   String @id @default(uuid())
  /// Canonical INN-style name as it should be displayed: "Chlorpheniramine".
  name String @unique @db.VarChar(255)
  /// Lookup key — lowercased, punctuation-free, trailing salt form removed. Used
  /// only at ingestion to resolve text to a row, never at classification.
  norm String @unique @db.VarChar(255)

  // ── What the counter must collect ──
  /// 'X' | 'H1' | 'H' | 'G' | 'OTC'. NULL means NOBODY HAS DECIDED YET — which is
  /// the point: an unmapped molecule becomes a visible work queue instead of
  /// silently reading over-the-counter, which is how warfarin, rosuvastatin and
  /// pregabalin sat unscheduled without anyone noticing.
  scheduleCode String? @map("schedule_code") @db.VarChar(10)

  // ── NDPS overlay: a second, independent axis (see DrugScheduleRule) ──
  controlledClass String? @map("controlled_class") @db.VarChar(20)
  narcoticClass   String? @map("narcotic_class") @db.VarChar(40)
  vaultControlled Boolean @default(false) @map("vault_controlled")

  // ── The codeine concentration exemption, unchanged in meaning ──
  exemptIfCombination     Boolean  @default(false) @map("exempt_if_combination")
  maxPerUnitMg            Decimal? @map("max_per_unit_mg") @db.Decimal(10, 3)
  maxConcentrationPercent Decimal? @map("max_concentration_percent") @db.Decimal(6, 3)
  fallbackSchedule        String?  @map("fallback_schedule") @db.VarChar(10)

  /// Schedule G's own Note — topical/external preparations are not covered.
  topicalExempt Boolean @default(false) @map("topical_exempt")

  /// Where the schedule came from: 'cdsco' (migrated from the published lists),
  /// 'class' (inherited from a therapeutic class), 'manual' (a human decided).
  /// A manual decision is never overwritten by a re-seed.
  source       String?   @map("source") @db.VarChar(20)
  /// Free text for the audit trail — why this molecule sits where it does.
  scheduleNote String?   @map("schedule_note")
  /// Plain column, no relation — same convention as
  /// DrugFormulary.scheduleOverriddenById, which keeps User free of a
  /// back-relation for every audit field in the schema.
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  synonyms  SaltSynonym[]
  classes   SaltTherapeuticClass[]
  drugSalts DrugSalt[]

  @@index([scheduleCode])
  @@index([controlledClass])
  @@map("salts")
}

/// Alternate spellings for one molecule. 29 of the 1,685 are written more than
/// one way in the catalog — "Paracetamol/Acetaminophen", "Metoprolol Succinate"
/// vs "Metoprolol Tartrate" — plus the Indian labelling spellings
/// (phenobarbitone/phenobarbital) that a plain match would miss.
model SaltSynonym {
  id     String @id @default(uuid())
  saltId String @map("salt_id")
  name   String @db.VarChar(255)
  /// Normalised form. Unique across ALL synonyms so one spelling can never
  /// resolve to two different molecules.
  norm   String @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  salt Salt @relation(fields: [saltId], references: [id], onDelete: Cascade)

  @@index([saltId])
  @@map("salt_synonyms")
}

/// The Schedule H entries that name a CATEGORY rather than a molecule —
/// "Antibiotics" is item 32 of Schedule H in those words. There are 6. They stay
/// separate from Salt because a molecule can belong to one without being named
/// individually anywhere.
model TherapeuticClass {
  id           String  @id @default(uuid())
  name         String  @unique @db.VarChar(255)
  scheduleCode String  @map("schedule_code") @db.VarChar(10)
  /// Regex used at INGESTION to propose a class for a new molecule. A human
  /// confirms it; the classifier never runs this.
  pattern      String?
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")

  salts SaltTherapeuticClass[]

  @@map("therapeutic_classes")
}

model SaltTherapeuticClass {
  saltId      String  @map("salt_id")
  classId     String  @map("class_id")
  /// True when a human confirmed the membership rather than the pattern guessing.
  isConfirmed Boolean @default(false) @map("is_confirmed")

  salt  Salt             @relation(fields: [saltId], references: [id], onDelete: Cascade)
  class TherapeuticClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([saltId, classId])
  @@index([classId])
  @@map("salt_therapeutic_classes")
}

/// One molecule inside one catalog product, with its strength as DATA.
///
/// The strength is split into typed columns on purpose. Held as text it was
/// destroyed by a lossy round-trip through the composition column — 246,485 rows
/// lost their strengths, which broke the one rule that needs them — and "500mg"
/// against "500ml" could drift silently. A number and a unit cannot.
model DrugSalt {
  id           String @id @default(uuid())
  drugMasterId String @map("drug_master_id")
  saltId       String @map("salt_id")

  /// 400 in "400mg". Null when the catalog recorded "(NA)".
  strengthValue  Decimal? @map("strength_value") @db.Decimal(12, 4)
  /// 'mg' | 'mcg' | 'g' | 'ml' | 'iu' | '%'
  strengthUnit   String?  @map("strength_unit") @db.VarChar(10)
  /// For "10mg/5ml" this is 5 — the volume the strength is expressed per.
  perVolumeValue Decimal? @map("per_volume_value") @db.Decimal(12, 4)
  perVolumeUnit  String?  @map("per_volume_unit") @db.VarChar(10)

  /// Order within the composition, so it can be rendered back in the original
  /// sequence without storing the text.
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  drugMaster DrugMaster @relation(fields: [drugMasterId], references: [id], onDelete: Cascade)
  salt       Salt       @relation(fields: [saltId], references: [id], onDelete: Cascade)

  @@unique([drugMasterId, saltId])
  @@index([saltId])
  @@map("drug_salts")
}

// ============================================================
// NDPS Narcotic Accounting (spec — Essential Narcotic Drug lifecycle)
// ============================================================
// Indian drug inspectors cross-reference physical narcotic stock against the
// statutory Form 3C (incoming consignments), Form 3E (patient-wise consumption)
// and Form 3H (daily account). These models give every Essential Narcotic Drug
// a continuous, location-aware chain of custody from the Central Vault to the
// patient's bedside, with dual-authentication on every hand-off.

/// A narcotic stock location — the Central Vault or a sub-store cart (ICU, OT).
model NdpsLocation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   @db.VarChar(120)
  type      String   @default("sub_store") // 'main_vault' | 'sub_store'
  wardId    String?  @map("ward_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  balances NdpsStockBalance[]

  @@unique([tenantId, name])
  @@map("ndps_locations")
}

/// Live narcotic quantity per drug × location (drives the Inspector's "where are
/// the vials" breakdown and guards transfers/dispenses from over-drawing).
model NdpsStockBalance {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  drugFormularyId String   @map("drug_formulary_id")
  locationId      String   @map("location_id")
  quantity        Int      @default(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  drug     DrugFormulary @relation(fields: [drugFormularyId], references: [id])
  location NdpsLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, drugFormularyId, locationId])
  @@map("ndps_stock_balances")
}

/// The master NDPS register. Every row is one statutory event — an inward
/// consignment (Form 3C), a vault→sub-store transfer (Internal Delivery Challan),
/// a patient consumption (Form 3E) or a broken/spoiled disposal — carrying the
/// fields each form mandates. from/to locations are plain ids resolved against
/// NdpsLocation (kept relation-free so the ledger never blocks a location edit).
model NdpsTransaction {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  drugFormularyId      String    @map("drug_formulary_id")
  entryType            String    @map("entry_type") // 'inward' | 'transfer' | 'dispense' | 'disposal'
  quantity             Int
  fromLocationId       String?   @map("from_location_id")
  toLocationId         String?   @map("to_location_id")
  // Form 3C (procurement) — consignment provenance.
  ndpsLicenseNumber    String?   @map("ndps_license_number") @db.VarChar(120)
  form3cNumber         String?   @map("form_3c_number") @db.VarChar(120)
  transportDetails     String?   @map("transport_details")
  grossWeight          String?   @map("gross_weight") @db.VarChar(60)
  supplierId           String?   @map("supplier_id")
  batchNumber          String?   @map("batch_number") @db.VarChar(100)
  expiryDate           DateTime? @map("expiry_date") @db.Date
  // The real stock batch this statutory entry moved. Narcotic stock used to live
  // in a ledger of its own, invisible to valuation, expiry alerts, recalls and
  // GST; it now sits in DrugBatch like every other medicine, and this points at
  // the batch so the register and the stock agree line for line.
  drugBatchId          String?   @map("drug_batch_id")
  // Form 3E (patient consumption) — mandatory audit fields.
  patientId            String?   @map("patient_id")
  doctorRegNo          String?   @map("doctor_reg_no") @db.VarChar(60)
  bedNumber            String?   @map("bed_number") @db.VarChar(40)
  diagnosis            String?
  // Disposal — non-clinical loss accounting.
  reasonCode           String?   @map("reason_code") @db.VarChar(40) // 'breakage' | 'contamination' | 'expiry' | 'other'
  referenceNumber      String?   @map("reference_number") @db.VarChar(120) // police complaint / destruction memo
  attachmentUrl        String?   @map("attachment_url")
  coSignById           String?   @map("co_sign_by_id")
  // Patient-dose traceability. These fields are populated by the eMAR residual
  // workflow and remain null for historical/manual Form 3E and stock-disposal
  // entries. `quantity` continues to mean physical containers for Form 3H;
  // the decimal fields capture the contents administered and left over.
  patientDoseId        String?   @map("patient_dose_id")
  emarScheduleId       String?   @map("emar_schedule_id")
  dispensingRecordId   String?   @map("dispensing_record_id")
  labelledQuantity     Decimal?  @map("labelled_quantity") @db.Decimal(14, 4)
  administeredQuantity Decimal?  @map("administered_quantity") @db.Decimal(14, 4)
  residualQuantity     Decimal?  @map("residual_quantity") @db.Decimal(14, 4)
  quantityUnit         String?   @map("quantity_unit") @db.VarChar(20)
  residualDisposition  String?   @map("residual_disposition") @db.VarChar(30)
  // pending_destruction | sealed_quarantine. This is the bedside instruction,
  // not proof of final destruction.
  residualHandling     String?   @map("residual_handling") @db.VarChar(30)
  // Which canonical stock movement already accounts for the container:
  // dispensing_record | ward_stock | drug_batch | residual_only.
  stockSource          String?   @map("stock_source") @db.VarChar(30)
  // Chain of custody — who recorded it + the counterparty who received it.
  recordedById         String    @map("recorded_by_id")
  counterpartyId       String?   @map("counterparty_id")
  notes                String?
  occurredAt           DateTime  @default(now()) @map("occurred_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  drug   DrugFormulary @relation(fields: [drugFormularyId], references: [id])

  @@index([tenantId, entryType, occurredAt])
  @@index([drugBatchId])
  @@index([patientDoseId])
  @@index([emarScheduleId])
  @@index([tenantId, drugFormularyId, occurredAt])
  @@map("ndps_transactions")
}

/// One immutable quantity reconciliation for a narcotic container opened for a
/// patient. The eMAR schedule owns the clinical event; this row owns the
/// labelled/administered/residual arithmetic and the residual's final custody.
/// A quarantined row remains visible in the pending worklist until a witnessed
/// disposal changes it to destroyed. Opened residuals never return to stock.
model NdpsPatientDose {
  id                          String    @id @default(uuid())
  tenantId                    String    @map("tenant_id")
  emarScheduleId              String    @unique @map("emar_schedule_id")
  prescriptionItemId          String    @map("prescription_item_id")
  patientId                   String    @map("patient_id")
  admissionId                 String?   @map("admission_id")
  drugFormularyId             String    @map("drug_formulary_id")
  drugBatchId                 String    @map("drug_batch_id")
  dispensingRecordId          String?   @map("dispensing_record_id")
  ndpsLocationId              String    @map("ndps_location_id")
  administrationTransactionId String    @unique @map("administration_transaction_id")
  disposalTransactionId       String?   @unique @map("disposal_transaction_id")
  labelledQuantity            Decimal   @map("labelled_quantity") @db.Decimal(14, 4)
  administeredQuantity        Decimal   @map("administered_quantity") @db.Decimal(14, 4)
  residualQuantity            Decimal   @map("residual_quantity") @db.Decimal(14, 4)
  quantityUnit                String    @map("quantity_unit") @db.VarChar(20)
  containerQuantity           Int       @default(1) @map("container_quantity")
  // fully_administered | destroyed | quarantined
  status                      String    @db.VarChar(30)
  // none | destroyed | quarantined
  disposition                 String    @db.VarChar(30)
  // pending_destruction | sealed_quarantine (null when no remainder exists)
  residualHandling            String?   @map("residual_handling") @db.VarChar(30)
  stockSource                 String    @map("stock_source") @db.VarChar(30)
  emergencyUse                Boolean   @default(false) @map("emergency_use")
  emergencyReason             String?   @map("emergency_reason")
  administeredById            String    @map("administered_by_id")
  administeredAt              DateTime  @map("administered_at")
  witnessedById               String?   @map("witnessed_by_id")
  witnessedAt                 DateTime? @map("witnessed_at")
  disposalMethod              String?   @map("disposal_method") @db.VarChar(160)
  quarantineLocation          String?   @map("quarantine_location") @db.VarChar(160)
  quarantinedAt               DateTime? @map("quarantined_at")
  destroyedAt                 DateTime? @map("destroyed_at")
  billId                      String?   @map("bill_id")
  notes                       String?
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at")

  schedule EmarSchedule @relation(fields: [emarScheduleId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId, administeredAt])
  @@index([drugBatchId])
  @@index([ndpsLocationId])
  @@map("ndps_patient_doses")
}

/// Form 3H — the daily account. A nightly cutoff hard-writes one row per narcotic
/// drug: opening + received − dispensed − disposed = closing, which the
/// pharmacist signs against a physical count the next morning.
model NdpsDailyBalance {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  drugFormularyId String   @map("drug_formulary_id")
  date            DateTime @db.Date
  openingBalance  Int      @map("opening_balance")
  received        Int      @default(0)
  dispensed       Int      @default(0)
  disposed        Int      @default(0)
  closingBalance  Int      @map("closing_balance")
  physicalCount   Int?     @map("physical_count")
  isVerified      Boolean  @default(false) @map("is_verified")
  verifiedById    String?  @map("verified_by_id")
  closedAt        DateTime @default(now()) @map("closed_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  drug   DrugFormulary @relation(fields: [drugFormularyId], references: [id])

  @@unique([tenantId, drugFormularyId, date])
  @@map("ndps_daily_balances")
}

// ============================================================
// Outside (paper) prescriptions
// ============================================================
// A pharmacy counter serves walk-ins as well as this hospital's own patients,
// and a walk-in arrives holding a paper prescription written somewhere else.
// There is no in-system Prescription to point at, so this records the paper one:
// who prescribed it, their council registration number, when, and a scan of the
// slip.
//
// It exists BEFORE any schedule is enforced on purpose. The moment a Schedule
// H/H1/X sale starts requiring a prescription, a walk-in with a valid paper Rx
// must still have a lawful path through the counter — otherwise switching
// enforcement on would block legitimate sales rather than illegitimate ones.
//
// Kept separate from Prescription rather than made nullable inside it: a
// Prescription is a clinical record this hospital authored and is responsible
// for, while this is evidence a patient presented. Merging them would put
// unverified outside data into the clinical record.
model ExternalPrescription {
  id                      String    @id @default(uuid())
  tenantId                String    @map("tenant_id")
  // Set when the counter recognised the customer as an existing patient. Null
  // for a true walk-in, whose identity lives in the raw fields below.
  patientId               String?   @map("patient_id")
  patientNameRaw          String?   @map("patient_name_raw") @db.VarChar(255)
  patientAge              Int?      @map("patient_age")
  patientSex              String?   @map("patient_sex") @db.VarChar(20)
  // The Schedule H1 register must record the patient's ADDRESS, which we hold
  // nowhere else for a walk-in.
  patientAddress          String?   @map("patient_address")
  // The prescriber. The registration number is what makes the prescription
  // verifiable, so it is captured separately from the name.
  prescriberName          String    @map("prescriber_name") @db.VarChar(255)
  prescriberRegNo         String?   @map("prescriber_reg_no") @db.VarChar(60)
  prescriberQualification String?   @map("prescriber_qualification") @db.VarChar(120)
  hospitalName            String?   @map("hospital_name") @db.VarChar(255)
  prescribedDate          DateTime? @map("prescribed_date") @db.Date
  // Scan/photo of the slip. Schedule X requires the pharmacy to RETAIN a copy,
  // so for those sales this is the retained copy and is mandatory.
  imageUrl                String?   @map("image_url")
  // Raw OCR output, kept so a later correction can be checked against what the
  // machine actually read rather than re-running it.
  ocrJson                 Json?     @map("ocr_json")
  notes                   String?
  capturedById            String    @map("captured_by_id")
  // Statutory retention: +2 years for Schedule X, +3 for H1. Stored per row so a
  // purge job never has to re-derive it from the sale.
  retainUntil             DateTime? @map("retain_until") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  patient           Patient?           @relation(fields: [patientId], references: [id])
  dispensingRecords DispensingRecord[]

  @@index([tenantId, createdAt])
  @@index([tenantId, prescriberRegNo])
  @@map("external_prescriptions")
}

// ============================================================
// OP pre-packing — "Stock Hold" / "Pre-Packed" (spec OP Step 1)
// ============================================================
// The pharmacy pre-packs a digital prescription before the patient arrives: the
// stock is deducted from the Available-to-Sell pool (reserved against the chosen
// batch) but NOT billed. On collection it is converted to a paid sale; if the
// patient never shows, the hold is released and the stock returns to the pool.
model PharmacyStockHold {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  patientId      String?   @map("patient_id")
  prescriptionId String?   @map("prescription_id")
  status         String    @default("held") // 'held' | 'collected' | 'released'
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  collectedAt    DateTime? @map("collected_at")
  releasedAt     DateTime? @map("released_at")
  billId         String?   @map("bill_id")
  notes          String?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id])
  patient Patient?                @relation(fields: [patientId], references: [id])
  items   PharmacyStockHoldItem[]

  @@index([tenantId, status])
  @@map("pharmacy_stock_holds")
}

model PharmacyStockHoldItem {
  id              String   @id @default(uuid())
  holdId          String   @map("hold_id")
  drugFormularyId String   @map("drug_formulary_id")
  drugBatchId     String   @map("drug_batch_id")
  quantity        Int // base units held
  saleUnit        String   @default("pack") @map("sale_unit") @db.VarChar(10)
  unitPrice       Decimal? @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal? @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent      Decimal? @default(0) @map("tax_percent") @db.Decimal(5, 2)

  hold      PharmacyStockHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  drug      DrugFormulary     @relation(fields: [drugFormularyId], references: [id])
  drugBatch DrugBatch         @relation(fields: [drugBatchId], references: [id])

  @@map("pharmacy_stock_hold_items")
}

model DrugFormulary {
  id                     String            @id @default(uuid())
  tenantId               String            @map("tenant_id")
  drugName               String            @map("drug_name") @db.VarChar(255)
  // genericName may hold ONE or MORE generic/molecule names (comma-separated
  // when a brand maps to several). `composition` is the salt composition, a
  // separate concept — sometimes identical to the generic name, sometimes not.
  // composition is written/read via raw SQL (added live, migration-free).
  genericName            String?           @map("generic_name") @db.VarChar(500)
  composition            String?           @map("composition") @db.VarChar(500)
  manufacturer           String?           @db.VarChar(255)
  // What KIND of stock this is. Every type (medicine, consumable, surgical,
  // equipment, other) lives here so they all share one flow: batches, expiry,
  // search and counter billing. Only category = `drug` is prescribable or enters
  // clinical classification; defaults to `drug` (medicine).
  category               InventoryCategory @default(drug)
  // The shelf a retail product sits on ("Baby Care", "Vitamins & Supplements").
  // Only meaningful when category = product; medicines are grouped by their
  // composition and schedule instead. Free text, prefilled from the catalogue's
  // own product category when the product was picked from it.
  productCategory        String?           @map("product_category") @db.VarChar(120)
  dosageForm             DosageForm?       @map("dosage_form")
  strength               String?           @db.VarChar(100)
  // Primary purchase/packaging unit with its UQC label, e.g. "Strip (UQC PAC)".
  unitOfMeasurement      String?           @map("unit_of_measurement") @db.VarChar(20)
  price                  Decimal?          @db.Decimal(10, 2)
  // Loose / sub-unit sale support. packSize = number of base (loose) units in a
  // full pack/strip (e.g. 10 tablets per strip). looseUnitLabel = the sellable
  // sub-unit name shown on the POS (e.g. "Tablet"). When packSize is null/1 the
  // drug is only sold as a single unit. Stock + price are always per BASE unit.
  packSize               Int?              @map("pack_size")
  looseUnitLabel         String?           @map("loose_unit_label") @db.VarChar(40)
  // GST rate applied to this drug (India medicine = 0/5/12/18%). Prices are MRP
  // (tax-inclusive), so the bill shows the GST breakup rather than adding on top.
  taxPercent             Decimal?          @map("tax_percent") @db.Decimal(5, 2)
  // Product Resolution Engine / barcode identity carried from DrugMaster on
  // import (or set on manual create). gtin = consumer-unit GTIN-13 used to
  // resolve an inward line and to look the drug up from a POS scan; casePackGtin
  // (GTIN-14) + unitsPerCase let a scanned outer case post N consumer units.
  gtin                   String?           @db.VarChar(20)
  casePackGtin           String?           @map("case_pack_gtin") @db.VarChar(20)
  unitsPerCase           Int?              @map("units_per_case")
  manufacturerCode       String?           @map("manufacturer_code") @db.VarChar(100)
  hsnCode                String?           @map("hsn_code") @db.VarChar(20)
  // Null = resolve from HSN. Set only for a product-specific exception such as
  // exempt / nil-rated / non-GST, or an authorised item-level override.
  gstTreatment           String?           @map("gst_treatment") @db.VarChar(20)
  gstTreatmentSource     String?           @map("gst_treatment_source") @db.VarChar(20)
  gstClassifierVersion   Int?              @map("gst_classifier_version")
  // G9: reorder level (in base units). When live stock falls to/below this, the
  // drug surfaces in the reorder list for a draft purchase order.
  minStock               Int?              @map("min_stock")
  indications            String?
  contraindications      String?
  isActive               Boolean           @default(true) @map("is_active")
  // NOTE: recall is batch-level only (see DrugBatch.isRecalled / recallReason).
  // A medicine is never recalled as a whole — a recall names a specific batch.
  // Vital / life-saving drug. Per the IP design doc, the credit-clearance gate
  // (cash patient over deposit) is bypassed for these so emergency dosing is
  // never withheld for money. Defaults to false.
  isLifeSaving           Boolean           @default(false) @map("is_life_saving")
  // NDPS Essential Narcotic Drug — when true this drug is governed by the
  // narcotic accounting workflow (Form 3C/3E/3H, vault custody, dual-auth).
  // Five dispensing paths throw on this flag, so it is NOT written by the
  // classifier: it stays hospital-controlled until the inline controlled-drug
  // flow lands. `controlledClass` + `vaultControlled` below carry the
  // classifier's opinion without changing any existing behaviour.
  isNarcotic             Boolean           @default(false) @map("is_narcotic")
  // ── Resolved by the schedule classifier ──
  // 'X' | 'H1' | 'H' | 'G' | 'H2' | 'OTC'. Null = not yet classified.
  schedule               String?           @db.VarChar(10)
  // 'auto'      — the classifier decided it from this drug's own composition
  // 'inherited' — copied from the linked DrugMaster catalog row
  // 'manual'    — a pharmacy admin overrode it; a re-run must never overwrite it
  scheduleSource         String?           @map("schedule_source") @db.VarChar(20)
  scheduleReason         String?           @map("schedule_reason")
  scheduleOverriddenById String?           @map("schedule_overridden_by_id")
  scheduleOverriddenAt   DateTime?         @map("schedule_overridden_at")
  // NDPS overlay: 'narcotic' | 'psychotropic'. Drives which statutory register
  // and report the drug appears in — separate from what the counter collects.
  controlledClass        String?           @map("controlled_class") @db.VarChar(20)
  vaultControlled        Boolean           @default(false) @map("vault_controlled")
  requiresQrScan         Boolean           @default(false) @map("requires_qr_scan")
  saltsJson              Json?             @map("salts_json")
  classifiedAt           DateTime?         @map("classified_at")
  classifierVersion      Int?              @map("classifier_version")
  // TPA/cashless reimbursability. Most drugs are reimbursable; disposables and
  // certain consumables (syringes, gloves) are billed to the patient out-of-
  // pocket. Drives the Reimbursable vs Non-Reimbursable split on the IP summary.
  isReimbursable         Boolean           @default(true) @map("is_reimbursable")
  // Provenance: set when this formulary row was imported from the platform
  // DrugMaster catalog (vs. hospital-authored). Drives import dedupe.
  drugMasterId           String?           @map("drug_master_id")
  // Additive unification link: optionally maps this pharmacy drug to the generic
  // inventory item that represents the same product, so the combined Inventory
  // page can treat the two stock systems as one (and de-duplicate SKU counts).
  // Nullable — the default is unmapped, which leaves both systems untouched.
  inventoryItemId        String?           @map("inventory_item_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant                      Tenant                  @relation(fields: [tenantId], references: [id])
  drugMaster                  DrugMaster?             @relation(fields: [drugMasterId], references: [id])
  inventoryItem               InventoryItem?          @relation("FormularyInventoryLink", fields: [inventoryItemId], references: [id])
  drugBatches                 DrugBatch[]
  prescriptionItems           PrescriptionItem[]
  drugReturns                 DrugReturn[]
  purchaseOrderItems          DrugPurchaseOrderItem[]
  inventoryPurchaseOrderItems PurchaseOrderItem[]
  ndpsBalances                NdpsStockBalance[]
  ndpsTransactions            NdpsTransaction[]
  ndpsDailyBalances           NdpsDailyBalance[]
  stockHoldItems              PharmacyStockHoldItem[]
  nameMappings                DrugNameMapping[]

  // A GTIN identifies one product, so within a hospital's formulary it belongs
  // to at most one drug (else a counter/inward scan is ambiguous). Scoped per
  // tenant — two hospitals can each stock the same product. Nulls repeat freely;
  // writes normalise a blank to NULL so empty fields never collide.
  @@unique([tenantId, gtin])
  @@unique([tenantId, casePackGtin])
  // Drive the catalog schedule filter and the controlled-drug reports.
  @@index([tenantId, schedule])
  @@index([tenantId, controlledClass])
  // Deleting a catalogue row has to find the formulary rows that point at it
  // (the FK sets them null). Without this every one of those lookups is a
  // sequential scan, and a catalogue release retires a quarter of a million
  // rows at once.
  @@index([drugMasterId])
  @@map("drug_formulary")
}

/// Learned stock-entry mapping: when a pharmacist confirms that an incoming
/// vendor/invoice product name resolves to a particular formulary drug, we
/// remember it here. On the next stock entry the same incoming name auto-maps to
/// the same drug by default (the pharmacist can still choose another). Scoped per
/// tenant; the normalised incoming name is unique so the newest choice wins.
model DrugNameMapping {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  incomingNameNorm String   @map("incoming_name_norm") @db.VarChar(255)
  drugFormularyId  String   @map("drug_formulary_id")
  // Last-seen raw incoming name, for display/debugging.
  incomingNameRaw  String?  @map("incoming_name_raw") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  drug   DrugFormulary @relation(fields: [drugFormularyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, incomingNameNorm])
  @@index([tenantId])
  @@index([drugFormularyId])
  @@map("drug_name_mappings")
}

model DrugBatch {
  id                      String    @id @default(uuid())
  drugId                  String    @map("drug_id")
  tenantId                String    @map("tenant_id")
  batchNumber             String    @map("batch_number") @db.VarChar(100)
  manufacturingDate       DateTime? @map("manufacturing_date") @db.Date
  expiryDate              DateTime  @map("expiry_date") @db.Date
  supplierId              String?   @map("supplier_id")
  // Purchase economics captured at inward (G2 — separate fields so the GRN can
  // show MRP, purchase rate, discount and GST distinctly). purchasePrice is the
  // per-unit purchase RATE (gross, before discount); the net purchase price and
  // landing cost are derived from rate + discount. All monetary values stored on
  // a batch are canonical PER-BASE-UNIT values; Add Stock converts a printed
  // package/strip MRP before persistence when priceBasis = package.
  mrp                     Decimal?  @map("mrp") @db.Decimal(10, 2)
  purchaseDiscountPercent Decimal?  @map("purchase_discount_percent") @db.Decimal(5, 2)
  gstPercent              Decimal?  @map("gst_percent") @db.Decimal(5, 2)
  /// Whether the input credit on this purchase can be claimed:
  /// 'eligible' | 'ineligible' | 'partly'.
  ///
  /// Section 17(5) blocks credit outright on some supplies, and a hospital's
  /// commonest case is the room-rent notification: 5% on non-ICU rent above
  /// Rs 5,000 comes explicitly WITHOUT input tax credit. Without this column
  /// report B-2 could only ever show GROSS credit, which is the rung of the
  /// ladder that flatters the hospital.
  itcEligibility          String    @default("eligible") @map("itc_eligibility") @db.VarChar(12)
  itcBlockedReason        String?   @map("itc_blocked_reason") @db.VarChar(255)
  /// The head-wise split actually paid on the supplier's invoice. Derivable
  /// from the rate under the assumption the purchase was intra-state — which
  /// stops being true the moment a hospital buys from another state.
  inputCgst               Decimal?  @map("input_cgst") @db.Decimal(12, 2)
  inputSgst               Decimal?  @map("input_sgst") @db.Decimal(12, 2)
  inputIgst               Decimal?  @map("input_igst") @db.Decimal(12, 2)
  // Free units received on top of the paid quantity (e.g. buy 100 get 10). They
  // count toward stock but not toward purchase value.
  freeQuantity            Int       @default(0) @map("free_quantity")
  // GRN invoice traceability (design-doc manual GRN Steps 1/8/9). Captured per
  // batch so the purchase report shows the source invoice and a re-entry of the
  // same supplier+invoice line can be flagged as a duplicate.
  invoiceNumber           String?   @map("invoice_number") @db.VarChar(100)
  invoiceDate             DateTime? @map("invoice_date") @db.Date
  purchasePrice           Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice            Decimal?  @map("selling_price") @db.Decimal(10, 2)
  quantityReceived        Int       @map("quantity_received")
  quantityInStock         Int       @map("quantity_in_stock")
  isExpired               Boolean   @default(false) @map("is_expired")
  isRecalled              Boolean   @default(false) @map("is_recalled")
  recallReason            String?   @map("recall_reason")
  // Barcode-driven traceability (spec Section 2). barcode is the scannable code
  // for THIS batch — an internal Code-128 minted at inward when the pack carries
  // no GS1 DataMatrix, so one scan resolves drug + batch + expiry.
  barcode                 String?   @map("barcode") @db.VarChar(64)
  // GS1 DataMatrix serial (AI 21) captured at receipt for track-and-trace.
  serialNumber            String?   @map("serial_number") @db.VarChar(80)
  // Where this batch physically sits — "Rack A3 / Shelf 2", "Cold room".
  // Deliberately NOT encoded into the printed barcode: it is the one label field
  // that changes (ward transfers, re-racking), so an encoded copy would start
  // lying the moment stock moves. Printed as text and resolved live on scan, so
  // a picker is always told where the stock actually is.
  storageLocation         String?   @map("storage_location") @db.VarChar(100)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  drug              DrugFormulary           @relation(fields: [drugId], references: [id])
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])
  dispensingRecords DispensingRecord[]
  drugReturns       DrugReturn[]
  stockTransfers    StockTransfer[]
  stockHoldItems    PharmacyStockHoldItem[]

  @@index([tenantId, barcode])
  @@map("drug_batches")
}

model DispensingRecord {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  // Nullable so the POS can record a walk-in / OTC counter sale that is NOT
  // tied to any doctor prescription. When present, the Rx status is recomputed.
  prescriptionId         String?   @map("prescription_id")
  prescriptionItemId     String?   @map("prescription_item_id")
  // The OTHER way a sale can be prescription-backed: a paper Rx written outside
  // this hospital, captured at the counter. A line carries at most one of the
  // two — an in-system prescription or an external one.
  externalPrescriptionId String?   @map("external_prescription_id")
  patientId              String    @map("patient_id")
  drugBatchId            String    @map("drug_batch_id")
  quantityDispensed      Int       @map("quantity_dispensed")
  dispensedBy            String    @map("dispensed_by")
  dispensedAt            DateTime  @default(now()) @map("dispensed_at")
  verifiedBy             String?   @map("verified_by")
  // The code read off the pack for a Schedule H2 formulation — the Rule
  // 96(6)-(7) QR/barcode that says the pack is genuine. Nullable because most
  // drugs are not on that list, and because the obligation is advisory until a
  // hospital sets qrScanMode to 'require'. Kept so the sale can be evidenced
  // later, which is the only thing that makes the scan worth asking for.
  scannedCode            String?   @map("scanned_code") @db.VarChar(120)
  notes                  String?
  // Sale economics captured at dispense time so the cash counter, receipt and
  // GST report read the true billed figures (not a re-derived batch price).
  // sold = pack | loose (loose = sub-unit broken out of a strip/pack).
  saleUnit               String?   @default("pack") @map("sale_unit") @db.VarChar(10)
  unitPrice              Decimal?  @map("unit_price") @db.Decimal(12, 2)
  discountPercent        Decimal?  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxPercent             Decimal?  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  lineTotal              Decimal?  @map("line_total") @db.Decimal(12, 2)
  // §4.4: a line marked non-returnable on the bill at sale time (e.g. opened
  // vial, cold-chain item) can never be taken back as a patient return.
  nonReturnable          Boolean   @default(false) @map("non_returnable")
  // TTO (To Take Out) — discharge medication dispensed in full packs and added
  // to the final hospital bill, vs. routine daily IP unit-dose drops.
  isTto                  Boolean   @default(false) @map("is_tto")
  // Invoice this line was billed on (the pharmacy Bill). Plain column — the
  // canonical link is BillItem.referenceId; this is a convenience back-pointer.
  billId                 String?   @map("bill_id")
  // Controlled-drug co-sign. Set when the line required a second authenticated
  // person to witness the hand-over (vault narcotics). Always a different user
  // from `dispensedBy` — a witness who is the dispenser is not a witness.
  witnessedById          String?   @map("witnessed_by_id")
  witnessedAt            DateTime? @map("witnessed_at")
  // Voided with its invoice. The row is KEPT rather than deleted: it is the
  // controlled-drug register's record that this medicine left the counter, and
  // a statutory register is corrected by a further entry, never by erasing one.
  // Everything that counts what was dispensed excludes these; the register
  // shows them, alongside a reversal row putting the stock back.
  cancelledAt            DateTime? @map("cancelled_at")
  cancelledBy            String?   @map("cancelled_by")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  prescription         Prescription?         @relation(fields: [prescriptionId], references: [id])
  prescriptionItem     PrescriptionItem?     @relation(fields: [prescriptionItemId], references: [id])
  externalPrescription ExternalPrescription? @relation(fields: [externalPrescriptionId], references: [id])
  patient              Patient               @relation(fields: [patientId], references: [id])
  drugBatch            DrugBatch             @relation(fields: [drugBatchId], references: [id])
  dispenser            User                  @relation("Dispenser", fields: [dispensedBy], references: [id])
  verifier             User?                 @relation("DispensingVerifier", fields: [verifiedBy], references: [id])
  witness              User?                 @relation("DispensingWitness", fields: [witnessedById], references: [id])
  drugReturns          DrugReturn[]

  @@map("dispensing_records")
}

model DrugReturn {
  id                 String           @id @default(uuid())
  tenantId           String           @map("tenant_id")
  returnType         ReturnType       @map("return_type")
  // Nullable: a counter_return need not name a specific batch — the medicine is
  // identified by drugId and the batch/expiry are optional free-text fields.
  drugBatchId        String?          @map("drug_batch_id")
  // The medicine being returned. Set for counter_return (picked from the
  // formulary); for patient/vendor returns the drug is reached via drugBatch.
  drugId             String?          @map("drug_id")
  // Free-text batch + expiry captured on a counter_return when the staff knows
  // them but they are not (yet) a tracked DrugBatch. Both optional.
  batchNumber        String?          @map("batch_number") @db.VarChar(100)
  expiryDate         DateTime?        @map("expiry_date") @db.Date
  patientId          String?          @map("patient_id")
  supplierId         String?          @map("supplier_id")
  quantity           Int
  reason             String?
  processedBy        String?          @map("processed_by")
  status             DrugReturnStatus @default(pending)
  // Billing linkage for patient returns. dispensingRecordId points at the
  // original sale line so the return is bounded by what was dispensed; billId
  // is the invoice it was sold on. saleUnit/unitPrice mirror the sale economics
  // (per BASE unit) so refundAmount is the money actually returned to the
  // patient (qty * unitPrice net of the line discount, GST-inclusive). refundId
  // is the Refund row created when the return is approved.
  dispensingRecordId String?          @map("dispensing_record_id")
  billId             String?          @map("bill_id")
  saleUnit           String?          @map("sale_unit") @db.VarChar(10)
  unitPrice          Decimal?         @map("unit_price") @db.Decimal(12, 2)
  refundAmount       Decimal?         @map("refund_amount") @db.Decimal(12, 2)
  refundId           String?          @unique @map("refund_id")
  // G5 vendor returns (expired / damaged stock back to the distributor): the
  // supplier's credit note reference + the credited value. Drives the Supplier
  // Credit Notes report. On approval a vendor return REDUCES stock.
  creditNoteNumber   String?          @map("credit_note_number") @db.VarChar(80)
  creditAmount       Decimal?         @map("credit_amount") @db.Decimal(12, 2)
  // One vendor return can cover several medicines. The lines share a group id
  // and a human-readable return number so the supplier's single credit note
  // maps to a single return, not to one row per batch. Nullable: a return
  // raised before this (or any patient/counter return) simply has no group.
  returnGroupId      String?          @map("return_group_id") @db.Uuid
  returnNumber       String?          @map("return_number") @db.VarChar(40)
  // ── E-way bill (report D-3) ──
  // A vendor return is the one movement in this hospital where goods actually
  // travel on a public road; a ward transfer and a pharmacy issue never leave
  // the building. Whether a bill is needed at all is the hospital's own
  // `eWayBillApplicable` setting and the threshold on it, never a number
  // compiled in here.
  ewayBillNumber     String?          @map("eway_bill_number") @db.VarChar(20)
  ewayBillDate       DateTime?        @map("eway_bill_date")
  createdAt          DateTime         @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  drugBatch        DrugBatch?        @relation(fields: [drugBatchId], references: [id])
  drug             DrugFormulary?    @relation(fields: [drugId], references: [id])
  patient          Patient?          @relation(fields: [patientId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  processor        User?             @relation(fields: [processedBy], references: [id])
  dispensingRecord DispensingRecord? @relation(fields: [dispensingRecordId], references: [id])
  bill             Bill?             @relation(fields: [billId], references: [id])
  refund           Refund?           @relation(fields: [refundId], references: [id])

  @@index([returnGroupId])
  @@map("drug_returns")
}

// G13: on-hand stock of a drug batch held at a ward (transferred from the
// central pharmacy). FK columns are scalar (no Prisma relations) so this is a
// self-contained sub-module; names are resolved by the service.
model WardStock {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  wardId          String   @map("ward_id")
  drugId          String   @map("drug_id")
  drugBatchId     String   @map("drug_batch_id")
  quantityInStock Int      @default(0) @map("quantity_in_stock")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, wardId, drugBatchId])
  @@index([tenantId, wardId])
  @@map("ward_stock")
}

// G13: ward medicine ledger — every movement of ward stock (received from
// pharmacy, dispensed to a patient, returned, adjusted). Replaces the paper book.
model WardStockLedger {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  wardId       String   @map("ward_id")
  drugId       String   @map("drug_id")
  drugBatchId  String   @map("drug_batch_id")
  movementType String   @map("movement_type") @db.VarChar(20) // received | dispensed | returned | adjusted
  quantity     Int
  patientId    String?  @map("patient_id")
  admissionId  String?  @map("admission_id")
  billId       String?  @map("bill_id")
  performedBy  String?  @map("performed_by")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, wardId, createdAt])
  @@map("ward_stock_ledger")
}

// ============================================================
// 11b. IP MEDICATION INDENT (design doc I — ward→pharmacy request lifecycle)
// ============================================================
// A ward nurse raises an electronic indent to the IP pharmacy for a patient's
// prescribed drugs that exceed the ward emergency-kit stock. The IP pharmacist
// reviews it (credit-gated — a cash patient over deposit is held unless the
// drug is life-saving or clearance is given), approves, dispenses against FEFO
// batches (posting the charge to the patient's IP bill ledger), a runner
// delivers to the ward, and the ward nurse verifies the received batch against
// the indent and Acknowledges before administering. Scalar FK columns (no
// Prisma relations) resolved by the service — mirrors the WardStock sub-module.
model MedicationIndent {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  indentNumber     String    @map("indent_number") @db.VarChar(40)
  patientId        String    @map("patient_id")
  admissionId      String?   @map("admission_id")
  wardId           String?   @map("ward_id")
  prescriptionId   String?   @map("prescription_id")
  // raised | approved | dispensed | delivered | acknowledged | cancelled
  status           String    @default("raised") @db.VarChar(20)
  // ok | clearance_required | cleared — the credit picture at raise/approve time.
  creditStatus     String    @default("ok") @map("credit_status") @db.VarChar(24)
  // TTO (To Take Out) discharge indent — dispensed in full packs and added to
  // the final hospital bill, vs. a routine daily ward indent (unit-dose allowed).
  isTto            Boolean   @default(false) @map("is_tto")
  priority         String?   @db.VarChar(20)
  notes            String?
  billId           String?   @map("bill_id")
  raisedById       String    @map("raised_by_id")
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  dispensedById    String?   @map("dispensed_by_id")
  dispensedAt      DateTime? @map("dispensed_at")
  deliveredAt      DateTime? @map("delivered_at")
  acknowledgedById String?   @map("acknowledged_by_id")
  acknowledgedAt   DateTime? @map("acknowledged_at")
  cancelledReason  String?   @map("cancelled_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  items MedicationIndentItem[]

  @@unique([tenantId, indentNumber])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("medication_indents")
}

model MedicationIndentItem {
  id                 String   @id @default(uuid())
  indentId           String   @map("indent_id")
  drugFormularyId    String   @map("drug_formulary_id")
  requestedQty       Int      @map("requested_qty")
  approvedQty        Int?     @map("approved_qty")
  // Base (loose) units vs whole packs. A TTO indent forces 'pack'.
  saleUnit           String   @default("pack") @map("sale_unit") @db.VarChar(10)
  dispensedBatchId   String?  @map("dispensed_batch_id")
  dispensedQty       Int?     @map("dispensed_qty")
  unitPrice          Decimal? @map("unit_price") @db.Decimal(12, 2)
  lineTotal          Decimal? @map("line_total") @db.Decimal(12, 2)
  // The DispensingRecord minted when this line was dispensed — kept so the IP
  // Return-to-Stock (RTS) flow can precisely reverse the exact dispense (restock
  // the original batch, net down the sale record, credit the running bill).
  dispensingRecordId String?  @map("dispensing_record_id")
  // Cumulative quantity (in this line's saleUnit) already returned to pharmacy via
  // the RTS flow. dispensedQty − returnedQty = what the ward still holds.
  returnedQty        Int?     @default(0) @map("returned_qty")
  acknowledged       Boolean  @default(false)
  notes              String?

  indent MedicationIndent @relation(fields: [indentId], references: [id], onDelete: Cascade)

  @@index([indentId])
  @@map("medication_indent_items")
}

// ============================================================
// 11c. OT KIT — surgical preference-card templates + "Issue Bulk, Reconcile
// Net" virtual OT ledger (design doc III)
// ============================================================
// A hospital pre-defines surgeon-preference kit bundles (SurgicalTemplate +
// items). Pre-op, the OT nurse requests a template for a scheduled patient; the
// pharmacy issues the whole bundle (FEFO batches leave active stock into a
// transit bucket bound to the OT session, NOT billed). Post-op, the crate of
// unused items is scanned back and the system nets Issued − Returned = Consumed:
// only the consumed cost is posted to the patient's bill and the unused units
// are reversed into active pharmacy stock. Scalar FKs, service-resolved.
model SurgicalTemplate {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(160)
  procedureName String?  @map("procedure_name") @db.VarChar(200)
  // Preferred surgeon (DoctorProfile id) whose preference card this is. Nullable.
  doctorId      String?  @map("doctor_id")
  // Scannable kit-master barcode — one scan expands the whole bundle at issue.
  kitBarcode    String?  @map("kit_barcode") @db.VarChar(64)
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  items SurgicalTemplateItem[]

  @@index([tenantId, isActive])
  @@map("surgical_templates")
}

model SurgicalTemplateItem {
  id              String  @id @default(uuid())
  templateId      String  @map("template_id")
  drugFormularyId String  @map("drug_formulary_id")
  // Default kit quantity in BASE units of the drug (e.g. 4 sutures, 5 syringes).
  defaultQuantity Int     @map("default_quantity")
  notes           String?

  template SurgicalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("surgical_template_items")
}

/// The virtual OT ledger — a transit bucket bound to one OT session (OtRequest).
/// requested → issued (stock moved out of pharmacy into transit, not billed) →
/// reconciled (returned scanned back; consumed = issued − returned billed to the
/// patient, unused reversed to active stock). Scalar FKs, service-resolved.
model OtKitIssue {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  issueNumber    String    @map("issue_number") @db.VarChar(40)
  otRequestId    String?   @map("ot_request_id")
  patientId      String    @map("patient_id")
  visitId        String?   @map("visit_id")
  templateId     String?   @map("template_id")
  // requested | issued | reconciled | cancelled
  status         String    @default("requested") @db.VarChar(20)
  requestedById  String?   @map("requested_by_id")
  issuedById     String?   @map("issued_by_id")
  issuedAt       DateTime? @map("issued_at")
  reconciledById String?   @map("reconciled_by_id")
  reconciledAt   DateTime? @map("reconciled_at")
  billId         String?   @map("bill_id")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  items OtKitIssueItem[]

  @@unique([tenantId, issueNumber])
  @@index([tenantId, status])
  @@index([tenantId, otRequestId])
  @@map("ot_kit_issues")
}

model OtKitIssueItem {
  id              String   @id @default(uuid())
  issueId         String   @map("issue_id")
  drugFormularyId String   @map("drug_formulary_id")
  drugBatchId     String?  @map("drug_batch_id")
  issuedQty       Int      @default(0) @map("issued_qty")
  returnedQty     Int      @default(0) @map("returned_qty")
  consumedQty     Int?     @map("consumed_qty")
  unitPrice       Decimal? @map("unit_price") @db.Decimal(12, 2)
  taxPercent      Decimal? @default(0) @map("tax_percent") @db.Decimal(5, 2)
  lineTotal       Decimal? @map("line_total") @db.Decimal(12, 2)

  issue OtKitIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("ot_kit_issue_items")
}

// ============================================================
// 12. INVENTORY & PURCHASE
// ============================================================

model Supplier {
  id              String      @id @default(uuid())
  tenantId        String      @map("tenant_id")
  name            String      @db.VarChar(255)
  phone           String?     @db.VarChar(20)
  email           String?     @db.VarChar(255)
  address         String?
  gstNumber       String?     @map("gst_number") @db.VarChar(50)
  /// Derived from `gstNumber`'s first two digits. Decides whether a purchase
  /// was intra-state (CGST+SGST) or inter-state (IGST).
  stateCode       String?     @map("state_code") @db.VarChar(2)
  licenseNumber   String?     @map("license_number") @db.VarChar(100)
  supplyType      SupplyType? @map("supply_type")
  // Credit period agreed with the vendor: how many days we have to pay them
  // after an invoice. Plain reference figure captured at vendor creation.
  paymentTermDays Int?        @map("payment_term_days")
  // Max outstanding credit we'll carry with this vendor (₹). Reference figure
  // the accounts team uses when clearing dues — not enforced anywhere.
  creditLimit     Decimal?    @map("credit_limit") @db.Decimal(12, 2)
  // How this vendor is usually settled: cash | cheque | bank_transfer | upi |
  // credit. Reference for the accounts team; the FE offers a fixed dropdown.
  paymentMode     String?     @map("payment_mode") @db.VarChar(30)
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  drugBatches        DrugBatch[]
  drugReturns        DrugReturn[]
  stockTransactions  StockTransaction[]
  purchaseOrders     PurchaseOrder[]
  drugPurchaseOrders DrugPurchaseOrder[]

  @@map("suppliers")
}

model InventoryItem {
  id                    String            @id @default(uuid())
  tenantId              String            @map("tenant_id")
  itemName              String            @map("item_name") @db.VarChar(255)
  itemCode              String?           @map("item_code") @db.VarChar(50)
  category              InventoryCategory
  description           String?
  unitOfMeasurement     String?           @map("unit_of_measurement") @db.VarChar(20)
  minimumStockThreshold Int               @default(10) @map("minimum_stock_threshold")
  currentStock          Int               @default(0) @map("current_stock")
  costPerUnit           Decimal?          @map("cost_per_unit") @db.Decimal(10, 2)
  sellingPricePerUnit   Decimal?          @map("selling_price_per_unit") @db.Decimal(10, 2)
  isActive              Boolean           @default(true) @map("is_active")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  supplyRequests     SupplyRequest[]
  stockTransfers     StockTransfer[]
  // Pharmacy drugs optionally mapped to this generic item (additive unification).
  formularyDrugs     DrugFormulary[]     @relation("FormularyInventoryLink")

  @@map("inventory_items")
}

model StockTransaction {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  inventoryItemId String               @map("inventory_item_id")
  transactionType StockTransactionType @map("transaction_type")
  quantity        Int
  batchNumber     String?              @map("batch_number") @db.VarChar(100)
  expiryDate      DateTime?            @map("expiry_date") @db.Date
  supplierId      String?              @map("supplier_id")
  referenceType   String?              @map("reference_type") @db.VarChar(50)
  referenceId     String?              @map("reference_id")
  unitCost        Decimal?             @map("unit_cost") @db.Decimal(10, 2)
  totalCost       Decimal?             @map("total_cost") @db.Decimal(12, 2)
  departmentId    String?              @map("department_id")
  notes           String?
  performedBy     String               @map("performed_by")
  createdAt       DateTime             @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  performer     User          @relation(fields: [performedBy], references: [id])

  @@map("stock_transactions")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  supplierId           String              @map("supplier_id")
  orderNumber          String              @unique @map("order_number") @db.VarChar(50)
  orderDate            DateTime            @map("order_date") @db.Date
  expectedDeliveryDate DateTime?           @map("expected_delivery_date") @db.Date
  status               PurchaseOrderStatus @default(draft)
  totalAmount          Decimal?            @map("total_amount") @db.Decimal(12, 2)
  approvedBy           String?             @map("approved_by")
  notes                String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  approver User?               @relation(fields: [approvedBy], references: [id])
  items    PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  // A PO line is EITHER a generic inventory item OR a pharmacy drug (exactly one
  // is set). Drug lines are received as a DrugBatch into pharmacy stock so the
  // purchasing and pharmacy-stock systems stay connected.
  inventoryItemId  String?  @map("inventory_item_id")
  drugId           String?  @map("drug_id")
  quantityOrdered  Int      @map("quantity_ordered")
  quantityReceived Int      @default(0) @map("quantity_received")
  unitPrice        Decimal? @map("unit_price") @db.Decimal(10, 2)
  totalPrice       Decimal? @map("total_price") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  drug          DrugFormulary? @relation(fields: [drugId], references: [id])

  @@map("purchase_order_items")
}

// G9: draft purchase orders for DRUGS (distinct from the inventory-consumable
// PurchaseOrder above, whose items link to InventoryItem). Generated from the
// reorder list when a drug falls at/below its minimum stock; a draft the pharmacy
// reviews and marks sent — never auto-dispatched.
enum DrugPurchaseOrderStatus {
  draft     @map("draft")
  sent      @map("sent")
  received  @map("received")
  cancelled @map("cancelled")
}

model DrugPurchaseOrder {
  id          String                  @id @default(uuid())
  tenantId    String                  @map("tenant_id")
  supplierId  String?                 @map("supplier_id")
  orderNumber String                  @unique @map("order_number") @db.VarChar(50)
  status      DrugPurchaseOrderStatus @default(draft)
  notes       String?
  createdBy   String?                 @map("created_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at")

  supplier Supplier?               @relation(fields: [supplierId], references: [id])
  items    DrugPurchaseOrderItem[]

  @@index([tenantId, status])
  @@map("drug_purchase_orders")
}

model DrugPurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  drugId          String   @map("drug_id")
  quantityOrdered Int      @map("quantity_ordered")
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder DrugPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  drug          DrugFormulary     @relation(fields: [drugId], references: [id])

  @@map("drug_purchase_order_items")
}

model SupplyRequest {
  id                String              @id @default(uuid())
  tenantId          String              @map("tenant_id")
  requestedBy       String              @map("requested_by")
  departmentId      String              @map("department_id")
  wardId            String?             @map("ward_id")
  inventoryItemId   String              @map("inventory_item_id")
  quantityRequested Int                 @map("quantity_requested")
  quantityFulfilled Int                 @default(0) @map("quantity_fulfilled")
  status            SupplyRequestStatus @default(pending)
  urgency           SupplyUrgency       @default(routine)
  approvedBy        String?             @map("approved_by")
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  requester     User          @relation("SupplyRequester", fields: [requestedBy], references: [id])
  department    Department    @relation(fields: [departmentId], references: [id])
  ward          Ward?         @relation(fields: [wardId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  approver      User?         @relation("SupplyApprover", fields: [approvedBy], references: [id])

  @@map("supply_requests")
}

model StockTransfer {
  id                  String              @id @default(uuid())
  tenantId            String              @map("tenant_id")
  transferNumber      String              @unique @map("transfer_number") @db.VarChar(50)
  // A transfer moves EITHER a generic inventory item OR a pharmacy drug batch
  // (exactly one is set). drugBatchId is used when issuing drug stock from the
  // pharmacy to a department/ward.
  inventoryItemId     String?             @map("inventory_item_id")
  drugBatchId         String?             @map("drug_batch_id")
  fromDepartmentId    String?             @map("from_department_id")
  toDepartmentId      String?             @map("to_department_id")
  // Where a DRUG transfer lands. Departments do not hold drug stock — wards do
  // — so a drug issued to a department was decremented from the pharmacy batch
  // and credited nowhere. Naming the ward is what lets `receive` put it on the
  // ward's shelf, where the ward stock screen and its ledger can see it.
  // Null for consumables and equipment, which are department-scoped as before.
  toWardId            String?             @map("to_ward_id")
  fromLocation        String?             @map("from_location") @db.VarChar(100)
  toLocation          String?             @map("to_location") @db.VarChar(100)
  quantityRequested   Int                 @map("quantity_requested")
  quantityTransferred Int                 @default(0) @map("quantity_transferred")
  batchNumber         String?             @map("batch_number") @db.VarChar(100)
  status              StockTransferStatus @default(pending)
  reason              String?
  notes               String?
  requestedBy         String              @map("requested_by")
  approvedBy          String?             @map("approved_by")
  approvedAt          DateTime?           @map("approved_at")
  dispatchedBy        String?             @map("dispatched_by")
  dispatchedAt        DateTime?           @map("dispatched_at")
  receivedBy          String?             @map("received_by")
  receivedAt          DateTime?           @map("received_at")
  rejectionReason     String?             @map("rejection_reason")
  // ── Controlled-drug custody ──
  // Moving a vault narcotic is a hand-off between two people, not one person
  // pressing dispatch. The receiving custodian is named here and must be
  // someone other than the dispatcher — the same rule the NDPS challan has
  // always enforced, now applied on the merged transfer board so a narcotic
  // cannot be moved through the ordinary flow without it.
  custodianId         String?             @map("custodian_id")
  custodyAt           DateTime?           @map("custody_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  drugBatch      DrugBatch?     @relation(fields: [drugBatchId], references: [id])
  fromDepartment Department?    @relation("StockTransferFromDept", fields: [fromDepartmentId], references: [id])
  toDepartment   Department?    @relation("StockTransferToDept", fields: [toDepartmentId], references: [id])
  toWard         Ward?          @relation("StockTransferToWard", fields: [toWardId], references: [id])
  requester      User           @relation("StockTransferRequester", fields: [requestedBy], references: [id])
  approver       User?          @relation("StockTransferApprover", fields: [approvedBy], references: [id])
  dispatcher     User?          @relation("StockTransferDispatcher", fields: [dispatchedBy], references: [id])
  receiver       User?          @relation("StockTransferReceiver", fields: [receivedBy], references: [id])
  custodian      User?          @relation("StockTransferCustodian", fields: [custodianId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, inventoryItemId])
  @@map("stock_transfers")
}

/// Per-tenant inventory module configuration. One row per tenant (singleton);
/// created lazily with defaults on first read. Drives configurable reorder
/// thresholds, expiry-alert window, the auto-flag / prevent-expired-use guards,
/// and which roles receive low-stock / expiry notifications ("alert inventory
/// manager"). See inventory.settings.service.ts.
model InventorySetting {
  id                       String    @id @default(uuid())
  tenantId                 String    @unique @map("tenant_id")
  /// Default minimum-stock threshold applied to new items when none is given.
  defaultLowStockThreshold Int       @default(10) @map("default_low_stock_threshold")
  /// Look-ahead window (months) used by expiry tracking + expiry alerts.
  expiryAlertMonths        Int       @default(3) @map("expiry_alert_months")
  /// Master switches for the two alert categories.
  lowStockAlertEnabled     Boolean   @default(true) @map("low_stock_alert_enabled")
  expiryAlertEnabled       Boolean   @default(true) @map("expiry_alert_enabled")
  /// When true, the alert run also auto-flags fully-expired batches (removes them).
  autoFlagExpired          Boolean   @default(false) @map("auto_flag_expired")
  /// When true, a stock-out that names an expired batch is rejected.
  preventExpiredUse        Boolean   @default(true) @map("prevent_expired_use")
  /// Fire a reorder notification the moment an item crosses its threshold.
  reorderNotifyEnabled     Boolean   @default(true) @map("reorder_notify_enabled")
  /// Normalised role slugs that receive inventory notifications. Empty = fall
  /// back to inventory_manager / pharmacy_admin / admin.
  alertRecipientRoles      String[]  @default([]) @map("alert_recipient_roles")
  lastAlertRunAt           DateTime? @map("last_alert_run_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("inventory_settings")
}

// ============================================================
// 13. BILLING & PAYMENTS
// ============================================================

model ServiceTariff {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  serviceName    String                @map("service_name") @db.VarChar(255)
  serviceCode    String?               @map("service_code") @db.VarChar(50)
  category       ServiceTariffCategory
  basePrice      Decimal               @map("base_price") @db.Decimal(12, 2)
  gstRatePercent Decimal               @default(0) @map("gst_rate_percent") @db.Decimal(4, 2)
  // ── GST classification ──
  // The SAC code is what the invoice prints and what GSTR-1 groups by, and it
  // is what resolves the rate. gstRatePercent above stays as the hospital's own
  // override for the rare case where its auditor differs from the master.
  sacCode        String?               @map("sac_code") @db.VarChar(20)
  /// 'taxable' | 'exempt' | 'nil_rated' | 'non_gst' | 'zero_rated'.
  gstTreatment   String?               @map("gst_treatment") @db.VarChar(20)
  /// The hospital's auditor has signed this classification off. An approved
  /// classification is never overridden by a master or by a category default.
  gstApproved    Boolean               @default(false) @map("gst_approved")
  /// A non-therapeutic procedure — cosmetic surgery, elective aesthetic work.
  /// Taxable however the rest of the surgery list is classified, and the code
  /// alone cannot tell the two apart.
  isCosmetic     Boolean               @default(false) @map("is_cosmetic")
  // For imaging (category=radiology) tariffs: which modality this study runs on,
  // so the doctor's catalog search can route a picked study to the right
  // ImagingType when ordering. Null for non-imaging categories.
  modality       ImagingType?          @map("modality")
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  billItems  BillItem[]
  otRequests OtRequest[]

  @@map("service_tariffs")
}

model Bill {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  patientId              String   @map("patient_id")
  visitId                String?  @map("visit_id")
  admissionId            String?  @map("admission_id")
  billNumber             String   @unique @map("bill_number") @db.VarChar(50)
  billDate               DateTime @map("bill_date")
  subtotal               Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount         Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount              Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount            Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  insuranceCoveredAmount Decimal  @default(0) @map("insurance_covered_amount") @db.Decimal(12, 2)
  patientPayableAmount   Decimal  @default(0) @map("patient_payable_amount") @db.Decimal(12, 2)

  // ── GST rollup and identity ──
  // taxAmount above is the single figure the bill has always carried. These are
  // the same money broken out the way every GST return asks for it, plus the
  // three facts that decide the split. They are SNAPSHOTS: the hospital's GSTIN
  // may change, but this bill was raised under the one recorded here.
  taxableValue           Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  cgstAmount             Decimal @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount             Decimal @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount             Decimal @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cessAmount             Decimal @default(0) @map("cess_amount") @db.Decimal(12, 2)
  roundOff               Decimal @default(0) @map("round_off") @db.Decimal(6, 2)
  supplierGstin          String? @map("supplier_gstin") @db.VarChar(15)
  supplierStateCode      String? @map("supplier_state_code") @db.VarChar(2)
  /// Set only for a B2B document — a corporate, insurer or TPA with a GSTIN.
  recipientGstin         String? @map("recipient_gstin") @db.VarChar(15)
  placeOfSupplyStateCode String? @map("place_of_supply_state_code") @db.VarChar(2)
  isInterState           Boolean @default(false) @map("is_inter_state")

  // ── The document this bill IS ──
  // billNumber above is the internal reference and resets daily. An invoice
  // number is the one the government sees: continuous, gap-free and unique for
  // the whole financial year. Allotted at FINALISE, never at draft, so an
  // abandoned draft cannot burn a number and leave a hole in the series.
  /// 'tax_invoice' | 'bill_of_supply' | 'invoice_cum_bill_of_supply'.
  gstDocumentType    String?   @map("gst_document_type") @db.VarChar(30)
  invoiceNumber      String?   @unique @map("invoice_number") @db.VarChar(50)
  /// The SECOND document a GST-registered recipient is owed.
  ///
  /// Rule 46A allows the combined Invoice-cum-Bill of Supply only for an
  /// UNREGISTERED recipient. A registered one with both taxable and exempt
  /// lines is strictly owed two documents: the taxable lines on the tax
  /// invoice above, the exempt ones here.
  ///
  /// One bill, two numbers, rather than two bills — the bill is one commercial
  /// event with one balance to settle, and splitting it would double every
  /// payment, credit note and report row that keys on a bill.
  billOfSupplyNumber String?   @unique @map("bill_of_supply_number") @db.VarChar(50)
  /// "2026-27" — the year the series belongs to.
  financialYear      String?   @map("financial_year") @db.VarChar(7)
  /// Set when the document was issued. Tax figures are read-only after it.
  gstFrozenAt        DateTime? @map("gst_frozen_at")

  // ── E-invoice: what the government portal gave back ──
  //
  // Section 8 names irn, ack_no and qr_payload; section 10 prints the IRN and
  // the signed QR "once e-invoicing applies"; section 11.5's D-1 and D-2 read
  // nothing else. Whether any of it applies is the hospital's own
  // configuration — `eInvoiceApplicable` on the GST profile — and never a
  // rupee threshold compiled in here.
  //
  /// The portal's 64-character hash of the invoice. Unique: the same IRN on
  /// two bills means one invoice was registered twice.
  irn                String?    @unique @db.VarChar(64)
  irnAckNo           String?    @map("irn_ack_no") @db.VarChar(30)
  irnAckDate         DateTime?  @map("irn_ack_date")
  /// The signed QR string, printed as-is. Never re-encoded — the signature is
  /// over these exact bytes.
  irnQrPayload       String?    @map("irn_qr_payload")
  /// 'pending' | 'registered' | 'failed' | 'cancelled'. Null means never sent,
  /// which is a different fact from "sent and rejected" — D-2 exists to keep
  /// the two apart, and a null IRN alone cannot.
  irnStatus          String?    @map("irn_status") @db.VarChar(20)
  /// The portal's own words for the refusal. D-2 reports them verbatim.
  irnError           String?    @map("irn_error")
  irnAttemptedAt     DateTime?  @map("irn_attempted_at")
  irnCancelledAt     DateTime?  @map("irn_cancelled_at")
  amountPaid         Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue         Decimal    @default(0) @map("balance_due") @db.Decimal(12, 2)
  status             BillStatus @default(draft)
  generatedBy        String?    @map("generated_by")
  approvedBy         String?    @map("approved_by")
  cancelledBy        String?    @map("cancelled_by")
  cancellationReason String?    @map("cancellation_reason")
  /// When it was cancelled, as its own fact.
  ///
  /// C-9 reported `updated_at` as the cancellation date and FILTERED on
  /// `bill_date`, so an invoice raised in July and cancelled in September
  /// appeared in July — where the cancellation had not happened yet — and was
  /// missing from September, which is the month the reversal belongs to.
  /// `updated_at` cannot stand in for this: any later touch of the row moves it.
  cancelledAt        DateTime?  @map("cancelled_at")
  pdfUrl             String?    @map("pdf_url")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  patient         Patient          @relation(fields: [patientId], references: [id])
  visit           Visit?           @relation(fields: [visitId], references: [id])
  admission       Admission?       @relation(fields: [admissionId], references: [id])
  generator       User?            @relation("BillGenerator", fields: [generatedBy], references: [id])
  approver        User?            @relation("BillApprover", fields: [approvedBy], references: [id])
  canceller       User?            @relation("BillCanceller", fields: [cancelledBy], references: [id])
  billItems       BillItem[]
  payments        Payment[]
  refunds         Refund[]
  discounts       Discount[]
  insuranceClaims InsuranceClaim[]
  drugReturns     DrugReturn[]
  creditNotes     CreditNote[]

  @@index([tenantId, irnStatus, billDate])
  @@map("bills")
}

model BillItem {
  id              String           @id @default(uuid())
  billId          String           @map("bill_id")
  serviceTariffId String?          @map("service_tariff_id")
  description     String           @db.VarChar(500)
  category        BillItemCategory
  quantity        Int              @default(1)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxPercent      Decimal          @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(12, 2)

  // ── GST, as the return needs it ──
  // taxPercent/taxAmount above say how much; these say what KIND of supply it
  // was, under which code, and how the tax splits between the heads. All three
  // are reported separately, and none of them can be recovered afterwards from
  // a percentage alone.
  hsnSacCode            String? @map("hsn_sac_code") @db.VarChar(20)
  /// 'taxable' | 'exempt' | 'nil_rated' | 'non_gst' | 'zero_rated'.
  gstTreatment          String? @map("gst_treatment") @db.VarChar(20)
  /// True when the tax was already inside unitPrice — a medicine at MRP.
  taxInclusive          Boolean @default(false) @map("tax_inclusive")
  /// What the tax was charged ON: net of discount, and net of embedded tax.
  taxableValue          Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  cgstRate              Decimal @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount            Decimal @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate              Decimal @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount            Decimal @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstRate              Decimal @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount            Decimal @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cessAmount            Decimal @default(0) @map("cess_amount") @db.Decimal(12, 2)
  /// Which rule decided the rate — 'hsn_master', 'inpatient_composite', etc.
  /// Kept so a patient's question can be answered without reading the code.
  rateSource            String? @map("rate_source") @db.VarChar(32)
  taxReason             String? @map("tax_reason") @db.VarChar(255)
  /// A taxable rate that only a fallback produced. Blocks finalisation.
  requiresTaxResolution Boolean @default(false) @map("requires_tax_resolution")

  referenceType  String?  @map("reference_type") @db.VarChar(50)
  referenceId    String?  @map("reference_id")
  isAutoPulled   Boolean  @default(false) @map("is_auto_pulled")
  // G7 (3.2): TPA split at the line level — the billing desk sees, per line,
  // what the insurer reimburses vs what the patient pays out-of-pocket (e.g. the
  // drug is covered but the disposable syringe is not). null = not categorised.
  isReimbursable Boolean? @map("is_reimbursable")
  tpaCategory    String?  @map("tpa_category") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at")

  bill          Bill           @relation(fields: [billId], references: [id])
  serviceTariff ServiceTariff? @relation(fields: [serviceTariffId], references: [id])

  creditNoteItems CreditNoteItem[]

  // The HSN/SAC summary in GSTR-1 groups by code across a whole period.
  @@index([hsnSacCode])
  // Finding the lines that are blocking a bill from being finalised.
  @@index([requiresTaxResolution])
  @@map("bill_items")
}

model Payment {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  billId           String          @map("bill_id")
  patientId        String          @map("patient_id")
  paymentDate      DateTime        @map("payment_date")
  amount           Decimal         @db.Decimal(12, 2)
  paymentMethod    PaymentMethod   @map("payment_method")
  paymentSource    PaymentSource?  @map("payment_source")
  paymentType      PaymentTypeEnum @default(regular) @map("payment_type")
  transactionId    String?         @map("transaction_id") @db.VarChar(100)
  gatewayReference String?         @map("gateway_reference") @db.VarChar(255)
  idempotencyKey   String?         @unique @map("idempotency_key") @db.VarChar(255)
  status           PaymentStatus   @default(completed)
  processedBy      String?         @map("processed_by")
  notes            String?

  // ── GST on an ADVANCE ──
  // Tax normally attaches to the invoice, not to the tender: cash, card and UPI
  // all carry the same tax because the tax is on the supply. An advance is the
  // one exception. For a service the time of supply is the EARLIER of invoice
  // or payment, so money taken before the supply fixes the liability at receipt
  // and Rule 50 requires a receipt voucher stating the rate and the tax.
  //
  // For a hospital the answer is usually exempt — a deposit is against
  // treatment, and treatment is exempt — but "usually exempt" has to be
  // RECORDED rather than assumed, because it is also the figure the advances
  // report and GSTR-1 table 11 read.
  //
  // Only ever set on an advance receipt or a voucher. A payment settling an
  // already-issued invoice leaves all of this null: the tax is on the invoice.
  gstTreatment           String?  @map("gst_treatment") @db.VarChar(20)
  taxRatePercent         Decimal? @map("tax_rate_percent") @db.Decimal(5, 2)
  taxableValue           Decimal? @map("taxable_value") @db.Decimal(12, 2)
  taxAmount              Decimal? @map("tax_amount") @db.Decimal(12, 2)
  cgstAmount             Decimal? @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount             Decimal? @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount             Decimal? @map("igst_amount") @db.Decimal(12, 2)
  /// 'receipt_voucher' (Rule 50, advance in) | 'refund_voucher' (Rule 51, out).
  voucherType            String?  @map("voucher_type") @db.VarChar(20)
  voucherNumber          String?  @unique @map("voucher_number") @db.VarChar(50)
  /// The advance receipt this row draws down, so an adjustment can be traced to
  /// the money it came out of. GSTR-1 table 11B has no other source.
  sourceAdvancePaymentId String?  @map("source_advance_payment_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  bill          Bill              @relation(fields: [billId], references: [id])
  patient       Patient           @relation(fields: [patientId], references: [id])
  processor     User?             @relation(fields: [processedBy], references: [id])
  receipt       Receipt?
  refunds       Refund[]
  transfers     PaymentTransfer[]
  sourceAdvance Payment?          @relation("AdvanceDrawdown", fields: [sourceAdvancePaymentId], references: [id])
  drawdowns     Payment[]         @relation("AdvanceDrawdown")

  @@index([sourceAdvancePaymentId])
  @@map("payments")
}

/// End-of-day cash reconciliation for one cashier's drawer.
///
/// Payments here are marked by hand, so the drawer is the only place the system
/// meets physical reality: what it thinks was collected versus what is actually
/// in the till. Only CASH is counted — card, UPI and bank transfers settle to
/// the bank and never sit in a drawer.
///
/// One closure per cashier per business day. The cashier is the unit because
/// every payment already records who took it, so the expected figure can be
/// derived per person rather than guessed for the counter as a whole.
model CashDrawerClosure {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  /// The IST calendar day being closed, not a timestamp.
  businessDate  DateTime @map("business_date") @db.Date
  /// Whose drawer. Payments carry processedBy, so expected cash is derived.
  cashierId     String   @map("cashier_id")
  /// Cash handed over at the start of the shift to make change with.
  openingFloat  Decimal  @default(0) @map("opening_float") @db.Decimal(12, 2)
  /// System figure: openingFloat + cash collected − cash refunded.
  expectedCash  Decimal  @default(0) @map("expected_cash") @db.Decimal(12, 2)
  /// What the cashier actually counted.
  countedCash   Decimal  @default(0) @map("counted_cash") @db.Decimal(12, 2)
  /// countedCash − expectedCash. Negative is short, positive is over.
  variance      Decimal  @default(0) @db.Decimal(12, 2)
  /// Note count per denomination, e.g. {"500": 12, "200": 3}. Optional — a
  /// cashier may just enter a total.
  denominations Json?    @map("denominations")
  notes         String?
  closedBy      String   @map("closed_by")
  closedAt      DateTime @default(now()) @map("closed_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  cashier User   @relation("DrawerCashier", fields: [cashierId], references: [id])
  closer  User   @relation("DrawerCloser", fields: [closedBy], references: [id])

  @@unique([tenantId, businessDate, cashierId])
  @@index([tenantId, businessDate])
  @@map("cash_drawer_closures")
}

model Receipt {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  paymentId     String   @unique @map("payment_id")
  receiptNumber String   @unique @map("receipt_number") @db.VarChar(50)
  receiptDate   DateTime @map("receipt_date")
  amount        Decimal  @db.Decimal(12, 2)
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("receipts")
}

model Refund {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  billId      String       @map("bill_id")
  paymentId   String       @map("payment_id")
  patientId   String       @map("patient_id")
  amount      Decimal      @db.Decimal(12, 2)
  reason      String
  status      RefundStatus @default(requested)
  requestedBy String?      @map("requested_by")
  approvedBy  String?      @map("approved_by")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  bill       Bill        @relation(fields: [billId], references: [id])
  payment    Payment     @relation(fields: [paymentId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id])
  requester  User?       @relation("RefundRequester", fields: [requestedBy], references: [id])
  approver   User?       @relation("RefundApprover", fields: [approvedBy], references: [id])
  drugReturn DrugReturn?

  @@map("refunds")
}

model Discount {
  id           String       @id @default(uuid())
  tenantId     String       @map("tenant_id")
  billId       String       @map("bill_id")
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(10, 2)
  reason       String?
  approvedBy   String?      @map("approved_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  /// Whether this concession is in effect. Only `approved` rows reduce what the
  /// patient owes — a `pending` one is a request and changes no figure until
  /// somebody with billing:approve decides on it.
  ///
  /// Defaults to `approved` so that every concession granted before the
  /// approval gate existed stays in effect, and so a hospital that never turns
  /// the gate on behaves exactly as it always did.
  status          DiscountStatus @default(approved)
  /// Who asked for it, as distinct from who allowed it.
  requestedBy     String?        @map("requested_by")
  decidedAt       DateTime?      @map("decided_at")
  rejectionReason String?        @map("rejection_reason")

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  bill      Bill   @relation(fields: [billId], references: [id])
  approver  User?  @relation(fields: [approvedBy], references: [id])
  requester User?  @relation("DiscountRequester", fields: [requestedBy], references: [id])

  @@index([tenantId, status])
  @@map("discounts")
}

enum DiscountStatus {
  pending  @map("pending")
  approved @map("approved")
  rejected @map("rejected")
}

// ============================================================
// Margin-based system-wide discount (separate module — visual refinement)
// ============================================================
// A distinct, opt-in module (kept apart from stock entry / bill discounts) that
// derives the discount a cashier may grant from an item's PROFIT MARGIN rather
// than from editing each medicine's price. Per-tenant rules map a margin% band
// to the MAX discount% allowed; at the POS this is surfaced as a hint and
// enforced as a ceiling. It never mutates stored medicine prices — it only
// refines what the portal shows/allows. Self-contained sub-module: tenantId is
// a scalar (no Prisma relation), matching the WardStock pattern above.

/// Singleton per-tenant switch for the margin-discount module.
model MarginDiscountConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  enabled   Boolean  @default(false)
  // 'cap' — show the allowed discount AND enforce it as a ceiling at the POS
  // (default). 'suggest' — show the recommended discount only, no enforcement.
  mode      String   @default("cap") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("margin_discount_config")
}

/// One margin band → max-discount rule. Inclusive band [minMarginPercent,
/// maxMarginPercent]; a null maxMarginPercent means "this margin and above".
model MarginDiscountRule {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  label              String   @db.VarChar(80)
  minMarginPercent   Decimal  @map("min_margin_percent") @db.Decimal(6, 2)
  maxMarginPercent   Decimal? @map("max_margin_percent") @db.Decimal(6, 2)
  maxDiscountPercent Decimal  @map("max_discount_percent") @db.Decimal(5, 2)
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, isActive])
  @@map("margin_discount_rules")
}

// ============================================================
// 14. INSURANCE & TPA
// ============================================================

model Insurer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?
  /// The payer's own GST registration. Without it no B2B invoice can be raised
  /// against this party, and the whole IGST path is unreachable.
  gstin         String?  @db.VarChar(15)
  /// Always the first two digits of the GSTIN — derived, never typed, so the
  /// two cannot drift apart. Decides CGST+SGST against IGST.
  stateCode     String?  @map("state_code") @db.VarChar(2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  insurancePolicies InsurancePolicy[]
  insuranceCases    InsuranceCase[]

  @@map("insurers")
}

model TpaProvider {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?
  /// The payer's own GST registration. Without it no B2B invoice can be raised
  /// against this party, and the whole IGST path is unreachable.
  gstin         String?  @db.VarChar(15)
  /// Always the first two digits of the GSTIN — derived, never typed, so the
  /// two cannot drift apart. Decides CGST+SGST against IGST.
  stateCode     String?  @map("state_code") @db.VarChar(2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  insurancePolicies    InsurancePolicy[]
  tpaCommunicationLogs TpaCommunicationLog[]
  insuranceCases       InsuranceCase[]

  @@map("tpa_providers")
}

model InsurancePolicy {
  id               String                @id @default(uuid())
  tenantId         String                @map("tenant_id")
  patientId        String                @map("patient_id")
  insurerId        String                @map("insurer_id")
  tpaId            String?               @map("tpa_id")
  policyNumber     String                @map("policy_number") @db.VarChar(100)
  groupNumber      String?               @map("group_number") @db.VarChar(100)
  planName         String?               @map("plan_name") @db.VarChar(255)
  coverageAmount   Decimal?              @map("coverage_amount") @db.Decimal(12, 2)
  coPayPercent     Decimal               @default(0) @map("co_pay_percent") @db.Decimal(5, 2)
  deductibleAmount Decimal               @default(0) @map("deductible_amount") @db.Decimal(10, 2)
  exclusions       String?
  validFrom        DateTime              @map("valid_from") @db.Date
  validTo          DateTime              @map("valid_to") @db.Date
  status           InsurancePolicyStatus @default(active)
  createdAt        DateTime              @default(now()) @map("created_at")

  tenant                Tenant                    @relation(fields: [tenantId], references: [id])
  patient               Patient                   @relation(fields: [patientId], references: [id])
  insurer               Insurer                   @relation(fields: [insurerId], references: [id])
  tpa                   TpaProvider?              @relation(fields: [tpaId], references: [id])
  insuranceClaims       InsuranceClaim[]
  preAuthRequests       PreAuthorizationRequest[]
  insuranceCasePolicies InsuranceCasePolicy[]
  eligibilityChecks     PolicyEligibilityCheck[]

  @@map("insurance_policies")
}

model InsuranceClaim {
  id                            String                      @id @default(uuid())
  tenantId                      String                      @map("tenant_id")
  patientId                     String                      @map("patient_id")
  policyId                      String?                     @map("policy_id")
  insuranceCaseId               String?                     @map("insurance_case_id")
  preAuthId                     String?                     @map("pre_auth_id")
  billId                        String                      @map("bill_id")
  claimNumber                   String?                     @unique @map("claim_number") @db.VarChar(100)
  claimAmount                   Decimal                     @map("claim_amount") @db.Decimal(12, 2)
  approvedAmount                Decimal?                    @map("approved_amount") @db.Decimal(12, 2)
  patientShare                  Decimal?                    @map("patient_share") @db.Decimal(12, 2)
  copayAmount                   Decimal?                    @map("copay_amount") @db.Decimal(12, 2)
  deductibleAmount              Decimal?                    @map("deductible_amount") @db.Decimal(12, 2)
  coveredAmount                 Decimal?                    @map("covered_amount") @db.Decimal(12, 2)
  paidAmount                    Decimal                     @default(0) @map("paid_amount") @db.Decimal(12, 2)
  outstandingAmount             Decimal?                    @map("outstanding_amount") @db.Decimal(12, 2)
  status                        ClaimStatus                 @default(submitted)
  tier                          InsuranceClaimTier          @default(primary)
  sequence                      Int                         @default(1)
  settlementMode                InsuranceSettlementMode     @default(cashless) @map("settlement_mode")
  submissionChannel             InsuranceSubmissionChannel? @map("submission_channel")
  payerClaimReference           String?                     @map("payer_claim_reference") @db.VarChar(100)
  submissionReference           String?                     @map("submission_reference") @db.VarChar(100)
  nhcxTransactionId             String?                     @map("nhcx_transaction_id") @db.VarChar(100)
  finalAuthorizationRequestedAt DateTime?                   @map("final_authorization_requested_at")
  finalAuthorizationDueAt       DateTime?                   @map("final_authorization_due_at")
  finalAuthorizationReceivedAt  DateTime?                   @map("final_authorization_received_at")
  delayLiabilityAmount          Decimal                     @default(0) @map("delay_liability_amount") @db.Decimal(12, 2)
  tdsReceivableAmount           Decimal                     @default(0) @map("tds_receivable_amount") @db.Decimal(12, 2)
  disallowedAmount              Decimal                     @default(0) @map("disallowed_amount") @db.Decimal(12, 2)
  writtenOffAmount              Decimal                     @default(0) @map("written_off_amount") @db.Decimal(12, 2)
  submissionDate                DateTime                    @map("submission_date")
  approvalDate                  DateTime?                   @map("approval_date")
  settlementDate                DateTime?                   @map("settlement_date")
  expiryDate                    DateTime?                   @map("expiry_date")
  rejectionReason               String?                     @map("rejection_reason")
  documentsUrl                  Json?                       @map("documents_url")
  notes                         String?
  resubmissionCount             Int                         @default(0) @map("resubmission_count")
  previousClaimId               String?                     @map("previous_claim_id")
  submittedBy                   String?                     @map("submitted_by")
  reviewedBy                    String?                     @map("reviewed_by")
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant                   @relation(fields: [tenantId], references: [id])
  patient              Patient                  @relation(fields: [patientId], references: [id])
  policy               InsurancePolicy?         @relation(fields: [policyId], references: [id])
  insuranceCase        InsuranceCase?           @relation(fields: [insuranceCaseId], references: [id])
  preAuth              PreAuthorizationRequest? @relation(fields: [preAuthId], references: [id])
  bill                 Bill                     @relation(fields: [billId], references: [id])
  submitter            User?                    @relation("ClaimSubmitter", fields: [submittedBy], references: [id])
  reviewer             User?                    @relation("ClaimReviewer", fields: [reviewedBy], references: [id])
  previousClaim        InsuranceClaim?          @relation("ClaimResubmission", fields: [previousClaimId], references: [id])
  resubmittedClaims    InsuranceClaim[]         @relation("ClaimResubmission")
  tpaCommunicationLogs TpaCommunicationLog[]
  documents            ClaimDocument[]
  checklistItems       ClaimChecklistItem[]
  queries              ClaimQuery[]
  settlements          ClaimSettlement[]
  writeOffs            ClaimWriteOff[]
  adjustments          ClaimAdjustment[]
  auditEvents          InsuranceAuditEvent[]
  exchanges            InsuranceExchange[]

  @@unique([insuranceCaseId, sequence])
  @@index([tenantId, status, submissionDate])
  @@map("insurance_claims")
}

model PreAuthorizationRequest {
  id                    String                      @id @default(uuid())
  tenantId              String                      @map("tenant_id")
  patientId             String                      @map("patient_id")
  policyId              String?                     @map("policy_id")
  insuranceCaseId       String?                     @map("insurance_case_id")
  requestNumber         String                      @map("request_number") @db.VarChar(100)
  requestType           PreAuthRequestType          @default(initial) @map("request_type")
  parentRequestId       String?                     @map("parent_request_id")
  admissionId           String?                     @map("admission_id")
  visitId               String?                     @map("visit_id")
  doctorId              String?                     @map("doctor_id")
  diagnosisCode         String?                     @map("diagnosis_code") @db.VarChar(50)
  procedureCode         String?                     @map("procedure_code") @db.VarChar(50)
  procedureDescription  String                      @map("procedure_description")
  estimatedCost         Decimal?                    @map("estimated_cost") @db.Decimal(12, 2)
  approvedAmount        Decimal?                    @map("approved_amount") @db.Decimal(12, 2)
  status                PreAuthStatus               @default(pending)
  approvalNumber        String?                     @map("approval_number") @db.VarChar(100)
  payerPreAuthReference String?                     @map("payer_pre_auth_reference") @db.VarChar(100)
  submissionReference   String?                     @map("submission_reference") @db.VarChar(100)
  nhcxTransactionId     String?                     @map("nhcx_transaction_id") @db.VarChar(100)
  submissionChannel     InsuranceSubmissionChannel? @map("submission_channel")
  submittedAt           DateTime?                   @map("submitted_at")
  decisionDueAt         DateTime?                   @map("decision_due_at")
  alertAt               DateTime?                   @map("alert_at")
  decidedAt             DateTime?                   @map("decided_at")
  escalatedAt           DateTime?                   @map("escalated_at")
  validFrom             DateTime?                   @map("valid_from") @db.Date
  validTo               DateTime?                   @map("valid_to") @db.Date
  holdReason            String?                     @map("hold_reason")
  notes                 String?
  submittedBy           String?                     @map("submitted_by")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  patient              Patient                   @relation(fields: [patientId], references: [id])
  policy               InsurancePolicy?          @relation(fields: [policyId], references: [id])
  insuranceCase        InsuranceCase?            @relation(fields: [insuranceCaseId], references: [id])
  parentRequest        PreAuthorizationRequest?  @relation("PreAuthEnhancementChain", fields: [parentRequestId], references: [id])
  enhancementRequests  PreAuthorizationRequest[] @relation("PreAuthEnhancementChain")
  submitter            User?                     @relation(fields: [submittedBy], references: [id])
  tpaCommunicationLogs TpaCommunicationLog[]
  claims               InsuranceClaim[]
  auditEvents          InsuranceAuditEvent[]
  exchanges            InsuranceExchange[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId, status, decisionDueAt])
  @@map("pre_authorization_requests")
}

/// One recorded interaction with a TPA or insurer over a claim or a pre-authorization.
///
/// `tpaId` is optional because a claim reaches its TPA through the policy, and
/// a policy need not name one — a hospital that deals with the insurer direct
/// still has a conversation worth auditing. `isSystem` separates the entries
/// the lifecycle records automatically from the ones staff type after a call.
model TpaCommunicationLog {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  claimId           String?                 @map("claim_id")
  preAuthId         String?                 @map("pre_auth_id")
  tpaId             String?                 @map("tpa_id")
  communicationType CommunicationType?      @map("communication_type")
  subject           String?                 @db.VarChar(255)
  content           String?
  direction         CommunicationDirection?
  isSystem          Boolean                 @default(false) @map("is_system")
  communicatedBy    String?                 @map("communicated_by")
  createdAt         DateTime                @default(now()) @map("created_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  claim        InsuranceClaim?          @relation(fields: [claimId], references: [id])
  preAuth      PreAuthorizationRequest? @relation(fields: [preAuthId], references: [id])
  tpa          TpaProvider?             @relation(fields: [tpaId], references: [id])
  communicator User?                    @relation(fields: [communicatedBy], references: [id])

  @@index([tenantId, createdAt])
  @@index([claimId])
  @@index([preAuthId])
  @@map("tpa_communication_logs")
}

/// A credit customer whose own employee/beneficiary plan pays the hospital.
/// This is intentionally separate from a TPA: the payer and the claim
/// administrator are different commercial roles.
model CorporatePayer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  code          String?  @db.VarChar(50)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  address       String?
  gstin         String?  @db.VarChar(15)
  stateCode     String?  @map("state_code") @db.VarChar(2)
  creditDays    Int      @default(30) @map("credit_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  cases  InsuranceCase[]

  @@unique([tenantId, name])
  @@map("corporate_payers")
}

model GovernmentSchemePayer {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(255)
  schemeCode    String?  @map("scheme_code") @db.VarChar(100)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(255)
  portalUrl     String?  @map("portal_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  cases  InsuranceCase[]

  @@unique([tenantId, name])
  @@map("government_scheme_payers")
}

/// The longitudinal payer file for one care episode. Claims and pre-auths are
/// children of this record, allowing cashless, reimbursement and credit cases
/// to share one auditable workflow without pretending every payer is a TPA.
model InsuranceCase {
  id                       String                  @id @default(uuid())
  tenantId                 String                  @map("tenant_id")
  caseNumber               String                  @map("case_number") @db.VarChar(100)
  patientId                String                  @map("patient_id")
  admissionId              String?                 @map("admission_id")
  visitId                  String?                 @map("visit_id")
  caseType                 InsuranceCaseType       @map("case_type")
  settlementMode           InsuranceSettlementMode @map("settlement_mode")
  status                   InsuranceCaseStatus     @default(open)
  priority                 InsurancePriority       @default(routine)
  insurerId                String?                 @map("insurer_id")
  tpaId                    String?                 @map("tpa_id")
  corporatePayerId         String?                 @map("corporate_payer_id")
  governmentSchemePayerId  String?                 @map("government_scheme_payer_id")
  paymentResponsibleType   PayerType               @map("payment_responsible_type")
  paymentResponsibleId     String                  @map("payment_responsible_id")
  claimAdministratorType   PayerType?              @map("claim_administrator_type")
  claimAdministratorId     String?                 @map("claim_administrator_id")
  memberId                 String?                 @map("member_id") @db.VarChar(100)
  employeeId               String?                 @map("employee_id") @db.VarChar(100)
  abhaNumber               String?                 @map("abha_number") @db.VarChar(20)
  eligibilitySnapshot      Json?                   @map("eligibility_snapshot")
  emergencyIntimationDueAt DateTime?               @map("emergency_intimation_due_at")
  emergencyIntimatedAt     DateTime?               @map("emergency_intimated_at")
  deceasedProtocol         Boolean                 @default(false) @map("deceased_protocol")
  physicalReleaseAt        DateTime?               @map("physical_release_at")
  releaseUndertaking       String?                 @map("release_undertaking")
  notes                    String?
  createdBy                String?                 @map("created_by")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @default(now()) @updatedAt @map("updated_at")

  tenant                Tenant                    @relation(fields: [tenantId], references: [id])
  patient               Patient                   @relation(fields: [patientId], references: [id])
  admission             Admission?                @relation(fields: [admissionId], references: [id])
  visit                 Visit?                    @relation(fields: [visitId], references: [id])
  insurer               Insurer?                  @relation(fields: [insurerId], references: [id])
  tpa                   TpaProvider?              @relation(fields: [tpaId], references: [id])
  corporatePayer        CorporatePayer?           @relation(fields: [corporatePayerId], references: [id])
  governmentSchemePayer GovernmentSchemePayer?    @relation(fields: [governmentSchemePayerId], references: [id])
  creator               User?                     @relation("InsuranceCaseCreator", fields: [createdBy], references: [id])
  policies              InsuranceCasePolicy[]
  eligibilityChecks     PolicyEligibilityCheck[]
  preAuthRequests       PreAuthorizationRequest[]
  claims                InsuranceClaim[]
  auditEvents           InsuranceAuditEvent[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, patientId, status])
  @@index([admissionId])
  @@map("insurance_cases")
}

model InsuranceCasePolicy {
  id                      String   @id @default(uuid())
  insuranceCaseId         String   @map("insurance_case_id")
