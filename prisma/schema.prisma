model User {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  email                String    @db.VarChar(255)
  phone                String?   @db.VarChar(20)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  firstName            String    @map("first_name") @db.VarChar(100)
  lastName             String?   @map("last_name") @db.VarChar(100)
  avatarUrl            String?   @map("avatar_url")
  isActive             Boolean   @default(true) @map("is_active")
  is2faEnabled         Boolean   @default(false) @map("is_2fa_enabled")
  twoFaSecret          String?   @map("two_fa_secret") @db.VarChar(255)
  lastLoginAt          DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  deactivatedAt        DateTime? @map("deactivated_at")

  tenant                         Tenant                       @relation(fields: [tenantId], references: [id])
  patients                       Patient[]
  doctorProfile                  DoctorProfile?
  staffProfile                   StaffProfile?
  userRoles                      UserRole[]                   @relation("UserRoleUser")
  assignedUserRoles              UserRole[]                   @relation("UserRoleAssigner")
  loginAuditLogs                 LoginAuditLog[]
  departmentsHeaded              Department[]
  patientPersonalHistoryUpdates  PatientPersonalHistory[]     @relation("PersonalHistoryUpdater")
  patientDeathsRecorded          Patient[]                    @relation("PatientDeathRecorder")
  patientFamilyHistoryUpdates    PatientFamilyHistory[]       @relation("FamilyHistoryUpdater")
  patientAllergyNotes            PatientAllergy[]             @relation("AllergyNoter")
  patientCurrentMedAdds          PatientCurrentMedication[]   @relation("CurrentMedAdder")
  patientDocUploads              PatientDocument[]            @relation("DocUploader")
  patientDocVerifications        PatientDocument[]            @relation("DocVerifier")
  appointmentsBooked             Appointment[]                @relation("AppointmentBooker")
  appointmentsCancelled          Appointment[]                @relation("AppointmentCanceller")
  admissionsAdmitted             Admission[]                  @relation("Admitter")
  admissionsDischarged           Admission[]                  @relation("Discharger")
  transfersRequested             PatientTransfer[]            @relation("TransferRequester")
  transfersApproved              PatientTransfer[]            @relation("TransferApprover")
  vitalsRecorded                 Vital[]
  diagnosesRecorded              Diagnosis[]
  nursingNotes                   NursingNote[]
  progressNotesSigned            ProgressNote[]               @relation("ProgressNoteSigner")
  progressNoteAmendments         ProgressNoteAmendment[]      @relation("ProgressNoteAmendmentEditor")
  ivLinesInserted                IVLineRecord[]               @relation("IVInserter")
  ivLinesRemoved                 IVLineRecord[]               @relation("IVRemover")
  intakeOutputRecords            IntakeOutputRecord[]
  woundCareRecords               WoundCareRecord[]
  admissionAssessments           NursingAdmissionAssessment[]
  painAssessments                PainAssessment[]
  fallRiskAssessments            FallRiskAssessment[]
  clinicalObservations           ClinicalObservation[]
  clinicalDevicesInserted        ClinicalDevice[]             @relation("DeviceInserter")
  clinicalDevicesRemoved         ClinicalDevice[]             @relation("DeviceRemover")
  clinicalDeviceChecks           ClinicalDeviceCheck[]
  clinicalProcedures             ClinicalProcedure[]
  dischargeSummariesSigned       DischargeSummary[]
  medicationAdministrations      MedicationAdministration[]
  labOrdersOrdered               LabOrder[]
  labOrdersAssigned              LabOrder[]                   @relation("LabOrderAssignee")
  labOrdersAccepted              LabOrder[]                   @relation("LabOrderAcceptor")
  labOrderPaymentsVerified       LabOrder[]                   @relation("LabOrderPaymentVerifier")
  labOrdersExternallyCompleted   LabOrder[]                   @relation("LabOrderExternalCompleter")
  labSamplesCollected            LabSample[]
  labResultsEntered              LabResult[]
  labResultsVerified             LabResult[]                  @relation("LabResultVerifier")
  labReportsReviewed             LabReport[]                  @relation("LabReportReviewer")
  labReportsApproved             LabReport[]                  @relation("LabReportApprover")
  labReportsSigned               LabReport[]                  @relation("LabReportSigner")
  labAttachmentsUploaded         LabAttachment[]              @relation("LabAttachmentUploader")
  imagingOrdersOrdered           ImagingRequest[]
  imagingRequestsAssigned        ImagingRequest[]             @relation("ImagingTechnician")
  imagingRequestsExternallyDone  ImagingRequest[]             @relation("ImagingRequestExternalCompleter")
  imagingPaymentsVerified        ImagingRequest[]             @relation("ImagingPaymentVerifier")
  imagingRequestsAccepted        ImagingRequest[]             @relation("ImagingRequestAcceptor")
  imagingRequestsClosed          ImagingRequest[]             @relation("ImagingRequestCloser")
  imagingResultsRadiologist      ImagingResult[]              @relation("ImagingRadiologist")
  imagingResultsSigned           ImagingResult[]              @relation("ImagingResultSigner")
  imagingAttachmentsUploaded     ImagingAttachment[]          @relation("ImagingAttachmentUploader")
  dispensingRecords              DispensingRecord[]           @relation("Dispenser")
  dispensingVerifications        DispensingRecord[]           @relation("DispensingVerifier")
  dispensingWitnesses            DispensingRecord[]           @relation("DispensingWitness")
  drugReturnsProcessed           DrugReturn[]
  stockTransactions              StockTransaction[]
  purchaseOrdersApproved         PurchaseOrder[]
  supplyRequestsRequested        SupplyRequest[]              @relation("SupplyRequester")
  supplyRequestsApproved         SupplyRequest[]              @relation("SupplyApprover")
  stockTransfersRequested        StockTransfer[]              @relation("StockTransferRequester")
  stockTransfersApproved         StockTransfer[]              @relation("StockTransferApprover")
  stockTransfersDispatched       StockTransfer[]              @relation("StockTransferDispatcher")
  stockTransfersReceived         StockTransfer[]              @relation("StockTransferReceiver")
  stockTransfersCustodied        StockTransfer[]              @relation("StockTransferCustodian")
  billsGenerated                 Bill[]                       @relation("BillGenerator")
  creditNotesIssued              CreditNote[]
  billsApproved                  Bill[]                       @relation("BillApprover")
  billsCancelled                 Bill[]                       @relation("BillCanceller")
  paymentsProcessed              Payment[]
  refundsRequested               Refund[]                     @relation("RefundRequester")
  refundsApproved                Refund[]                     @relation("RefundApprover")
  discountsApproved              Discount[]
  insuranceClaimsSubmitted       InsuranceClaim[]             @relation("ClaimSubmitter")
  insuranceClaimsReviewed        InsuranceClaim[]             @relation("ClaimReviewer")
  preAuthSubmitted               PreAuthorizationRequest[]
  tpaCommunications              TpaCommunicationLog[]
  insuranceCasesCreated          InsuranceCase[]              @relation("InsuranceCaseCreator")
  claimDocumentsUploaded         ClaimDocument[]              @relation("ClaimDocumentUploader")
  claimDocumentsVerified         ClaimDocument[]              @relation("ClaimDocumentVerifier")
  claimQueriesRaised             ClaimQuery[]                 @relation("ClaimQueryRaiser")
  claimQueryResponses            ClaimQuery[]                 @relation("ClaimQueryResponder")
  claimSettlementsRecorded       ClaimSettlement[]            @relation("ClaimSettlementRecorder")
  claimWriteOffsRequested        ClaimWriteOff[]              @relation("ClaimWriteOffRequester")
  claimWriteOffsDecided          ClaimWriteOff[]              @relation("ClaimWriteOffDecider")
  claimAdjustmentsRecorded       ClaimAdjustment[]            @relation("ClaimAdjustmentRecorder")
  insuranceAuditEvents           InsuranceAuditEvent[]
  bloodDonationsCollected        BloodDonation[]
  crossMatchTests                CrossMatchTest[]
  transfusionsAdministered       Transfusion[]                @relation("TransfusionAdministerer")
  transfusionsOrdered            Transfusion[]                @relation("TransfusionOrderer")
  leaveRequestsApproved          LeaveRequest[]
  doctorLeavesApproved           DoctorLeave[]                @relation("DoctorLeaveApprover")
  payrollProcessed               Payroll[]
  notifications                  Notification[]
  cdssAlertsAcknowledged         CdssAlert[]                  @relation("CdssAlertAcknowledger")
  messagesSent                   Message[]                    @relation("MessageSender")
  messagesReceived               Message[]                    @relation("MessageReceiver")
  shiftHandoverFrom              ShiftHandoverNote[]          @relation("HandoverFrom")
  shiftHandoverTo                ShiftHandoverNote[]          @relation("HandoverTo")
  nurseAssignmentsAsNurse        NurseAssignment[]            @relation("NurseAssignmentNurse")
  nurseAssignmentsAssigned       NurseAssignment[]            @relation("NurseAssignmentAssigner")
  nurseAssignmentsHandoverTo     NurseAssignment[]            @relation("NurseAssignmentHandoverTo")
  nurseDoctorAssignmentsAsNurse  NurseDoctorAssignment[]      @relation("NurseDoctorAssignmentNurse")
  nurseDoctorAssignmentsAssigned NurseDoctorAssignment[]      @relation("NurseDoctorAssignmentAssigner")
  dutyRostersApproved            DutyRoster[]                 @relation("DutyRosterApprover")
  dutyRostersCreated             DutyRoster[]                 @relation("DutyRosterCreator")
  vitalCorrectionsMade           Vital[]                      @relation("VitalCorrector")
  ticketsRaised                  Ticket[]                     @relation("TicketRaiser")
  ticketsAssigned                Ticket[]                     @relation("TicketAssignee")
  ticketsEscalated               Ticket[]                     @relation("TicketEscalator")
  feedbackSubmitted              Feedback[]
  auditLogs                      AuditLog[]
  discountsRequested             Discount[]                   @relation("DiscountRequester")
  drawersClosed                  CashDrawerClosure[]          @relation("DrawerCashier")
  drawerClosuresRecorded         CashDrawerClosure[]          @relation("DrawerCloser")
  complianceDocUploads           ComplianceDocument[]
  incidentReportsReported        IncidentReport[]             @relation("IncidentReporter")
  incidentReportsEscalated       IncidentReport[]             @relation("IncidentEscalator")
  savedReports                   SavedReport[]
  scheduledReports               ScheduledReport[]
  supportTickets                 SupportTicket[]
  tenantOwners                   TenantOwner[]
  subscriptionPayments           SubscriptionPayment[]
  connectionRequests             PatientHospitalConnection[]  @relation("ConnectionUser")
  connectionReviews              PatientHospitalConnection[]  @relation("ConnectionReviewer")
  mrdRequestsMade                MrdRequest[]                 @relation("MrdRequestedBy")
  commissionSettingsUpdated      CommissionSetting[]          @relation("CommissionSettingUpdater")
  hospitalCommissionsUpdated     HospitalCommission[]         @relation("HospitalCommissionUpdater")
  demoRequestsApproved           DemoRequest[]                @relation("DemoApprover")
  demoRequestsCreatedUser        DemoRequest[]                @relation("DemoCreatedUser")
  ownedSubscriptions             UserSubscription[]           @relation("SubscriptionOwner")
  reservationsCreated            Reservation[]                @relation("ReservationCreator")
  estimationsCreated             Estimation[]                 @relation("EstimationCreator")
  admissionRequestsRequested     AdmissionRequest[]           @relation("AdmissionRequestRequester")
  admissionRequestsProcessed     AdmissionRequest[]           @relation("AdmissionRequestProcessor")
  emarSchedulesGiven             EmarSchedule[]               @relation("EmarGivenBy")
  emarSchedulesAmended           EmarSchedule[]               @relation("EmarAmendedBy")
  emarAuditLogs                  EmarAuditLog[]
  formTemplatesCreated           FormTemplate[]               @relation("FormTemplateCreator")
  hospitalFormsCreated           HospitalForm[]               @relation("HospitalFormCreator")
  hospitalFormsArchived          HospitalForm[]               @relation("HospitalFormArchiver")
  formSubmissions                HospitalFormSubmission[]     @relation("FormSubmitter")
  labTestTemplatesCreated        LabTestTemplate[]            @relation("LabTestTemplateCreator")
  gstRateChanges                 GstRateChange[]
  gstPeriodsFiled                GstFiledPeriod[]             @relation("GstPeriodFiler")
  gstPeriodsLocked               GstFiledPeriod[]             @relation("GstPeriodLocker")
  gstr2bImports                  Gstr2bImport[]

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String   @db.VarChar(50)
  description  String?
  isSystemRole Boolean  @default(false) @map("is_system_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model TenantOwner {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@map("tenant_owners")
}

model Permission {
  id          String  @id @default(uuid())
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user     User  @relation("UserRoleUser", fields: [userId], references: [id])
  role     Role  @relation(fields: [roleId], references: [id])
  assigner User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model LoginAuditLog {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  tenantId      String      @map("tenant_id")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent")
  status        LoginStatus
  failureReason String?     @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("login_audit_logs")
}

model DemoRequest {
  id              String            @id @default(uuid())
  name            String            @db.VarChar(120)
  email           String            @db.VarChar(255)
  phone           String            @db.VarChar(20)
  hospitalName    String            @map("hospital_name") @db.VarChar(255)
  designation     String            @db.VarChar(100)
  city            String            @db.VarChar(100)
  message         String?           @db.Text
  status          DemoRequestStatus @default(pending)
  trialDays       Int?              @map("trial_days")
  trialEndsAt     DateTime?         @map("trial_ends_at")
  trialPlanId     String?           @map("trial_plan_id")
  approvedById    String?           @map("approved_by_id")
  createdTenantId String?           @map("created_tenant_id")
  createdUserId   String?           @map("created_user_id")
  rejectionNote   String?           @map("rejection_note") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  approvedBy    User?             @relation("DemoApprover", fields: [approvedById], references: [id])
  trialPlan     SubscriptionPlan? @relation(fields: [trialPlanId], references: [id])
  createdTenant Tenant?           @relation(fields: [createdTenantId], references: [id])
  createdUser   User?             @relation("DemoCreatedUser", fields: [createdUserId], references: [id])

  @@map("demo_requests")
}

enum DemoRequestStatus {
  pending
  approved
  rejected
  trial_active
  trial_ended
  converted
}

// ============================================================
// 3. INFRASTRUCTURE
// ============================================================

model Department {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(100)
  code        String?  @db.VarChar(20)
  description String?
  headUserId  String?  @map("head_user_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  headUser           User?              @relation(fields: [headUserId], references: [id])
  wards              Ward[]
  hospitalResources  HospitalResource[]
  stockTransactions  StockTransaction[]
  supplyRequests     SupplyRequest[]
  dutyRosters        DutyRoster[]
  staffProfiles      StaffProfile[]
  tickets            Ticket[]
  feedback           Feedback[]
  doctorProfiles     DoctorProfile[]
  stockTransfersFrom StockTransfer[]    @relation("StockTransferFromDept")
  stockTransfersTo   StockTransfer[]    @relation("StockTransferToDept")

  @@map("departments")
}

model Floor {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String   @db.VarChar(60)
  level       Int      @default(0)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  wards  Ward[]

  @@unique([tenantId, name])
  @@unique([tenantId, level])
  @@map("floors")
}

model Ward {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  departmentId String?   @map("department_id")
  floorId      String?   @map("floor_id")
  name         String    @db.VarChar(100)
  wardType     WardType? @map("ward_type")
  totalBeds    Int       @default(0) @map("total_beds")
  // Per-day bed charge for this ward, set by the hospital admin. Feeds IP room
  // billing (falls back to the room ServiceTariff when unset).
  dailyCharge  Decimal?  @map("daily_charge") @db.Decimal(10, 2)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  department           Department?         @relation(fields: [departmentId], references: [id])
  floor                Floor?              @relation(fields: [floorId], references: [id])
  beds                 Bed[]
  stockTransfersIn     StockTransfer[]     @relation("StockTransferToWard")
  admissions           Admission[]
  patientTransfersFrom PatientTransfer[]   @relation("TransferFromWard")
  patientTransfersTo   PatientTransfer[]   @relation("TransferToWard")
  supplyRequests       SupplyRequest[]
  shiftHandoverNotes   ShiftHandoverNote[]
  nurseAssignments     NurseAssignment[]
  dutyRosters          DutyRoster[]
  reservations         Reservation[]

  @@map("wards")
}

model Bed {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  wardId           String    @map("ward_id")
  bedNumber        String    @map("bed_number") @db.VarChar(20)
  bedType          BedType?  @map("bed_type")
  status           BedStatus @default(available)
  currentPatientId String?   @map("current_patient_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  ward                 Ward              @relation(fields: [wardId], references: [id])
  currentPatient       Patient?          @relation(fields: [currentPatientId], references: [id])
  admissions           Admission[]
  patientTransfersFrom PatientTransfer[] @relation("TransferFromBed")
  patientTransfersTo   PatientTransfer[] @relation("TransferToBed")
  nurseAssignments     NurseAssignment[]
  reservations         Reservation[]

  @@map("beds")
}

model OperatingTheater {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String   @db.VarChar(100)
  location      String?  @db.VarChar(255)
  status        OtStatus @default(available)
  equipmentList Json?    @map("equipment_list")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  otRequests OtRequest[]

  @@map("operating_theaters")
}

/// Per-tenant OT scheduling preferences (one row per hospital).
model OtSchedulingSetting {
  id                     String   @id @default(uuid())
  tenantId               String   @unique @map("tenant_id")
  defaultDurationMinutes Int      @default(60) @map("default_duration_minutes")
  bufferMinutes          Int      @default(30) @map("buffer_minutes")
  maxSurgeriesPerDay     Int      @default(10) @map("max_surgeries_per_day")
  /// "HH:mm" — operating-day window used by the scheduler UI
  dayStartTime           String?  @map("day_start_time") @db.VarChar(5)
  dayEndTime             String?  @map("day_end_time") @db.VarChar(5)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("ot_scheduling_settings")
}

model HospitalResource {
  id                  String         @id @default(uuid())
  tenantId            String         @map("tenant_id")
  name                String         @db.VarChar(100)
  resourceType        ResourceType?  @map("resource_type")
  serialNumber        String?        @map("serial_number") @db.VarChar(100)
  departmentId        String?        @map("department_id")
  status              ResourceStatus @default(available)
  location            String?        @db.VarChar(255)
  lastMaintenanceDate DateTime?      @map("last_maintenance_date") @db.Date
  nextMaintenanceDate DateTime?      @map("next_maintenance_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("hospital_resources")
}

// ============================================================
// 4. PATIENT MANAGEMENT
// ============================================================

model Patient {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  userId             String?             @map("user_id")
  relationship       PatientRelationship @default(self)
  isSelf             Boolean             @default(false) @map("is_self")
  mrn                String              @db.VarChar(50)
  firstName          String              @map("first_name") @db.VarChar(100)
  lastName           String?             @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  gender             Gender?
  bloodGroup         String?             @map("blood_group") @db.VarChar(5)
  phone              String?             @db.VarChar(20)
  email              String?             @db.VarChar(255)
  addressLine1       String?             @map("address_line1") @db.VarChar(255)
  addressLine2       String?             @map("address_line2") @db.VarChar(255)
  city               String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  postalCode         String?             @map("postal_code") @db.VarChar(20)
  country            String?             @db.VarChar(100)
  photoUrl           String?             @map("photo_url")
  idProofType        String?             @map("id_proof_type") @db.VarChar(50)
  idProofNumber      String?             @map("id_proof_number") @db.VarChar(100)
  idProofDocumentUrl String?             @map("id_proof_document_url")
  maritalStatus      String?             @map("marital_status") @db.VarChar(20)
  nationality        String?             @db.VarChar(100)
  occupation         String?             @db.VarChar(100)
  religion           String?             @db.VarChar(50)
  preferredLanguage  String?             @map("preferred_language") @db.VarChar(50)
  referredBy         String?             @map("referred_by") @db.VarChar(200)
  notes              String?
  abhaNumber         String?             @unique @map("abha_number") @db.VarChar(20)
  abhaAddress        String?             @map("abha_address") @db.VarChar(100)
  abhaLinked         Boolean             @default(false) @map("abha_linked")
  abhaLinkedAt       DateTime?           @map("abha_linked_at")
  kycVerified        Boolean             @default(false) @map("kyc_verified")
  kycVerifiedAt      DateTime?           @map("kyc_verified_at")
  patientType        PatientType?        @map("patient_type")
  isNew              Boolean             @default(true) @map("is_new")
  registrationSource RegistrationSource? @map("registration_source")
  // Death is recorded on the PATIENT, not on an admission.
  //
  // A death can happen before there is any admission to close — someone
  // brought in already dead, or dying in casualty before the paperwork catches
  // up. That is the case Test Report 3 asks about, and an admission status
  // cannot express it because there is no admission.
  //
  // isActive is a soft-delete flag and is deliberately NOT reused: a deceased
  // patient's record stays fully readable and billable, it just must not be
  // treated as a living patient.
  deceasedAt         DateTime?           @map("deceased_at")
  deceasedRecordedBy String?             @map("deceased_recorded_by")
  deceasedNote       String?             @map("deceased_note")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  tenant                    Tenant                       @relation(fields: [tenantId], references: [id])
  deceasedRecorder          User?                        @relation("PatientDeathRecorder", fields: [deceasedRecordedBy], references: [id])
  user                      User?                        @relation(fields: [userId], references: [id])
  beds                      Bed[]
  emergencyContacts         PatientEmergencyContact[]
  personalHistory           PatientPersonalHistory?
  familyHistory             PatientFamilyHistory[]
  allergies                 PatientAllergy[]
  currentMedications        PatientCurrentMedication[]
  documents                 PatientDocument[]
  consents                  PatientConsent[]
  privacySettings           PatientPrivacySetting?
  abhaSyncLogs              AbhaSyncLog[]
  appointments              Appointment[]
  queueTokens               QueueToken[]
  visits                    Visit[]
  admissions                Admission[]
  patientTransfers          PatientTransfer[]
  vitals                    Vital[]
  diagnoses                 Diagnosis[]
  progressNotes             ProgressNote[]
  nursingNotes              NursingNote[]
  ivLineRecords             IVLineRecord[]
  intakeOutputRecords       IntakeOutputRecord[]
  woundCareRecords          WoundCareRecord[]
  admissionAssessments      NursingAdmissionAssessment[]
  painAssessments           PainAssessment[]
  fallRiskAssessments       FallRiskAssessment[]
  clinicalObservations      ClinicalObservation[]
  clinicalDevices           ClinicalDevice[]
  clinicalDeviceChecks      ClinicalDeviceCheck[]
