/// Protocol-neutral exchange/outbox record. NHCX uses FHIR R4 payloads, while
/// a payer-specific portal/API connector can use the same retryable envelope.
model InsuranceExchange {
  id              String                     @id @default(uuid())
  tenantId        String                     @map("tenant_id")
